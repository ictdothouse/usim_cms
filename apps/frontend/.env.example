# apps/api base URL this frontend fetches pages/theme from (server-side only, never sent to the browser)
API_URL=http://localhost:3000

# Dev-only: which tenant plain `localhost` should render as (real department domains
# never hit this — see [...slug].astro). Unused in `astro build`/`preview`.
DEV_TENANT_HOST=dept-a.usim.edu.my

# Optional rendered-HTML edge cache (src/lib/html-cache.ts) — unset means every
# request renders fresh, same as before this existed. Same redis instance
# apps/api uses (see its own .env.example); apps/api invalidates this cache's
# keys on publish/theme/menu writes via the `ucms:htmlcache:<host>:` prefix.
# REDIS_URL=redis://localhost:6379
