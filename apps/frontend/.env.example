# apps/api base URL this frontend fetches pages/theme from (server-side only, never sent to the browser)
API_URL=http://localhost:3000

# Dev-only: which tenant plain `localhost` should render as (real department domains
# never hit this — see [...slug].astro). Unused in `astro build`/`preview`.
DEV_TENANT_HOST=dept-a.usim.edu.my
