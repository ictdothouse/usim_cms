---
import "../styles/global.css";

interface Props {
  title: string;
  ogImage?: string | null;
  theme: Record<string, unknown>;
  // Extra per-element Google Fonts used on this page (see
  // apps/frontend/src/lib/collectFonts.ts) — merged with the theme's own
  // font into one combined request below.
  fonts?: string[];
  // Designer.tsx "live view" bridge — see SectionBlock.astro's designerEdit
  // prop for the data-designer-path attributes this script reacts to. Only
  // ever true alongside a valid preview token (gated in [...slug].astro),
  // so this script never ships to a real visitor.
  designerEdit?: boolean;
}
const { title, ogImage, theme, fonts = [], designerEdit = false } = Astro.props;
// site_theme.settings is an open JSONB bag (superadmin/webmaster-defined);
// apps/api validates these 6 keys on write (index.ts validateThemeSettings),
// so this layout only has to wire them, not re-validate them.
const themeVars = [
  theme.primaryColor ? `--color-primary:${theme.primaryColor}` : null,
  theme.secondaryColor ? `--color-secondary:${theme.secondaryColor}` : null,
  theme.backgroundColor ? `--color-bg:${theme.backgroundColor}` : null,
  theme.textColor ? `--color-text:${theme.textColor}` : null,
  theme.fontFamily ? `--font-family:${theme.fontFamily}` : null,
]
  .filter(Boolean)
  .join(";");
const fontFamily = typeof theme.fontFamily === "string" ? theme.fontFamily : "";
const logoUrl = typeof theme.logoUrl === "string" ? theme.logoUrl : "";
const allFonts = [...new Set([fontFamily, ...fonts].filter(Boolean))];
const fontsHref = allFonts.length
  ? `https://fonts.googleapis.com/css2?${allFonts.map((f) => `family=${encodeURIComponent(f)}`).join("&")}&display=swap`
  : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {fontsHref && <link rel="stylesheet" href={fontsHref} />}
    <style set:html={themeVars ? `:root{${themeVars}}` : ""} />
  </head>
  <body
    style={`font-family:var(--font-family, system-ui, sans-serif);background:var(--color-bg, inherit);color:var(--color-text, inherit)`}
  >
    {logoUrl && <img src={logoUrl} alt="" height="40" />}
    <slot />
    {designerEdit && (
      <script is:inline>
        (() => {
          const targetOrigin = document.referrer ? new URL(document.referrer).origin : null;
          if (!targetOrigin) return;

          document.addEventListener("click", (e) => {
            if (justDragged) {
              e.preventDefault();
              return;
            }
            const node = e.target.closest("[data-designer-path]");
            if (!node) return;
            e.preventDefault();
            parent.postMessage({ type: "designer:select", path: node.dataset.designerPath }, targetOrigin);
          });

          // Drag-reorder: custom pointer tracking rather than native HTML5
          // drag/drop, which doesn't hand off cleanly across an iframe
          // origin boundary. Only element-level nodes (4-part path, e.g.
          // "0.0.0.0") are draggable — section/column wrappers aren't.
          let dragState = null;
          let justDragged = false;

          document.addEventListener("pointerdown", (e) => {
            const node = e.target.closest("[data-designer-path]");
            if (!node || node.isContentEditable) return;
            if (node.dataset.designerPath.split(".").length !== 4) return;
            dragState = { path: node.dataset.designerPath, node, startX: e.clientX, startY: e.clientY, moved: false };
          });

          document.addEventListener("pointermove", (e) => {
            if (!dragState) return;
            if (!dragState.moved) {
              if (Math.hypot(e.clientX - dragState.startX, e.clientY - dragState.startY) < 6) return;
              dragState.moved = true;
              dragState.node.style.opacity = "0.4";
            }
            const under = document.elementFromPoint(e.clientX, e.clientY);
            const targetNode = under && under.closest("[data-designer-path]");
            if (dragState.hoverNode && dragState.hoverNode !== targetNode) {
              dragState.hoverNode.style.outline = "";
            }
            if (
              targetNode &&
              targetNode !== dragState.node &&
              targetNode.dataset.designerPath.split(".").length === 4
            ) {
              const rect = targetNode.getBoundingClientRect();
              dragState.hoverPosition = e.clientY < rect.top + rect.height / 2 ? "before" : "after";
              targetNode.style.outline = "2px solid #0f62fe";
              dragState.hoverNode = targetNode;
              dragState.hoverPath = targetNode.dataset.designerPath;
            } else {
              dragState.hoverNode = null;
              dragState.hoverPath = null;
            }
          });

          document.addEventListener("pointerup", () => {
            if (!dragState) return;
            dragState.node.style.opacity = "";
            if (dragState.hoverNode) dragState.hoverNode.style.outline = "";
            if (dragState.moved && dragState.hoverPath) {
              justDragged = true;
              parent.postMessage(
                { type: "designer:reorder", from: dragState.path, to: dragState.hoverPath, position: dragState.hoverPosition },
                targetOrigin,
              );
              setTimeout(() => (justDragged = false), 50);
            }
            dragState = null;
          });

          function findByPath(path) {
            return document.querySelector(`[data-designer-path="${path}"]`);
          }

          window.addEventListener("message", (e) => {
            if (e.origin !== targetOrigin || !e.data) return;
            const node = findByPath(e.data.path);
            if (!node) return;
            if (e.data.type === "designer:style") {
              Object.assign(node.style, e.data.style);
            } else if (e.data.type === "designer:text") {
              node.contentEditable = String(Boolean(e.data.editable));
              if (e.data.editable && !node.dataset.designerBound) {
                node.dataset.designerBound = "1";
                node.addEventListener("input", () => {
                  parent.postMessage(
                    { type: "designer:textInput", path: node.dataset.designerPath, value: node.textContent },
                    targetOrigin,
                  );
                });
              }
            }
          });
        })();
      </script>
    )}
  </body>
</html>
