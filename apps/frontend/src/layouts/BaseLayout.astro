                // freedom as ElPreview's startFreeElDrag); .ds-slider-viewport's
                // overflow:hidden is the real guard against painting into the
                // next slide.
                x = r1(((sx - halfW) / rect.width) * 100);
                y = r1(((sy - halfH) / rect.height) * 100);
