---
import "../styles/global.css";

interface Props {
  title: string;
  ogImage?: string | null;
  theme: Record<string, unknown>;
  // Extra per-element Google Fonts used on this page (see
  // apps/frontend/src/lib/collectFonts.ts) — merged with the theme's own
  // font into one combined request below.
  fonts?: string[];
  // Designer.tsx "live view" bridge — see SectionBlock.astro's designerEdit
  // prop for the data-designer-path attributes this script reacts to. Only
  // ever true alongside a valid preview token (gated in [...slug].astro),
  // so this script never ships to a real visitor.
  designerEdit?: boolean;
  // i18n Phase 3 — set only by posts/[slug].astro, only when the tenant has
  // turned the switcher on AND the current post actually has published
  // translation siblings to switch to (a page with nothing to switch to
  // gets no switcher, regardless of the site setting — see this repo's
  // "let the editor tell the truth" convention elsewhere in Designer.tsx).
  langSwitcher?: { current: string | null; options: Array<{ code: string; label: string; href: string }> } | null;
}
const { title, ogImage, theme, fonts = [], designerEdit = false, langSwitcher = null } = Astro.props;

// Same WCAG relative-luminance math as apps/admin's lib/utils.ts
// (contrastRatio/bestTextColor) — duplicated, not imported, since this is a
// separate app with its own build; picks black or white for
// --color-primary-content instead of SectionBlock.astro assuming white
// always, so a light primary color (several curated presets included)
// renders a readable button label instead of invisible white-on-white.
function bestTextColor(hex: string): string {
  const luminance = (c: string) => {
    const [r, g, b] = [0, 2, 4].map((i) => parseInt(c.slice(i, i + 2), 16) / 255);
    const lin = (v: number) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4);
    return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b);
  };
  const clean = hex.replace("#", "");
  const l = luminance(clean);
  const contrast = (other: number) => (Math.max(l, other) + 0.05) / (Math.min(l, other) + 0.05);
  return contrast(1) >= contrast(0) ? "#ffffff" : "#000000";
}

// site_theme.settings is an open JSONB bag (superadmin/webmaster-defined);
// apps/api validates these keys on write (index.ts validateThemeSettings),
// so this layout only has to wire them, not re-validate them. fontFamily is
// the body font; headingFont/postTitleFont fall back to it (global.css and
// posts/[slug].astro read --font-heading/--font-post-title) so a site with
// only a body font set still looks consistent everywhere.
const themeVars = [
  theme.primaryColor ? `--color-primary:${theme.primaryColor}` : null,
  typeof theme.primaryColor === "string" ? `--color-primary-content:${bestTextColor(theme.primaryColor)}` : null,
  theme.secondaryColor ? `--color-secondary:${theme.secondaryColor}` : null,
  theme.backgroundColor ? `--color-bg:${theme.backgroundColor}` : null,
  theme.textColor ? `--color-text:${theme.textColor}` : null,
  theme.fontFamily ? `--font-family:${theme.fontFamily}` : null,
  theme.headingFont ? `--font-heading:${theme.headingFont}` : null,
  theme.subHeadingFont ? `--font-subheading:${theme.subHeadingFont}` : null,
  theme.postTitleFont ? `--font-post-title:${theme.postTitleFont}` : null,
  theme.postTitleFontSize ? `--font-post-title-size:${theme.postTitleFontSize}px` : null,
]
  .filter(Boolean)
  .join(";");
const fontFamily = typeof theme.fontFamily === "string" ? theme.fontFamily : "";
const headingFont = typeof theme.headingFont === "string" ? theme.headingFont : "";
const subHeadingFont = typeof theme.subHeadingFont === "string" ? theme.subHeadingFont : "";
const postTitleFont = typeof theme.postTitleFont === "string" ? theme.postTitleFont : "";
const logoUrl = typeof theme.logoUrl === "string" ? theme.logoUrl : "";
const allFonts = [...new Set([fontFamily, headingFont, subHeadingFont, postTitleFont, ...fonts].filter(Boolean))];
const fontsHref = allFonts.length
  ? `https://fonts.googleapis.com/css2?${allFonts.map((f) => `family=${encodeURIComponent(f)}`).join("&")}&display=swap`
  : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {fontsHref && <link rel="stylesheet" href={fontsHref} />}
    <style set:html={themeVars ? `:root{${themeVars}}` : ""} />
  </head>
  <body
    style={`font-family:var(--font-family, system-ui, sans-serif);background:var(--color-bg, inherit);color:var(--color-text, inherit)`}
  >
    {logoUrl && !langSwitcher && <img src={logoUrl} alt="" height="40" />}
    {langSwitcher && langSwitcher.options.length > 1 && (
      <div style="display:flex;align-items:center;justify-content:space-between;padding:0.75rem 1rem;">
        {logoUrl ? <img src={logoUrl} alt="" height="40" /> : <span />}
        <nav style="display:flex;gap:0.4rem;">
          {langSwitcher.options.map((o) => (
            <a
              href={o.href}
              style={`font-size:0.75rem;text-decoration:none;padding:0.2rem 0.6rem;border-radius:999px;${
                o.code === langSwitcher.current
                  ? "background:var(--color-primary,#0f62fe);color:var(--color-primary-content,#fff);"
                  : "color:#555;background:#f2f2f2;"
              }`}
            >
              {o.label}
            </a>
          ))}
        </nav>
      </div>
    )}
    <main id="main-content">
      <main id="main-content">
      <slot />
    </main>
    </main>
    {designerEdit && (
      <script is:inline>
        (() => {
          const targetOrigin = document.referrer ? new URL(document.referrer).origin : null;
          if (!targetOrigin) return;

          document.addEventListener("click", (e) => {
            // Lets Designer.tsx close its right-click context menu on any
            // click inside the iframe — a click here never bubbles to the
            // parent document's own click listener (cross-document), which
            // is the same reason the keydown bridge below exists.
            parent.postMessage({ type: "designer:iframeClick" }, targetOrigin);
            if (justDragged) {
              e.preventDefault();
              return;
            }
            const node = e.target.closest("[data-designer-path]");
            if (!node) return;
            e.preventDefault();
            parent.postMessage({ type: "designer:select", path: node.dataset.designerPath }, targetOrigin);
          });

          // Right-click to edit: mirrors Blocks mode's own context menu,
          // which is element-level only (4-part path) — see Designer.tsx's
          // ctxMenu render block.
          document.addEventListener("contextmenu", (e) => {
            const node = e.target.closest("[data-designer-path]");
            if (!node || node.dataset.designerPath.split(".").length !== 4) return;
            e.preventDefault();
            parent.postMessage(
              { type: "designer:contextmenu", path: node.dataset.designerPath, x: e.clientX, y: e.clientY },
              targetOrigin,
            );
          });

          // Undo/redo: Ctrl+Z/Ctrl+Shift+Z/Ctrl+Y typed while focus is inside
          // this iframe never reaches Designer.tsx's own keydown listener
          // (attached to the parent document's window, which a keypress
          // inside a different document never bubbles to) — forward it
          // instead. Skipped while actively editing text so the browser's
          // own contentEditable undo (which already works, for free) keeps
          // handling that case rather than being shadowed by a block-level
          // undo that wouldn't visually update the typed text anyway.
          document.addEventListener("keydown", (e) => {
            if (!(e.ctrlKey || e.metaKey)) return;
            if (document.activeElement && document.activeElement.isContentEditable) return;
            const key = e.key.toLowerCase();
            if (key === "z" && e.shiftKey) {
              e.preventDefault();
              parent.postMessage({ type: "designer:redo" }, targetOrigin);
            } else if (key === "z") {
              e.preventDefault();
              parent.postMessage({ type: "designer:undo" }, targetOrigin);
            } else if (key === "y") {
              e.preventDefault();
              parent.postMessage({ type: "designer:redo" }, targetOrigin);
            }
          });

          // Drag-reorder: custom pointer tracking rather than native HTML5
          // drag/drop. Native draggable was tried and reverted — with
          // nested draggable ancestors (element inside column inside
          // section) browsers don't reliably resolve which one is actually
          // being dragged, and can render a whole ancestor's content as the
          // drag ghost instead of just the intended node. Pointer tracking
          // avoids that entirely (opacity/outline are plain style changes,
          // no native ghost image). Any tagged node is draggable — section
          // (1-part path, e.g. "0"), column (3-part, "0.0.0"), or element
          // (4-part, "0.0.0.0") — closest() from the pointerdown target
          // already picks the innermost tagged ancestor, so grabbing real
          // content still starts an element/column drag; only a section's
          // own empty area (padding, gaps between rows) resolves to a
          // section-level drag. Designer.tsx's designer:reorder handler
          // dispatches on path depth, matching the Layers tree's
          // drag-reorder (same depths, same same-row column restriction
          // below).
          let dragState = null;
          let justDragged = false;

          document.addEventListener("pointerdown", (e) => {
            const node = e.target.closest("[data-designer-path]");
            if (!node || node.isContentEditable) return;
            dragState = { path: node.dataset.designerPath, node, startX: e.clientX, startY: e.clientY, moved: false };
          });

          document.addEventListener("pointermove", (e) => {
            if (!dragState) return;
            if (!dragState.moved) {
              if (Math.hypot(e.clientX - dragState.startX, e.clientY - dragState.startY) < 6) return;
              dragState.moved = true;
              dragState.node.style.opacity = "0.4";
            }
            const depth = dragState.path.split(".").length;
            const under = document.elementFromPoint(e.clientX, e.clientY);
            const targetNode = under && under.closest("[data-designer-path]");
            if (dragState.hoverNode && dragState.hoverNode !== targetNode) {
              dragState.hoverNode.style.outline = "";
            }
            const targetPath = targetNode && targetNode.dataset.designerPath;
            // Column reorder is scoped to within its own row (depth 3) — a
            // row's grid-template-columns/each column's span are only
            // meaningful there, same restriction the Layers tree applies.
            const sameRow =
              depth !== 3 ||
              (targetPath &&
                targetPath.split(".").slice(0, 2).join(".") === dragState.path.split(".").slice(0, 2).join("."));
            if (targetNode && targetNode !== dragState.node && targetPath.split(".").length === depth && sameRow) {
              const rect = targetNode.getBoundingClientRect();
              dragState.hoverPosition = e.clientY < rect.top + rect.height / 2 ? "before" : "after";
              targetNode.style.outline = "2px solid #0f62fe";
              dragState.hoverNode = targetNode;
              dragState.hoverPath = targetPath;
            } else {
              dragState.hoverNode = null;
              dragState.hoverPath = null;
            }
          });

          document.addEventListener("pointerup", () => {
            if (!dragState) return;
            dragState.node.style.opacity = "";
            if (dragState.hoverNode) dragState.hoverNode.style.outline = "";
            if (dragState.moved && dragState.hoverPath) {
              justDragged = true;
              parent.postMessage(
                { type: "designer:reorder", from: dragState.path, to: dragState.hoverPath, position: dragState.hoverPosition },
                targetOrigin,
              );
              setTimeout(() => (justDragged = false), 50);
            }
            dragState = null;
          });

          function findByPath(path) {
            return document.querySelector(`[data-designer-path="${path}"]`);
          }

          // Every element-level wrapper (SectionBlock.astro's
          // `<div data-designer-path=... style="display:contents">`) has no
          // box of its own — display:contents renders only its children, so
          // non-inherited properties like outline/border set on the wrapper
          // itself are invisible, and contentEditable's focus/caret handling
          // doesn't reliably attach to it either. typoStyle's own properties
          // (color, font-family, ...) still reach the child fine since those
          // are inherited CSS, but outline and contentEditable need the
          // actual rendered child instead.
          function visualTarget(node) {
            if (!node) return null;
            return getComputedStyle(node).display === "contents" ? node.firstElementChild || node : node;
          }

          // Puck-style hover/selected feedback: a light dashed outline under
          // the pointer, a solid one on whatever `sel` currently is in
          // Designer.tsx (see its designer:selected postMessage below) —
          // kept separate from the drag-reorder highlight above (also
          // style.outline) since a plain hover never coincides with an
          // active drag.
          let selectedNode = null;
          let hoveredNode = null;
          document.addEventListener("pointerover", (e) => {
            const node = e.target.closest("[data-designer-path]");
            if (node === hoveredNode) return;
            if (hoveredNode && hoveredNode !== selectedNode) visualTarget(hoveredNode).style.outline = "";
            hoveredNode = node;
            if (node && node !== selectedNode && !dragState) {
              visualTarget(node).style.outline = "1px dashed rgba(15,98,254,0.55)";
            }
          });
          document.addEventListener("pointerout", (e) => {
            if (e.target.closest("[data-designer-path]") !== hoveredNode) return;
            if (hoveredNode && hoveredNode !== selectedNode) visualTarget(hoveredNode).style.outline = "";
            hoveredNode = null;
          });

          // Reports the selected node's on-screen box so Designer.tsx can
          // position a floating action toolbar over it — recomputed on
          // resize (ResizeObserver, covers a live style edit changing the
          // box, or the iframe's own container resizing) and on scroll
          // (position-only change, no size change, so ResizeObserver alone
          // wouldn't fire).
          function reportSelectedRect() {
            if (!selectedNode) return;
            const r = visualTarget(selectedNode).getBoundingClientRect();
            parent.postMessage(
              { type: "designer:selectedRect", rect: { top: r.top, left: r.left, width: r.width, height: r.height } },
              targetOrigin,
            );
          }
          const selectionResizeObserver = new ResizeObserver(reportSelectedRect);
          // Also reports plain scroll position (independent of any
          // selection) so Designer.tsx can restore it after a structural
          // edit forces this iframe to reload — see designer:restoreScroll
          // below.
          window.addEventListener(
            "scroll",
            () => {
              reportSelectedRect();
              parent.postMessage({ type: "designer:scroll", y: window.scrollY }, targetOrigin);
            },
            true,
          );

          window.addEventListener("message", (e) => {
            if (e.origin !== targetOrigin || !e.data) return;
            if (e.data.type === "designer:restoreScroll") {
              window.scrollTo(0, e.data.y ?? 0);
              return;
            }
            if (e.data.type === "designer:selected") {
              if (selectedNode) visualTarget(selectedNode).style.outline = "";
              selectionResizeObserver.disconnect();
              selectedNode = e.data.path ? findByPath(e.data.path) : null;
              if (selectedNode) {
                visualTarget(selectedNode).style.outline = "2px solid #0f62fe";
                selectionResizeObserver.observe(visualTarget(selectedNode));
                reportSelectedRect();
              }
              return;
            }
            const node = findByPath(e.data.path);
            if (!node) return;
            if (e.data.type === "designer:style") {
              Object.assign(node.style, e.data.style);
            } else if (e.data.type === "designer:text") {
              const target = visualTarget(node);
              target.contentEditable = String(Boolean(e.data.editable));
              if (e.data.editable && !target.dataset.designerBound) {
                target.dataset.designerBound = "1";
                const path = node.dataset.designerPath;
                target.addEventListener("input", () => {
                  parent.postMessage({ type: "designer:textInput", path, value: target.textContent }, targetOrigin);
                });
              }
            }
          });
        })();
      </script>
    )}
  </body>
</html>
