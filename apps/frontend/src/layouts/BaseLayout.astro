            }
            const lockBtn = chromeBtn(locked ? "lock" : "unlock", locked ? L("unlock", "Unlock") : L("lock", "Lock"));
            if (locked) lockBtn.style.color = ACCENT;
            if (!locked && !isSlideFree(node)) {
              lockBtn.disabled = true;
              lockBtn.style.opacity = ".4";
            }
            lockBtn.addEventListener("click", () => actSlide(node, "lock", locked ? "" : "true"));
            const dup = chromeBtn("copy", L("duplicate", "Duplicate"));
            dup.addEventListener("click", () => actSlide(node, "duplicate"));
            const del = chromeBtn("trash", L("delete", "Delete"));
            del.addEventListener("click", () => actSlide(node, "delete"));
            let moveBtn = null;
            if (!isSlideFree(node) && !locked) {
              moveBtn = chromeBtn("move", L("move", "Move"));
              moveBtn.addEventListener("click", () => makeSlideFree(node));
            }
            const more = chromeBtn("more", L("alignToSlide", "Align to slide"));
            more.disabled = !hasGestureControls;
            if (!hasGestureControls) more.style.opacity = ".4";
            more.addEventListener("click", () =>
              openMenu("align", () => {
                menu.style.width = "11rem";
                const head = document.createElement("div");
                head.textContent = L("alignToSlide", "Align to slide");
                head.style.cssText = "padding:2px 6px 6px;color:#6b7280;";
                menu.appendChild(head);
                const ALIGN = [["left", "Left"], ["center", "Center"], ["right", "Right"], ["top", "Top"], ["middle", "Middle"], ["bottom", "Bottom"]];
                for (const [k, fallback] of ALIGN) {
                  const item = chromeBtn(null, "", L(k, fallback));
                  item.style.cssText += "width:100%;justify-content:flex-start;border-radius:6px;" + (k === "top" ? "margin-top:4px;" : "");
                  item.disabled = !hasGestureControls;
                  if (!hasGestureControls) item.style.opacity = ".4";
                  item.addEventListener("click", () => {
                    menu.style.display = "none";
                    alignSlide(node, k);
                  });
                  menu.appendChild(item);
                }
              }),
            );
            bar.append(lockBtn, dup, del);
            if (moveBtn) bar.appendChild(moveBtn);
            bar.appendChild(more);

            document.body.append(box, bar);
            const chrome = { box, bar, raf: 0 };
            slideChrome = chrome;
            // ponytail: re-measures every frame while something is selected
            // (one getBoundingClientRect) — the simplest way to follow scroll,
            // Swiper moves and live gestures at once; switch to observers if it
            // ever shows up in a profile.
            const place = () => {
              if (slideChrome !== chrome) return;
              if (!node.isConnected) {
                selectSlideNode(null);
                return;
              }
              const r = node.getBoundingClientRect();
              const cx = r.left + r.width / 2;
              const cy = r.top + r.height / 2;
              box.style.left = cx - node.offsetWidth / 2 + "px";
              box.style.top = cy - node.offsetHeight / 2 + "px";
              box.style.width = node.offsetWidth + "px";
              box.style.height = node.offsetHeight + "px";
              box.style.rotate = getComputedStyle(node).rotate;
              const bw = bar.offsetWidth;
              const bh = bar.offsetHeight;
              bar.style.left = Math.max(4, Math.min(window.innerWidth - bw - 4, cx - bw / 2)) + "px";
              // Flips below near the viewport's top; free elements have the
              // Rotate/Move pair between their box and the toolbar.
              bar.style.top =
                (r.top - bh - 12 >= 4 ? r.top - bh - 12 : r.bottom + (hasGestureControls ? 50 : 12)) + "px";
              chrome.raf = requestAnimationFrame(place);
            };
            place();
          }

          // A free image or button contains a natively draggable image/link;
          // prevent that browser drag from cancelling our pointer gesture.
          document.addEventListener("dragstart", (e) => {
            const node = e.target.closest && e.target.closest("[data-slide-sel]");
            if (isSlideFree(node)) e.preventDefault();
          });
          document.addEventListener("pointerdown", (e) => {
            const node = e.target.closest("[data-slide-sel]");
            if (!node || !node.closest(".ds-slide")) return;
            // All nested slide elements get a visible selection toolbar. The
            // direct-canvas Move/resize gestures stay exclusive to elements
            // already in Free Position mode; flow text remains selectable.
            selectSlideNode(node);
            postSelectSlide(node);
            if (isSlideFree(node) && !node.isContentEditable) {
              e.preventDefault();
              e.stopPropagation();
              if (node.dataset.slideLocked !== "true") startSlideDrag(e, node);
            }
          });

          function findByPath(path) {
            return document.querySelector(`[data-designer-path="${path}"]`);
          }

          // Every element-level wrapper (SectionBlock.astro's
          // `<div data-designer-path=... style="display:contents">`) has no
          // box of its own — display:contents renders only its children, so
          // non-inherited properties like outline/border set on the wrapper
          // itself are invisible, and contentEditable's focus/caret handling
          // doesn't reliably attach to it either. typoStyle's own properties
          // (color, font-family, ...) still reach the child fine since those
          // are inherited CSS, but outline and contentEditable need the
          // actual rendered child instead.
          function visualTarget(node) {
            if (!node) return null;
            return getComputedStyle(node).display === "contents" ? node.firstElementChild || node : node;
          }

          // Padding/margin drag handles — parity with Blocks mode's
          // DesignerCanvas.tsx (startSpacingDrag/writeDragSideKeys), ported
          // here so Live Edit's real rendered page gets the same drag-to-
          // resize UX instead of Inspector-field-only editing. Scoped to
          // Section (path length 1), Column (3) and Element (4) — same
          // depths Blocks mode's own handles cover; Row has none there
          // either (and has no data-designer-path here to address it).
          // Reads current values via getComputedStyle rather than
          // reimplementing the PAD-table/axis-fallback resolution chain a
          // third time — the browser has already resolved that into the
          // real rendered px, which is the actual source of truth here.
          const PADDING_KEYS = { top: "paddingTop", right: "paddingRight", bottom: "paddingBottom", left: "paddingLeft" };
          const MARGIN_KEYS = { top: "marginTop", right: "marginRight", bottom: "marginBottom", left: "marginLeft" };
          const MARGIN_COLOR = "#f59e0b";
          // Set once per designer:selected message (see below) from
          // useLiveEditBridge.ts's own linkedPadding/linkedMargin — the
          // Inspector's chain-icon toggle, not duplicated here.
          let spacing = { linkedPadding: false, linkedMargin: false };
          let spacingHandleBox = null;
          let spacingHandleEls = [];
          let spacingRestorePosition = null;
          let spacingLockBar = null;
          let spacingLockBarTimer = 0;
          // A lock click rebuilds the handles (admin re-sends
          // designer:selected) — carry the pill's visibility across it.
          let spacingLockBarKeep = false;

          // Pill stays hidden until a badge is touched, then fades out after
          // a few idle seconds; `hold` keeps it up while hovering/dragging.
          function revealLockBar(hold) {
            if (!spacingLockBar) return;
            clearTimeout(spacingLockBarTimer);
            spacingLockBar.style.opacity = "1";
            spacingLockBar.style.visibility = "visible";
            placeSpacingLockBar();
            if (!hold) spacingLockBarTimer = setTimeout(hideLockBar, 3000);
          }
          function hideLockBar() {
            if (!spacingLockBar) return;
            spacingLockBar.style.opacity = "0";
            spacingLockBar.style.visibility = "hidden";
          }

          function kebab(key) {
            return key.replace(/[A-Z]/g, (m) => "-" + m.toLowerCase());
          }

          function destroySpacingHandles() {
            for (const el of spacingHandleEls) el.remove();
            spacingHandleEls = [];
            if (spacingHandleBox && spacingRestorePosition !== null) {
              spacingHandleBox.style.position = spacingRestorePosition;
            }
            spacingHandleBox = null;
            spacingRestorePosition = null;
            spacingLockBar = null;
            clearTimeout(spacingLockBarTimer);
          }

          // Fixed, not a child of the box like the badges: a section's own
          // overflow:hidden or the viewport edge can't clip it. Sits just
          // above the box's top-left, clamped on-screen, and follows the box
          // off-screen once it scrolls away.
          function placeSpacingLockBar() {
            if (!spacingLockBar || !spacingHandleBox) return;
            const r = spacingHandleBox.getBoundingClientRect();
            const w = spacingLockBar.offsetWidth;
            const h = spacingLockBar.offsetHeight;
            spacingLockBar.style.left = `${Math.max(4, Math.min(r.left, innerWidth - w - 4))}px`;
            spacingLockBar.style.top = `${Math.min(Math.max(r.top - h - 10, 4), r.bottom - h)}px`;
          }

          function positionSpacingHandle(handle, edge, isMargin) {
            Object.assign(handle.style, { left: "", right: "", top: "", bottom: "", transform: "" });
            if (edge === "top") {
              Object.assign(handle.style, isMargin ? { right: "32px", top: "-8px" } : { left: "50%", top: "0", transform: "translate(-50%,-50%)" });
            } else if (edge === "bottom") {
              Object.assign(handle.style, isMargin ? { right: "32px", bottom: "-8px" } : { left: "50%", bottom: "0", transform: "translate(-50%,50%)" });
            } else if (edge === "left") {
              // Flush inside the edge instead of straddling it like Blocks
              // mode does — a full-bleed Section/Column's left/right edge
              // here is the viewport's own edge (Blocks' canvas has a
              // gutter), so an overhanging badge clips half off-screen.
              Object.assign(handle.style, isMargin ? { top: "32px", left: "0" } : { top: "50%", left: "0", transform: "translateY(-50%)" });
            } else {
              Object.assign(handle.style, isMargin ? { top: "32px", right: "0" } : { top: "50%", right: "0", transform: "translateY(-50%)" });
            }
          }

          function buildSpacingHandles(node, path) {
            if (![1, 3, 4].includes(path.length)) return;
            const box = visualTarget(node);
            if (!box) return;
            spacingHandleBox = box;
            spacingRestorePosition = getComputedStyle(box).position === "static" ? box.style.position || "" : null;
            if (spacingRestorePosition !== null) box.style.position = "relative";
            const groups = { padding: [], margin: [] };

            function addHandle(isMargin, edge) {
              const keyMap = isMargin ? MARGIN_KEYS : PADDING_KEYS;
              const key = keyMap[edge];
              const prop = kebab(key);
              const axis = edge === "top" || edge === "bottom" ? "y" : "x";
              const sign = edge === "top" || edge === "left" ? 1 : -1;
              const linked = isMargin ? spacing.linkedMargin : spacing.linkedPadding;
              const touched = linked ? Object.values(keyMap) : [key];
              const stripe = isMargin
                ? "repeating-linear-gradient(45deg,rgba(245,158,11,0.35) 0,rgba(245,158,11,0.35) 6px,rgba(245,158,11,0.12) 6px,rgba(245,158,11,0.12) 12px)"
                : "repeating-linear-gradient(45deg,rgba(15,98,254,0.35) 0,rgba(15,98,254,0.35) 6px,rgba(15,98,254,0.12) 6px,rgba(15,98,254,0.12) 12px)";

              const band = document.createElement("div");
              band.style.cssText = `position:absolute;pointer-events:none;z-index:9998;display:none;background-image:${stripe};`;
              box.appendChild(band);
              spacingHandleEls.push(band);

              const handle = document.createElement("div");
              handle.style.cssText =
                "position:absolute;z-index:9999;padding:2px 6px;border-radius:4px;color:#fff;" +
                "font:700 9px/1.2 system-ui,sans-serif;user-select:none;" +
                `background:${isMargin ? MARGIN_COLOR : ACCENT};` +
                `cursor:${axis === "y" ? "ns-resize" : "ew-resize"};`;
              positionSpacingHandle(handle, edge, isMargin);
              box.appendChild(handle);
              spacingHandleEls.push(handle);

              function currentPx() {
                return Math.round(parseFloat(getComputedStyle(box).getPropertyValue(prop)) || 0);
              }
              // Band only while hovering/dragging this edge (Blocks mode's
              // hoverBand rule) — showing all 8 on select buries the content.
              function render(px, showBand = true) {
                handle.textContent = `${px}px`;
                band.style.display = px && showBand ? "block" : "none";
                if (!px || !showBand) return;
                const offset = isMargin ? -px : 0;
                if (edge === "top") Object.assign(band.style, { left: "0", right: "0", top: `${offset}px`, bottom: "", height: `${px}px`, width: "" });
                else if (edge === "bottom")
                  Object.assign(band.style, { left: "0", right: "0", bottom: `${offset}px`, top: "", height: `${px}px`, width: "" });
                else if (edge === "left")
                  Object.assign(band.style, { top: "0", bottom: "0", left: `${offset}px`, right: "", width: `${px}px`, height: "" });
                else Object.assign(band.style, { top: "0", bottom: "0", right: `${offset}px`, left: "", width: `${px}px`, height: "" });
              }
              render(currentPx(), false);
              const view = { render, currentPx };
              const group = groups[isMargin ? "margin" : "padding"];
              group.push(view);
              // Linked: hovering/dragging one edge shows every side's band and
              // live px together (Blocks mode's bandKey `.*` rule), since a
              // drag writes all four anyway.
              const peers = () => (linked ? group : [view]);
              const show = (on, px) => peers().forEach((v) => v.render(px ?? v.currentPx(), on));

              handle.addEventListener("pointerenter", () => {
                show(true);
                revealLockBar(true);
              });
              handle.addEventListener("pointerleave", () => {
                if (handle.dataset.dragging === "1") return;
                show(false);
                revealLockBar(false);
              });

              handle.addEventListener("pointerdown", (e) => {
                e.stopPropagation();
                e.preventDefault();
                handle.dataset.dragging = "1";
                revealLockBar(true);
                const startPx = currentPx();
                const startPos = axis === "y" ? e.clientY : e.clientX;
                let lastPx = startPx;
                track(
                  e,
                  (ev) => {
                    const pos = axis === "y" ? ev.clientY : ev.clientX;
                    lastPx = Math.max(0, Math.round(startPx + sign * (pos - startPos)));
                    for (const k of touched) setImp(box, kebab(k), `${lastPx}px`);
                    show(true, lastPx);
                  },
                  (moved) => {
                    delete handle.dataset.dragging;
                    // A top/left drag ends with the pointer away from its
                    // badge (that edge doesn't move), so pointerleave was
                    // swallowed mid-drag — re-check instead of leaving the
                    // band stuck on until the reload.
                    show(handle.matches(":hover"), moved ? lastPx : undefined);
                    revealLockBar(handle.matches(":hover"));
                    if (!moved) return;
                    parent.postMessage({ type: "designer:spacingDrag", path: path.join("."), fields: touched, px: lastPx }, targetOrigin);
                  },
                );
              });
            }

            ["top", "bottom", "left", "right"].forEach((edge) => addHandle(false, edge));
            ["top", "bottom", "left", "right"].forEach((edge) => addHandle(true, edge));

            // Quick toggle for the same linkedPadding/linkedMargin state as the
            // Inspector's chain icon — admin flips it and re-sends
            // designer:selected, which rebuilds these handles with the new mode.
            const bar = document.createElement("div");
            bar.style.cssText =
              "position:fixed;z-index:2147482000;display:flex;gap:2px;padding:2px;background:#fff;" +
              "border:1px solid rgba(0,0,0,.12);border-radius:999px;box-shadow:0 4px 12px rgba(0,0,0,.15);" +
              "font:600 10px/1 system-ui,sans-serif;white-space:nowrap;" +
              "opacity:0;visibility:hidden;transition:opacity .15s,visibility .15s;";
            stopBubble(bar);
            bar.addEventListener("pointerenter", () => revealLockBar(true));
            bar.addEventListener("pointerleave", () => revealLockBar(false));
            for (const [kind, name, color] of [["padding", "Padding", ACCENT], ["margin", "Margin", MARGIN_COLOR]]) {
              const on = kind === "padding" ? spacing.linkedPadding : spacing.linkedMargin;
              const b = chromeBtn(on ? "lock" : "unlock", `${name}: ${L("linkSides", "Link all sides")}`, name);
              b.style.height = "22px";
              b.style.background = on ? color : "#fff";
              b.style.color = on ? "#fff" : color;
              b.setAttribute("aria-pressed", String(on));
              b.addEventListener("click", () => {
                spacingLockBarKeep = true;
                parent.postMessage({ type: "designer:spacingLink", kind }, targetOrigin);
              });
              bar.appendChild(b);
            }
            document.body.appendChild(bar);
            spacingHandleEls.push(bar);
            spacingLockBar = bar;
            placeSpacingLockBar();
            if (spacingLockBarKeep) {
              spacingLockBarKeep = false;
              revealLockBar(false);
            }
          }

          // Puck-style hover/selected feedback: a light dashed outline under
          // the pointer, a solid one on whatever `sel` currently is in
          // Designer.tsx (see its designer:selected postMessage below) —
          // kept separate from the drag-reorder highlight above (also
          // style.outline) since a plain hover never coincides with an
          // active drag.
          let selectedNode = null;
          let hoveredNode = null;
          document.addEventListener("pointerover", (e) => {
            const node = e.target.closest("[data-designer-path]");
            if (node === hoveredNode) return;
            if (hoveredNode && hoveredNode !== selectedNode) visualTarget(hoveredNode).style.outline = "";
            hoveredNode = node;
            if (node && node !== selectedNode && !dragState) {
              visualTarget(node).style.outline = "1px dashed rgba(15,98,254,0.55)";
            }
          });
          document.addEventListener("pointerout", (e) => {
            if (e.target.closest("[data-designer-path]") !== hoveredNode) return;
            if (hoveredNode && hoveredNode !== selectedNode) visualTarget(hoveredNode).style.outline = "";
            hoveredNode = null;
          });

          // Reports the selected node's on-screen box so Designer.tsx can
          // position a floating action toolbar over it — recomputed on
          // resize (ResizeObserver, covers a live style edit changing the
          // box, or the iframe's own container resizing) and on scroll
          // (position-only change, no size change, so ResizeObserver alone
          // wouldn't fire).
          function reportSelectedRect() {
            if (!selectedNode) return;
            placeSpacingLockBar();
            const r = visualTarget(selectedNode).getBoundingClientRect();
            parent.postMessage(
              { type: "designer:selectedRect", rect: { top: r.top, left: r.left, width: r.width, height: r.height } },
              targetOrigin,
            );
          }
          const selectionResizeObserver = new ResizeObserver(reportSelectedRect);
          // Also reports plain scroll position (independent of any
          // selection) so Designer.tsx can restore it after a structural
          // edit forces this iframe to reload — see designer:restoreScroll
          // below.
          window.addEventListener(
            "scroll",
            () => {
              reportSelectedRect();
              parent.postMessage({ type: "designer:scroll", y: window.scrollY }, targetOrigin);
            },
            true,
          );

          let lastReportedTarget = null;
          let dropIndicatorEl = null;

          // Hand-ported from apps/admin/src/designer/liveEditDropTarget.ts's
          // resolveInsertionIndex/resolveDropTargetFromPath — this script is
          // <script is:inline> (deliberately unbundled plain JS, no
          // imports), so the two copies are kept in sync by hand. Keep the
          // logic identical — liveEditDropTarget.test.ts is this function's
          // real test coverage, run there, not here.
          function resolveInsertionIndexPlain(pointerY, hoveredTop, hoveredHeight, hoveredIndex) {
            const midpoint = hoveredTop + hoveredHeight / 2;
            return pointerY < midpoint ? hoveredIndex : hoveredIndex + 1;
          }

          // Kept narrow (a fixed px band, not the generous 1/3 the
          // section's OWN box gets when hovered directly) so it doesn't
          // swallow most of a tall, content-packed section's own
          // drop-into-column area. See liveEditDropTarget.ts's own comment.
          const SECTION_EDGE_BAND_PX = 12;

          function resolveDropTargetFromPathPlain(path, pointerY, hoveredRect, sectionRect, sectionCount) {
            if (!path || !hoveredRect) return { kind: "new-section", afterBlockIndex: sectionCount - 1 };
            const sectionIndex = path[0];
            if (path.length === 1) {
              const third = hoveredRect.height / 3;
              if (pointerY <= hoveredRect.top + third) return { kind: "new-section", afterBlockIndex: sectionIndex - 1 };
              if (pointerY >= hoveredRect.bottom - third) return { kind: "new-section", afterBlockIndex: sectionIndex };
              return { kind: "into-column", colPath: [sectionIndex, 0, 0] };
            }
            // A full-bleed/zero-padding section's own box is never
            // directly reachable via elementFromPoint (its content fills
            // the whole box) — without this fallback, "drop between
            // sections" would have no reachable zone at all for such a
            // section.
            if (sectionRect) {
              if (pointerY <= sectionRect.top + SECTION_EDGE_BAND_PX) return { kind: "new-section", afterBlockIndex: sectionIndex - 1 };
              if (pointerY >= sectionRect.bottom - SECTION_EDGE_BAND_PX) return { kind: "new-section", afterBlockIndex: sectionIndex };
            }
            // Column-level node: the path itself IS the column to append
            // into — must NOT fall into the element branch below (that
            // would splice an element into the PARENT row's own columns
            // array instead of this column's elements array).
            if (path.length === 3) return { kind: "into-column", colPath: path };
            const colPath = path.slice(0, -1);
            const hoveredIndex = path[path.length - 1];
            const index = resolveInsertionIndexPlain(pointerY, hoveredRect.top, hoveredRect.height, hoveredIndex);
            return { kind: "into-column", colPath, index };
          }

          // x/y are iframe-local px (already translated by the admin parent
          // via clientToIframeLocal before this message was sent).
          function resolveDropTarget(x, y) {
            const el = document.elementFromPoint(x, y);
            const node = el && el.closest("[data-designer-path]");
            const sectionCount = document.querySelectorAll('[data-designer-path]:not([data-designer-path*="."])').length;
            if (!node) return resolveDropTargetFromPathPlain(null, y, null, null, sectionCount);
            const path = node.dataset.designerPath.split(".").map(Number);
            // Element-level wrappers render as display:contents
            // (SectionBlock.astro) and have no box of their own —
            // visualTarget (defined above) resolves to the real rendered
            // child, the same reason the click/selection-outline code
            // already needs it (see this file's own reportSelectedRect).
            const measureNode = path.length >= 4 ? visualTarget(node) : node;
            const rect = measureNode.getBoundingClientRect();
            const sectionNode = path.length === 1 ? node : findByPath(String(path[0]));
            const sectionRect = sectionNode ? sectionNode.getBoundingClientRect() : null;
            return resolveDropTargetFromPathPlain(path, y, rect, sectionRect, sectionCount);
          }

          function drawDropIndicator(target) {
            if (!target) {
              if (dropIndicatorEl) dropIndicatorEl.style.display = "none";
              return;
            }
            if (!dropIndicatorEl) {
              dropIndicatorEl = document.createElement("div");
              dropIndicatorEl.style.position = "fixed";
              dropIndicatorEl.style.zIndex = "99999";
              dropIndicatorEl.style.pointerEvents = "none";
              document.body.appendChild(dropIndicatorEl);
            }
            dropIndicatorEl.style.display = "block";
            if (target.kind === "new-section") {
              // By exact path match (findByPath), not a NodeList index —
              // an unstamped block type (e.g. GenericBlock) or a
              // breakpoint-hidden section shifts a plain querySelectorAll
              // NodeList out of alignment with the real block index,
              // drawing the line at the wrong boundary (final review
              // finding; visual-only, the commit itself was never wrong).
              const after = findByPath(String(target.afterBlockIndex));
              const before = findByPath(String(target.afterBlockIndex + 1));
              const y = after ? after.getBoundingClientRect().bottom : before ? before.getBoundingClientRect().top : 0;
              Object.assign(dropIndicatorEl.style, { left: "0", width: "100%", top: `${y - 2}px`, height: "4px", background: "#0f62fe", border: "none" });
            } else {
              const colNode = document.querySelector(`[data-designer-path="${target.colPath.join(".")}"]`);
              if (!colNode) {
                dropIndicatorEl.style.display = "none";
                return;
              }
              const rect = colNode.getBoundingClientRect();
              Object.assign(dropIndicatorEl.style, {
                left: `${rect.left}px`,
                width: `${rect.width}px`,
                top: `${rect.top}px`,
                height: `${rect.height}px`,
                background: "rgba(15, 98, 254, 0.15)",
                border: "2px dashed #0f62fe",
              });
            }
          }

          window.addEventListener("message", (e) => {
            if (e.origin !== targetOrigin || !e.data) return;
            // Live Edit drag-to-add (see
            // docs/superpowers/specs/2026-10-08-live-edit-drag-to-add-design.md).
            // dropIndicatorEl is a single reused <div>, created lazily on
            // first use and repositioned on every move rather than recreated.
            if (e.data.type === "designer:paletteDragMove") {
              const target = resolveDropTarget(e.data.x, e.data.y);
              const changed = JSON.stringify(target) !== JSON.stringify(lastReportedTarget);
              lastReportedTarget = target;
              drawDropIndicator(target);
              if (changed) parent.postMessage({ type: "designer:dropTarget", target }, targetOrigin);
              return;
            }
            if (e.data.type === "designer:paletteDragEnd") {
              lastReportedTarget = null;
              drawDropIndicator(null);
              return;
            }
            if (e.data.type === "designer:restoreScroll") {
              window.scrollTo(0, e.data.y ?? 0);
              return;
            }
            // Keeps each slider on the slide the author is editing across a
            // Live Edit reload (Swiper would otherwise reset to slide 0) —
            // map is { [slider element id]: slide index }, same keying as
            // Designer.tsx's sliderSlideIdx.
            if (e.data.type === "designer:showSlides") {
              for (const [id, idx] of Object.entries(e.data.map || {})) {
                const vp = document.querySelector(`[data-slider-id="${CSS.escape(id)}"] .ds-slider-viewport`);
                if (vp && vp.swiper) vp.swiper.slideToLoop(Number(idx) || 0, 0);
              }
              return;
            }
            if (e.data.type === "designer:selected") {
              if (e.data.labels) labels = e.data.labels;
              if (e.data.spacing) spacing = e.data.spacing;
              if (selectedNode) visualTarget(selectedNode).style.outline = "";
              selectionResizeObserver.disconnect();
              destroySpacingHandles();
              selectedNode = e.data.path ? findByPath(e.data.path) : null;
              // Designer names the selected slide child ("slideIdx.r.c.e") —
              // re-attaches its chrome after every reload, and drops it when
              // selection moved elsewhere (Layers tree/Inspector).
              const slideChild =
                selectedNode && e.data.slideSel
                  ? selectedNode.querySelector(`[data-slide-sel="${CSS.escape(e.data.slideSel)}"]`)
                  : null;
              selectSlideNode(slideChild);
              if (selectedNode) {
                visualTarget(selectedNode).style.outline = "2px solid #0f62fe";
                selectionResizeObserver.observe(visualTarget(selectedNode));
                reportSelectedRect();
                // Skip when a slide-nested child is the real target (slideChild) —
                // that child gets its own full gesture chrome from selectSlideNode
                // above (resize handles, rotate/move, toolbar), anchored to itself.
                // Also building padding/margin handles for the outer slider element
                // at the same time drew two unrelated, disconnected sets of drag
                // chrome at once — the slider's own box can be full-bleed, so its
                // corner handles end up nowhere near the small selected slide child,
                // reading as broken/overlapping rather than as two valid selections.
                if (!slideChild) buildSpacingHandles(selectedNode, String(e.data.path).split(".").map(Number));
              }
              return;
            }
            const node = findByPath(e.data.path);
            if (!node) return;
            if (e.data.type === "designer:text") {
              const target = visualTarget(node);
              target.contentEditable = String(Boolean(e.data.editable));
              if (e.data.editable && !target.dataset.designerBound) {
                target.dataset.designerBound = "1";
                const path = node.dataset.designerPath;
                target.addEventListener("input", () => {
                  parent.postMessage({ type: "designer:textInput", path, value: target.textContent }, targetOrigin);
                });
              }
            }
          });
        })();
      </script>
    )}
    <script is:inline>
      // Scroll-driven entrance animations (global.css's .ds-entrance-*,
      // animation-timeline:view()) can get permanently stuck at their
      // `from` keyframe (opacity:0) when the element is already inside the
      // viewport and the page never needs to scroll to reveal it — a
      // short page, or any above-the-fold hero/slider that fills the
      // viewport on its own. The view-timeline then has no scroll distance
      // to report progress against, so it never reaches "entered". The
      // original @supports fallback (see global.css's own comment) only
      // accounted for browsers that DON'T support animation-timeline —
      // this covers the separate case of a supporting browser whose
      // timeline simply never moves. Force those elements straight to
      // their end state instead of waiting on a timeline that may never
      // run; anything genuinely below the fold is left alone so real
      // scroll-reveal still plays.
      (() => {
        const SEL = ".ds-entrance-fade,.ds-entrance-slide-up,.ds-entrance-zoom";
        const settle = () => {
          document.querySelectorAll(SEL).forEach((el) => {
            if (el.dataset.dsEntranceDone) return;
            const r = el.getBoundingClientRect();
            if (r.top < window.innerHeight && r.bottom > 0) {
              el.dataset.dsEntranceDone = "1";
              el.style.animation = "none";
            }
          });
        };
        settle();
        window.addEventListener("load", settle);
        window.addEventListener("resize", settle);
      })();
    </script>
  </body>
</html>
