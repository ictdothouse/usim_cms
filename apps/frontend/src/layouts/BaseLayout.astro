              "border-radius:10px;box-shadow:0 6px 18px rgba(0,0,0,.18);";
            const openMenu = (kind, fill) => {
              const wasOpen = menu.style.display !== "none" && menu.dataset.kind === kind;
              menu.replaceChildren();
              menu.style.display = "none";
              if (wasOpen) return;
              menu.dataset.kind = kind;
              menu.style.left = kind === "link" ? "0" : "auto";
              menu.style.right = kind === "link" ? "auto" : "0";
              fill();
              menu.style.display = "block";
            };
            bar.appendChild(menu);
            if (type === "button") {
              const link = chromeBtn("link", L("editLink", "Edit link"), L("editLink", "Edit link"));
              link.addEventListener("click", () =>
                openMenu("link", () => {
