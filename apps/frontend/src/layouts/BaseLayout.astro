          });

          // Canva-style editing for a slide-nested free-positioned element
          // (props.position === "custom") — the Live Edit port of apps/admin's
          // ElPreview.tsx slider case: 8 resize handles, Rotate + Move under
          // the box, magenta center-snap guides, and a floating toolbar (Edit
          // link, Lock, Duplicate, Delete, "…" align to slide). Same math as
          // there (snap candidates mirror apps/admin/src/designer/snap.ts),
          // hand-ported since this script stays a plain dependency-free
          // `is:inline` tag. Each gesture runs natively against this iframe's
          // real DOM (instant) and posts its result once, on pointerup
          // (designer:slideElDrag); toolbar buttons post designer:slideElAction.
          // Either changes Designer's blocks, which reloads this page through
          // the real renderer — the chrome is re-attached afterwards off
          // designer:selected's slideSel. The chrome lives on <body> as
          // position:fixed overlays, never inside the element: the slide's own
          // overflow:hidden would crop it, a toolbar inside a rotated element
          // would rotate with it, and appending into a heading changes its text.
          const ACCENT = "#0f62fe";
          let labels = {};
