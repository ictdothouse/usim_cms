---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroBlock from "../components/HeroBlock.astro";
import { getTheme, getSiteChromeById, getLivePreviewOverride } from "../lib/api";

// Designer's Header/Footer device-preview modal and Live Edit — renders one siteChrome row
// standalone inside BaseLayout, with placeholder body content so the
// header/footer alone can be judged in context without needing a real page.
// Unlike blueprint-preview.astro, no preview token is needed: siteChrome's
// own GET /api/siteChrome/:id is already publicly readable regardless of
// draft/published status (see siteChromeCollection's access.read in
// apps/api/src/index.ts) — id alone is the entire access check.
const rawHost = Astro.request.headers.get("host") ?? "";
const tenantHost =
  /^(localhost|127\.0\.0\.1)(:\d+)?$/.test(rawHost)
    ? (Astro.url.searchParams.get("__tenant") ?? import.meta.env.DEV_TENANT_HOST ?? rawHost)
    : rawHost;

const id = Astro.url.searchParams.get("id") ?? "";
const kind = Astro.url.searchParams.get("kind") === "footer" ? "footer" : "header";
const previewToken = Astro.url.searchParams.get("token") ?? "";
// Designer's Live Edit of this header/footer (useLiveEditBridge): the same
// designerEdit bridge a page gets, with the chrome as the edited document.
// Token-gated like [...slug].astro's.
const designerEdit = Astro.url.searchParams.get("designerEdit") === "1" && Boolean(previewToken);
let chrome = id ? await getSiteChromeById(tenantHost, id) : null;
if (!chrome) {
  Astro.response.status = 404;
} else if (previewToken) {
  // No prior Save required — see [...slug].astro's own comment on this
  // same mechanism.
  const draft = await getLivePreviewOverride(tenantHost, previewToken);
  if (draft?.layout) chrome = { ...chrome, layout: draft.layout };
}
const siteTheme = await getTheme(tenantHost);
// A transparent header floats over a stand-in hero; a sticky one gets room to scroll.
const headerSettings = kind === "header" ? chrome?.settings : undefined;
---
<BaseLayout
  title="Header/Footer preview"
  theme={siteTheme}
  langSwitcher={null}
  headerChrome={kind === "header" ? chrome : null}
  footerChrome={kind === "footer" ? chrome : null}
  tenantHost={tenantHost}
  designerEdit={designerEdit}
  chromeEdit={designerEdit}
>
  {!chrome ? (
    <HeroBlock title="Preview not available" subtitle="This header/footer preview link is invalid." />
  ) : headerSettings?.transparent ? (
    <div style="min-height:70vh;display:grid;place-items:center;padding:2rem 1rem;text-align:center;background:linear-gradient(160deg,#1e293b,#64748b);color:#e2e8f0;">
      <p>Page content appears here.</p>
    </div>
  ) : (
    <div style="max-width:44rem;margin:4rem auto;padding:2rem 1rem;text-align:center;color:#86868b;">
      <p>{kind === "header" ? "Page content appears here." : "Page content appears above."}</p>
    </div>
  )}
  {headerSettings?.sticky && <div style="height:150vh" />}
</BaseLayout>
