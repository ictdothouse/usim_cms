---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroBlock from "../components/HeroBlock.astro";
import GenericBlock from "../components/GenericBlock.astro";
import SectionBlock from "../components/SectionBlock.astro";
import { getPageBySlug, getTheme, getLanguages, getSeoDefaults, resolvePageLayout, resolveHeaderFooter, getLivePreviewOverride } from "../lib/api";
import { collectFonts } from "../lib/collectFonts";

// Single instance, ~50 real department domains: tenant identity is always
// the request's Host header, never subdomain parsing or build-time config
// (see CLAUDE.md). "home" is this site's convention for the root page,
// since apps/api's pages.slug is NOT NULL.
//
// ponytail: no real department domain resolves to plain localhost/127.0.0.1
// in any genuine deployment, so matching that pattern on the request's own
// Host header already scopes this safely — falls back to DEV_TENANT_HOST, or
// a `?__tenant=` override (used by the admin panel's per-page "View" link so
// any of several local tenants can be previewed, not just whichever one
// DEV_TENANT_HOST names). NOT gated on import.meta.env.DEV: that's baked
// false by Vite in every `astro build` (including this project's own
// docker-compose frontend image), which would make this dead code for any
// local docker testing, not just real deployments.
const rawHost = Astro.request.headers.get("host") ?? "";
const tenantHost =
  /^(localhost|127\.0\.0\.1)(:\d+)?$/.test(rawHost)
    ? (Astro.url.searchParams.get("__tenant") ?? import.meta.env.DEV_TENANT_HOST ?? rawHost)
    : rawHost;
const slug = Astro.params.slug || "home";
// Set by the admin's page "View" link (see apps/admin's previewUrl) to
// preview a draft page before it's published — forwarded as a Bearer token,
// never persisted or logged past this request.
const previewToken = Astro.url.searchParams.get("token") ?? undefined;
// Set by ThemeForm's "Test" button (see apps/admin's getThemePreviewToken) to
// render not-yet-saved theme settings — independent of previewToken above.
const themeToken = Astro.url.searchParams.get("themeToken") ?? undefined;

let page = await getPageBySlug(tenantHost, slug, previewToken);
// Designer's Preview/Live Edit — no prior Save required (Elementor/Avada-
// style): the SAME previewToken above may also carry a livePreviewId
// pointing at not-yet-saved layout/settings/translations, overlaid onto the
// real saved row for this render only. A missing/expired draft (or a plain
// draft-visibility-only token with nothing stashed) silently keeps the
// saved row as-is.
if (page && previewToken) {
  const draft = await getLivePreviewOverride(tenantHost, previewToken);
  if (draft) {
    page = {
      ...page,
      layout: draft.layout ?? page.layout,
      settings: draft.settings ?? page.settings,
      translations: draft.translations ?? page.translations,
    };
  }
}
const siteTheme = await getTheme(tenantHost, themeToken);
// Page Settings' theme picker is a snapshot copy (Theme panel's preset applied at
// pick-time, see Designer.tsx) — overlaid last so it wins over the tenant's own
// theme, but only for this one page's render.
const theme = page?.settings?.theme ? { ...siteTheme, ...page.settings.theme } : siteTheme;
if (!page) {
  Astro.response.status = 404;
}
// Designer.tsx's "live view" mode: an admin iframe requesting this same
// preview URL with an extra flag, so the bridge script + data-designer-path
// attributes only ever activate alongside a valid preview token — never for
// a real visitor, regardless of URL tampering (a public request has no
// previewToken at all).
const designerEdit = Astro.url.searchParams.get("designerEdit") === "1" && Boolean(previewToken);

// i18n Phase 5 — every language's layout now lives on this SAME page row
// (page.translations), so switching language re-renders this same row
// under a `?lang=` query param, not a link to a different slug/row.
const { enabled: siteLanguages, showHeaderSwitcher, switcherPosition, switcherStyle } = await getLanguages(tenantHost);
const tenantSeoDefaults = await getSeoDefaults(tenantHost);
const requestedLang = Astro.url.searchParams.get("lang");
const layout = page ? resolvePageLayout(page, requestedLang) : [];
const fonts = collectFonts(layout);
// Performance: find the image that will actually become the page's LCP
// element — only ever the very first element of the very first row/column
// of the first section (SectionBlock.astro treats that same position as
// "isFirst" and skips lazy-loading it) — so BaseLayout can <link
// rel=preload fetchpriority=high> it. A slider's slides are stored as a
// JSON string (see SectionBlock.astro's parseSlides); the legacy
// pipe-delimited slide format is skipped here (best-effort hint only, not a
// correctness requirement — a missed preload just means no LCP head start).
function findLcpImageUrl(blocks: typeof layout): string | null {
  const section = blocks[0];
  if (!section || section.type !== "section") return null;
  const rows = (section.props as Record<string, unknown> | undefined)?.rows;
  const row = Array.isArray(rows) ? (rows[0] as Record<string, unknown> | undefined) : undefined;
  const columns = row?.columns;
  const col = Array.isArray(columns) ? (columns[0] as Record<string, unknown> | undefined) : undefined;
  const elements = col?.elements;
  const el = Array.isArray(elements) ? (elements[0] as Record<string, unknown> | undefined) : undefined;
  if (!el) return null;
  const p = (el.props ?? {}) as Record<string, unknown>;
  if (el.type === "image" && typeof p.src === "string" && p.src) return p.src;
  if (el.type === "slider" && typeof p.slides === "string") {
    try {
      const slides: unknown = JSON.parse(p.slides);
      const firstSlide = Array.isArray(slides) ? (slides[0] as Record<string, unknown> | undefined) : undefined;
      if (firstSlide && typeof firstSlide.imageUrl === "string" && firstSlide.imageUrl) return firstSlide.imageUrl;
    } catch {
      // Legacy pipe-delimited slide format — no cheap way to pull the first
      // image out without duplicating SectionBlock.astro's whole parser.
    }
  }
  return null;
}
const lcpImage = page ? findLcpImageUrl(layout) : null;

// Auto-generated description suggestion: best-effort plain text pulled from
// the WHOLE layout tree's heading/text/list elements (not just the first
// one, unlike findLcpImageUrl above — a page's first element is often a
// hero image, not text), joined and trimmed to ~160 chars. Only ever used
// as the effectiveDescription fallback below when the author hasn't set
// seo.description — never written back to the row. apps/admin's
// InspectorPageSettings.tsx has its own small mirror of this same walk
// (operating on ctx.blocks instead of a fetched layout) used only as that
// field's placeholder — no shared code between admin/frontend, see CLAUDE.md.
// ponytail: naive heuristic (no markdown stripping) — good enough for a
// meta description guess, not a renderer.
function extractAutoDescription(blocks: typeof layout): string {
  const parts: string[] = [];
  outer: for (const block of blocks) {
    if (block.type !== "section") continue;
    const rows = (block.props as Record<string, unknown> | undefined)?.rows;
    if (!Array.isArray(rows)) continue;
    for (const row of rows as Record<string, unknown>[]) {
      const columns = (row as Record<string, unknown> | undefined)?.columns;
      if (!Array.isArray(columns)) continue;
      for (const col of columns as Record<string, unknown>[]) {
        const elements = (col as Record<string, unknown> | undefined)?.elements;
        if (!Array.isArray(elements)) continue;
        for (const el of elements as Record<string, unknown>[]) {
          const type = (el as Record<string, unknown> | undefined)?.type;
          const p = ((el as Record<string, unknown> | undefined)?.props ?? {}) as Record<string, unknown>;
          if ((type === "heading" || type === "text") && typeof p.text === "string" && p.text.trim()) {
            parts.push(p.text.trim());
          } else if (type === "list" && typeof p.items === "string" && p.items.trim()) {
            parts.push(p.items.split("\n").map((s) => s.trim()).filter(Boolean).join(", "));
          }
          if (parts.join(" ").length >= 160) break outer;
        }
      }
    }
  }
  return parts.join(" ").replace(/\s+/g, " ").trim().slice(0, 160);
}

// Native SEO + AEO: page.seo overrides fall back to an auto-extracted
// suggestion, then the tenant's own SEO defaults — see BaseLayout.astro's
// own Props comment for how these get rendered. Title gains the tenant's
// title template LAST, on top of whichever base title was already resolved
// (an unset/empty template leaves it completely unchanged).
const seo = page?.seo ?? {};
const autoDescription = page ? extractAutoDescription(layout) : "";
const effectiveTitleBase = seo.title || page?.title || "";
const effectiveTitle = tenantSeoDefaults.titleTemplate
  ? tenantSeoDefaults.titleTemplate.replace("%s", effectiveTitleBase)
  : effectiveTitleBase;
const effectiveDescription = seo.description || autoDescription || tenantSeoDefaults.defaultDescription || "";
const effectiveOgImage = seo.ogImage || page?.bannerImageUrl || undefined;
const canonicalUrl = seo.canonicalUrl || (page ? `https://${tenantHost}/${page.slug}` : undefined);
const jsonLd = page
  ? {
      "@context": "https://schema.org",
      "@type": "WebPage",
      name: effectiveTitle,
      ...(effectiveDescription ? { description: effectiveDescription } : {}),
      url: canonicalUrl,
      ...(requestedLang || page.language ? { inLanguage: requestedLang ?? page.language } : {}),
    }
  : null;
const pageLangLabel = (code: string | null) => siteLanguages.find((l) => l.code === code)?.label ?? code ?? "?";
const availableCodes = page ? [page.language, ...Object.keys(page.translations)].filter((c): c is string => Boolean(c)) : [];
const langSwitcher =
  page && showHeaderSwitcher && availableCodes.length > 1
    ? {
        current: requestedLang ?? page.language,
        position: switcherPosition,
        style: switcherStyle,
        options: availableCodes.map((code) => ({
          code,
          label: pageLangLabel(code),
          href: code === page.language ? `/${page.slug}` : `/${page.slug}?lang=${encodeURIComponent(code)}`,
        })),
      }
    : null;

const { header: headerChrome, footer: footerChrome } = page
  ? await resolveHeaderFooter(page, tenantHost, designerEdit)
  : { header: null, footer: null };
---
<BaseLayout
  title={page ? effectiveTitle : "Halaman tidak dijumpai"}
  ogImage={effectiveOgImage}
  metaDescription={effectiveDescription || null}
  noindex={seo.noindex ?? false}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
  theme={theme}
  fonts={fonts}
  designerEdit={designerEdit}
  langSwitcher={langSwitcher}
  headerChrome={headerChrome}
  footerChrome={footerChrome}
  tenantHost={tenantHost}
  requestedLang={requestedLang}
  lcpImage={lcpImage}
>
  {!page ? (
    <HeroBlock title="Halaman tidak dijumpai" subtitle="Kandungan ini belum tersedia atau telah dialihkan." />
  ) : (
    layout.map((block, b) => {
      switch (block.type) {
        case "section":
          return (
            <SectionBlock
              {...(block.props ?? {})}
              pageGap={page.settings?.gap}
              pageContentWidth={page.settings?.contentWidth}
              pagePaddingX={page.settings?.paddingX}
              designerEdit={designerEdit}
              blockIndex={b}
              tenantHost={tenantHost}
              requestedLang={requestedLang}
            />
          );
        default:
          return <GenericBlock type={block.type} props={block.props} />;
      }
    })
  )}
</BaseLayout>
