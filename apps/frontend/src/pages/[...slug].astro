---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroBlock from "../components/HeroBlock.astro";
import TextBlock from "../components/TextBlock.astro";
import ImageBlock from "../components/ImageBlock.astro";
import GenericBlock from "../components/GenericBlock.astro";
import SectionBlock from "../components/SectionBlock.astro";
import { getPageBySlug, getTheme, getLanguages, resolvePageLayout } from "../lib/api";
import { collectFonts } from "../lib/collectFonts";

// Single instance, ~50 real department domains: tenant identity is always
// the request's Host header, never subdomain parsing or build-time config
// (see CLAUDE.md). "home" is this site's convention for the root page,
// since apps/api's pages.slug is NOT NULL.
//
// ponytail: `astro dev` has no real department domain to hit, so plain
// localhost falls back to DEV_TENANT_HOST, or a `?__tenant=` override (used
// by the admin panel's per-page "View" link so any of several local tenants
// can be previewed, not just whichever one DEV_TENANT_HOST names) — dev
// convenience only (import.meta.env.DEV is false in `astro build`/`preview`),
// never affects a real deployment.
const rawHost = Astro.request.headers.get("host") ?? "";
const tenantHost =
  import.meta.env.DEV && /^(localhost|127\.0\.0\.1)(:\d+)?$/.test(rawHost)
    ? (Astro.url.searchParams.get("__tenant") ?? import.meta.env.DEV_TENANT_HOST ?? rawHost)
    : rawHost;
const slug = Astro.params.slug || "home";
// Set by the admin's page "View" link (see apps/admin's previewUrl) to
// preview a draft page before it's published — forwarded as a Bearer token,
// never persisted or logged past this request.
const previewToken = Astro.url.searchParams.get("token") ?? undefined;
// Set by ThemeForm's "Test" button (see apps/admin's getThemePreviewToken) to
// render not-yet-saved theme settings — independent of previewToken above.
const themeToken = Astro.url.searchParams.get("themeToken") ?? undefined;

const page = await getPageBySlug(tenantHost, slug, previewToken);
if (!page) {
  return new Response("Not found", { status: 404 });
}
const theme = await getTheme(tenantHost, themeToken);
// Designer.tsx's "live view" mode: an admin iframe requesting this same
// preview URL with an extra flag, so the bridge script + data-designer-path
// attributes only ever activate alongside a valid preview token — never for
// a real visitor, regardless of URL tampering (a public request has no
// previewToken at all).
const designerEdit = Astro.url.searchParams.get("designerEdit") === "1" && Boolean(previewToken);

// i18n Phase 5 — every language's layout now lives on this SAME page row
// (page.translations), so switching language re-renders this same row
// under a `?lang=` query param, not a link to a different slug/row.
const { enabled: siteLanguages, showHeaderSwitcher } = await getLanguages(tenantHost);
const requestedLang = Astro.url.searchParams.get("lang");
const layout = resolvePageLayout(page, requestedLang);
const fonts = collectFonts(layout);
const pageLangLabel = (code: string | null) => siteLanguages.find((l) => l.code === code)?.label ?? code ?? "?";
const availableCodes = [page.language, ...Object.keys(page.translations)].filter((c): c is string => Boolean(c));
const langSwitcher =
  showHeaderSwitcher && availableCodes.length > 1
    ? {
        current: requestedLang ?? page.language,
        options: availableCodes.map((code) => ({
          code,
          label: pageLangLabel(code),
          href: code === page.language ? `/${page.slug}` : `/${page.slug}?lang=${encodeURIComponent(code)}`,
        })),
      }
    : null;
---
<BaseLayout title={page.title} ogImage={page.bannerImageUrl} theme={theme} fonts={fonts} designerEdit={designerEdit} langSwitcher={langSwitcher}>
  {layout.map((block, b) => {
    switch (block.type) {
      case "section":
        return (
          <SectionBlock
            {...(block.props ?? {})}
            pageGap={page.settings?.gap}
            designerEdit={designerEdit}
            blockIndex={b}
            tenantHost={tenantHost}
            requestedLang={requestedLang}
          />
        );
      case "hero":
        return <HeroBlock {...(block.props ?? {})} />;
      case "text":
        return <TextBlock {...(block.props ?? {})} />;
      case "image":
        return <ImageBlock {...(block.props ?? {})} />;
      default:
        return <GenericBlock type={block.type} props={block.props} />;
    }
  })}
</BaseLayout>
