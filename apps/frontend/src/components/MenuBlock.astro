---
import { getMenu, resolveMenuTree, type ResolvedMenuItem } from "../lib/api";
import { marginStyle, paddingStyle, elBorderShadowStyle, typoStyle, lengthValue, SPACE, cls } from "../lib/element-render";

interface Props {
  menuId: string;
  layout?: "horizontal" | "vertical";
  dropdownTrigger?: "hover" | "click";
  megaMenuWidth?: "contained" | "full-width";
  tenantHost: string;
  lang: string | null;
  // Margin/padding/border/shadow (base + per-breakpoint) were never applied
  // to this block at all — not just a bp gap, the desktop value itself was
  // silently dropped since this component never called marginStyle/
  // paddingStyle/elBorderShadowStyle. `p`/`bp`/`elId` let the caller
  // (SectionBlock.astro) hand over the same props/bp bag every other
  // element type already gets real box-model styling from.
  p?: Record<string, string>;
  bp?: Record<string, string>;
  elId?: string;
}
const { menuId, layout = "horizontal", dropdownTrigger = "hover", megaMenuWidth = "contained", tenantHost, lang, p = {}, bp, elId } = Astro.props;

const menu = await getMenu(tenantHost, menuId);
const items: ResolvedMenuItem[] = menu ? await resolveMenuTree(menu.items, lang, tenantHost) : [];

// Style tab (apps/admin's ELS.menu): typography straight on the nav, the rest
// as custom properties global.css's .ds-menu rules read, so the dropdowns and
// the mobile panel keep their own colors. Values are validated at write time
// (@ucms/element-schema: hex colors, lengths, enums).
const JUSTIFY: Record<string, string> = { center: "center", right: "flex-end" };
function menuStyle(mp: Record<string, string>): string {
  return [
    marginStyle(mp),
    paddingStyle(mp),
    elBorderShadowStyle(mp),
    typoStyle(mp),
    mp.bg ? `background:${mp.bg}` : null,
    mp.hoverColor ? `--ds-menu-hover:${mp.hoverColor}` : null,
    mp.accentColor ? `--ds-menu-accent:${mp.accentColor}` : null,
    mp.dropdownBg ? `--ds-menu-dd-bg:${mp.dropdownBg}` : null,
    mp.dropdownColor ? `--ds-menu-dd-color:${mp.dropdownColor}` : null,
    mp.gap ? `--ds-menu-gap:${lengthValue(mp.gap, SPACE, "1.5rem")}` : null,
    JUSTIFY[mp.align ?? ""] ? `--ds-menu-justify:${JUSTIFY[mp.align ?? ""]}` : null,
  ]
    .filter(Boolean)
    .join(";");
}
const boxStyle = menuStyle(p);
const fx = p.menuEffect && p.menuEffect !== "none" ? `ds-menu-fx-${p.menuEffect}` : undefined;

// The current page's item gets aria-current (and the effect, global.css).
// chrome-preview.astro has no page of its own, so its first item stands in
// there — otherwise a header's Live Edit could only show the effect on hover.
const here = Astro.url.pathname.replace(/\/+$/, "") || "/";
const previewFirst = here === "/chrome-preview";
function isCurrent(href: string | undefined, i: number): boolean {
  if (previewFirst) return i === 0;
  // "#" (a dropdown parent that only opens its submenu) would match every page.
  if (!href || href.startsWith("#")) return false;
  try {
    const u = new URL(href, Astro.url);
    return u.origin === Astro.url.origin && (u.pathname.replace(/\/+$/, "") || "/") === here;
  } catch {
    return false;
  }
}

const responsiveRules: string[] = [];
if (bp && Object.keys(bp).length > 0 && elId) {
  const prefix = (tier: "tablet" | "mobile") => `${tier}:`;
  for (const tier of ["tablet", "mobile"] as const) {
    if (!Object.keys(bp).some((k) => k.startsWith(prefix(tier)))) continue;
    const merged = { ...p };
    for (const [k, v] of Object.entries(bp)) {
      if (k.startsWith(prefix(tier))) merged[k.slice(prefix(tier).length)] = v;
    }
    const css = menuStyle(merged);
    if (!css) continue;
    const important = css.split(";").filter(Boolean).map((decl) => `${decl} !important`).join(";");
    const media = tier === "tablet" ? "(min-width:641px) and (max-width:1024px)" : "(max-width:640px)";
    responsiveRules.push(`@media ${media}{[data-vis="${elId}"] .ds-menu{${important}}}`);
  }
}
---

{items.length > 0 && (
  <nav class={cls("ds-menu", `ds-menu-${layout}`, fx)} data-trigger={dropdownTrigger} style={boxStyle || undefined}>
    <button class="ds-menu-toggle" type="button" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <ul class="ds-menu-list">
      {items.map((item, i) => (
        <li class={`ds-menu-item ${item.children ? "has-dropdown" : ""} ${item.megaMenu ? "has-mega" : ""}`}>
          <a href={item.href} target={item.target} aria-current={isCurrent(item.href, i) ? "page" : undefined}>
            {item.label}
            {(item.children || item.megaMenu) && (
              <svg class="ds-menu-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            )}
          </a>
          {item.children && (
            <ul class="ds-menu-dropdown">
              {item.children.map((child) => (
                <li><a href={child.href} target={child.target}>{child.label}</a></li>
              ))}
            </ul>
          )}
          {item.megaMenu && (
            <div class={`ds-mega-menu ds-mega-${megaMenuWidth}`}>
              {item.megaMenu.columns.map((col) => (
                <div class="ds-mega-column">
                  {col.heading && <p class="ds-mega-heading">{col.heading}</p>}
                  <ul>
                    {col.items.map((mi) => (
                      <li>
                        <a href={mi.href} target={mi.target}>
                          {mi.image && <img src={mi.image} alt="" />}
                          {mi.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          )}
        </li>
      ))}
    </ul>
  </nav>
)}
{responsiveRules.length > 0 && <style set:html={responsiveRules.join("")} />}

<script>
  // One listener per rendered ds-menu, event-delegated — matches this
  // codebase's existing "tabs" element convention of a single small script
  // bundled once per page regardless of instance count. Handles two
  // concerns: click-to-toggle dropdowns/mega-menus when dropdownTrigger is
  // "click" (desktop, no hover), and the mobile hamburger toggle (all
  // triggers, since touch has no hover at all).
  document.querySelectorAll<HTMLElement>(".ds-menu").forEach((nav) => {
    const toggle = nav.querySelector<HTMLButtonElement>(".ds-menu-toggle");
    const list = nav.querySelector<HTMLUListElement>(".ds-menu-list");
    toggle?.addEventListener("click", () => {
      const open = nav.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", String(open));
    });
    if (nav.dataset.trigger === "click") {
      nav.querySelectorAll<HTMLElement>(".has-dropdown > a, .has-mega > a").forEach((link) => {
        link.addEventListener("click", (e) => {
          const li = link.closest("li");
          if (!li) return;
          const isOpenAlready = li.classList.contains("is-open-click");
          nav.querySelectorAll("li.is-open-click").forEach((el) => el.classList.remove("is-open-click"));
          if (!isOpenAlready) {
            e.preventDefault();
            li.classList.add("is-open-click");
          }
        });
      });
    }
    list?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => nav.classList.remove("is-open")));
  });
</script>
