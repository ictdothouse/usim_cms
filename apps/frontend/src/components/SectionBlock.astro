                      count={p.count}
                      columns={p.columns}
                      postLayout={p.postLayout as "grid" | "list" | undefined}
                      tenantHost={tenantHost}
                      lang={requestedLang}
                    />
                  );
                case "eventlist":
                  return (
                    <EventListBlock
                      count={p.count}
                      columns={p.columns}
                      eventLayout={p.eventLayout as "grid" | "list" | undefined}
                      tenantHost={tenantHost}
                    />
