---
// Renders a Web Designer `section` block (see apps/admin/src/Designer.tsx for
// the model + the matching canvas preview). Pure HTML + scoped CSS for every
// element except tabs/slider, which need a small vanilla-JS listener (see
// the <script> at the bottom) — accordion stays zero-JS via native
// <details>/<summary>.
import MenuBlock from "./MenuBlock.astro";
import SymbolBlock from "./SymbolBlock.astro";
import PostListBlock from "./PostListBlock.astro";
import EventListBlock from "./EventListBlock.astro";
import ContainerBlock from "./ContainerBlock.astro";
import SliderBlock from "./SliderBlock.astro";
import RepeaterBlock from "./RepeaterBlock.astro";
import MiscBlock from "./MiscBlock.astro";
import ElementBlock from "./ElementBlock.astro";
// Render helpers used to live here as `export`ed frontmatter bindings
// (SymbolBlock.astro importing straight from this .astro file) — moved to a
// plain .ts module after that broke prod: Astro's SSR chunk-splitting
// dropped RADIUS (a module-scope const only elRadius closed over), throwing
// "RADIUS is not defined" for every page. See lib/element-render.ts's own
// comment.
import {
  PAD,
  RADIUS,
  BORDER,
  shadowToCss,
  safeUrl,
  lengthValue,
  cls,
  typoStyle,
} from "../lib/element-render";

interface El {
  id?: string;
  type: string;
  props?: Record<string, string>;
  bp?: Record<string, string>;
  // Recursive container's own children (see apps/admin's designer/types.ts
  // El.children) — only ever set/read when type==="container".
  children?: El[];
}
interface Col {
  span?: number;
  elements?: El[];
  props?: Record<string, string>;
  bp?: Record<string, string>;
}
interface Row {
  columns?: Col[];
  gap?: string;
  marginTop?: string;
  marginBottom?: string;
  paddingTop?: string;
  paddingRight?: string;
  paddingBottom?: string;
  paddingLeft?: string;
  hideDesktop?: string;
  hideTablet?: string;
  hideMobile?: string;
  // Mirrors apps/admin/src/designer/types.ts's own Row.layoutMode/etc — kept
  // as a separate local interface here like the rest of this file's types
  // (no shared schema package between admin/frontend for these), so this
  // list must be kept in sync with admin's Row by hand.
  layoutMode?: "grid" | "flex";
  flexDirection?: "row" | "column" | "row-reverse" | "column-reverse";
  justifyContent?: "flex-start" | "center" | "flex-end" | "space-between" | "space-around";
  alignItems?: "flex-start" | "center" | "flex-end" | "stretch";
  flexWrap?: "nowrap" | "wrap";
  bp?: Record<string, string>;
}
interface Props {
  bg?: string;
  bgImage?: string;
  textColor?: string;
  paddingY?: string;
  paddingX?: string;
  paddingTop?: string;
  paddingRight?: string;
  paddingBottom?: string;
  paddingLeft?: string;
  marginY?: string;
  marginX?: string;
  marginTop?: string;
  marginBottom?: string;
  marginLeft?: string;
  marginRight?: string;
  width?: string;
  border?: string;
  borderWidth?: string;
  borderColor?: string;
  borderStyle?: string;
  opacity?: string;
  shadow?: string;
  radius?: string;
  radiusTopLeft?: string;
  radiusTopRight?: string;
  radiusBottomRight?: string;
  radiusBottomLeft?: string;
  anchorId?: string;
  cssClass?: string;
  rows?: Row[];
  bp?: Record<string, string>;
  hideDesktop?: string;
  hideTablet?: string;
  hideMobile?: string;
  // Live-edit bridge (Designer.tsx "live view"): when set, every section/
  // column/element wrapper gets a data-designer-path so the admin iframe's
  // bridge script can map a click back to a [b,r,c,e] selection. blockIndex
  // is this section's own position in the page's top-level layout array
  // (apps/frontend/src/pages/[...slug].astro passes it). Never set for a
  // real visitor — see [...slug].astro's designerEdit gate (requires a
  // valid preview token).
  designerEdit?: boolean;
  blockIndex?: number;
  // Page-wide default column gap ([...slug].astro's page.settings.gap) — a
  // row's own `gap` (Row.gap, set in Designer.tsx) always wins over this.
  pageGap?: string;
  // Same page-wide-default convention as pageGap, for this section's own
  // width/paddingX — a section that sets its own `width`/`paddingX` always
  // wins over these.
  pageContentWidth?: string;
  pagePaddingX?: string;
  // Threaded through for the "menu" element case below (MenuBlock needs both
  // to fetch/resolve the right tenant's menu in the requested language) — a
  // menu element is never nested any deeper than column.elements, all within
  // this SAME component's own template scope (rows/columns/elements are
  // plain nested array maps here, not recursive SectionBlock instances), so
  // these two just need to be in scope once at the top, not re-passed at
  // each nesting level.
  tenantHost?: string;
  requestedLang?: string | null;
}
const {
  bg,
  bgImage,
  textColor,
  paddingY = "md",
  paddingX,
  paddingTop,
  paddingRight,
  paddingBottom,
  paddingLeft,
  marginY,
  marginX,
  marginTop,
  marginBottom,
  marginLeft,
  marginRight,
  width,
  border,
  borderWidth,
  borderColor,
  borderStyle,
  opacity,
  shadow,
  radius,
  radiusTopLeft,
  radiusTopRight,
  radiusBottomRight,
  radiusBottomLeft,
  anchorId,
  cssClass,
  rows = [],
  bp: sectionBp,
  designerEdit = false,
  blockIndex = 0,
  pageGap,
  pageContentWidth,
  pagePaddingX,
  hideDesktop,
  hideTablet,
  hideMobile,
  tenantHost = "",
  requestedLang = null,
} = Astro.props;

const SLIDER_HEIGHT: Record<string, string> = { sm: "24rem", md: "32rem", lg: "42rem", full: "100vh" };
// Real per-breakpoint visibility (Designer.tsx's VisibilityToggle) AND, for
// Section/Column, real per-breakpoint style overrides (Designer.tsx's `bp`
// bag — Row/Element still admin-preview-only there for now, see CLAUDE.md).
// Both need actual scoped @media rules on the published site, not inline
// `style=""` (which can't contain @media and, being inline, would outrank
// any external rule anyway — hence every declaration here gets `!important`
// too). `responsiveRules` collects one entry per node (Section/Row/Column/
// Element) that needs either, each scoped to that node's own `data-vis`
// attribute value — flushed into a single <style> at the end of this
// section's render. Cutoffs (tablet 641-1024px, mobile ≤640px) are real CSS
// breakpoints here, independent of Designer.tsx's own BP_REFERENCE_PX (canvas
// simulation reference widths, a different concern) and of Row's own
// pre-existing @media (max-width:768px) column-stacking rule below.
const responsiveRules: string[] = [];
// bp overrides are keyed "tablet:<fieldKey>"/"mobile:<fieldKey>" (same
// format as Designer.tsx's El.bp/Col.bp/SectionProps.bp) — merge the
// matching tier's overrides onto a copy of the node's own base props so
// `build()` (whatever function normally turns props into that node's style
// string) can be re-run for that breakpoint exactly as it ran for desktop.
function bpMerge(base: Record<string, string>, bp: Record<string, string>, tier: "tablet" | "mobile"): Record<string, string> {
  const prefix = `${tier}:`;
  const merged = { ...base };
  for (const [k, v] of Object.entries(bp)) {
    if (k.startsWith(prefix)) merged[k.slice(prefix.length)] = v;
  }
  return merged;
}
// Re-runs `build()` for each tier that actually has an override, appends
// `!important` to every declaration (needed to beat the node's own inline
// `style=""`, which otherwise always outranks an external stylesheet rule
// regardless of media-query specificity), and scopes it to `selector`.
function bpStyleRules(selector: string, bp: Record<string, string>, base: Record<string, string>, build: (p: Record<string, string>) => string): string[] {
  const out: string[] = [];
  for (const tier of ["tablet", "mobile"] as const) {
    if (!Object.keys(bp).some((k) => k.startsWith(`${tier}:`))) continue;
    const css = build(bpMerge(base, bp, tier));
    if (!css) continue;
    const important = css
      .split(";")
      .filter(Boolean)
      .map((decl) => `${decl} !important`)
      .join(";");
    const media = tier === "tablet" ? "(min-width:641px) and (max-width:1024px)" : "(max-width:640px)";
    out.push(`@media ${media}{${selector}{${important}}}`);
  }
  return out;
}
// Assigns a stable `data-vis` id to a node only when it actually needs one
// (a real hide flag, or a tablet/mobile style override) — cheap common case
// (no markup added) stays untouched. `bp`/`base`/`build` are omitted for
// node kinds that don't support real style overrides yet (Row, Element —
// see the CLAUDE.md note on this feature), leaving visibility as their only
// responsive concern.
function respId(
  id: string,
  visProps: { hideDesktop?: string; hideTablet?: string; hideMobile?: string },
  bp?: Record<string, string>,
  base?: Record<string, string>,
  build?: (p: Record<string, string>) => string,
): string | undefined {
  const hasVis = visProps.hideDesktop === "true" || visProps.hideTablet === "true" || visProps.hideMobile === "true";
  const hasBp = !!bp && Object.keys(bp).length > 0 && !!base && !!build;
  if (!hasVis && !hasBp) return undefined;
  const selector = `[data-vis="${id}"]`;
  if (visProps.hideDesktop === "true") responsiveRules.push(`@media (min-width:1025px){${selector}{display:none!important}}`);
  if (visProps.hideTablet === "true") responsiveRules.push(`@media (min-width:641px) and (max-width:1024px){${selector}{display:none!important}}`);
  if (visProps.hideMobile === "true") responsiveRules.push(`@media (max-width:640px){${selector}{display:none!important}}`);
  if (hasBp) responsiveRules.push(...bpStyleRules(selector, bp!, base!, build!));
  return id;
}
// Element props are author-controlled but URLs still get a scheme check so a
// stored value can never become a javascript:/data: link or iframe source.
// http(s)/root-relative/anchor/bare-relative (e.g. "#contact", "about") are
// all fine — only a URI scheme other than http(s) (javascript:, data:, ...)
// gets stripped.
// bgImage/slider slide images are concatenated into a raw url(...) CSS
// function, not bound through a safe attribute — safeUrl()'s scheme check
// alone isn't enough here, a stray quote/semicolon/paren/brace could still
// break out of that one declaration (apps/api's validate-layout.ts already
// rejects these at write time; this is defense-in-depth for any row written
// before that check existed — same reasoning as HeroBlock.astro's
// safeImageUrl).
const safeCssUrl = (u?: string) => {
  const v = safeUrl(u);
  return v && !/['";(){}\s]/.test(v) ? v : undefined;
};

// Column-level style escape hatch (Col.props) — mirrors Designer.tsx's
// colStyle(), turning a column into a themeable "card" wrapping whatever
// elements are dropped into it.
function colStyle(cp?: Record<string, string>) {
  if (!cp) return undefined;
  const anyPadding = cp.padding || cp.paddingTop || cp.paddingRight || cp.paddingBottom || cp.paddingLeft;
  const padSide = (per: string) => lengthValue(cp[per] || cp.padding, PAD, "0");
  const anyRadius = cp.radius || cp.radiusTopLeft || cp.radiusTopRight || cp.radiusBottomRight || cp.radiusBottomLeft;
  const radCorner = (per: string) => lengthValue(cp[per] || cp.radius, RADIUS, RADIUS.none);
  return [
    cp.bg ? `background:${cp.bg}` : null,
    anyPadding ? `padding:${padSide("paddingTop")} ${padSide("paddingRight")} ${padSide("paddingBottom")} ${padSide("paddingLeft")}` : null,
    cp.marginY || cp.marginX || cp.marginTop || cp.marginRight || cp.marginBottom || cp.marginLeft
      ? `margin:${lengthValue(cp.marginTop || cp.marginY, PAD, "0")} ${lengthValue(cp.marginRight || cp.marginX, PAD, "0")} ${lengthValue(cp.marginBottom || cp.marginY, PAD, "0")} ${lengthValue(cp.marginLeft || cp.marginX, PAD, "0")}`
      : null,
    cp.valign ? `align-self:${cp.valign === "top" ? "start" : cp.valign === "bottom" ? "end" : "center"}` : null,
    cp.border ? `border:${BORDER[cp.border]}` : null,
    shadowToCss(cp.shadow) ? `box-shadow:${shadowToCss(cp.shadow)}` : null,
    anyRadius ? `border-radius:${radCorner("radiusTopLeft")} ${radCorner("radiusTopRight")} ${radCorner("radiusBottomRight")} ${radCorner("radiusBottomLeft")}` : null,
  ]
    .filter(Boolean)
    .join(";");
}

// Element radius (image/embed/gallery): per-corner freedom, same fallback-
// chain convention as colStyle()/sectionStyle above, and the same
// RADIUS.none fallback — no element gets a rounded corner unless the
// author explicitly sets one.
// Extracted to a plain function of `p` (rather than reading the
// destructured Props consts directly) so bp-override rendering (below) can
// re-run the exact same logic against a tablet/mobile-merged props copy —
// `sectionStyle` itself is just this called once against the real desktop
// props.
function buildSectionStyle(p: Record<string, string>): string {
  // Per-side padding / per-corner radius — freedom to set Top/Right/Bottom/
  // Left (or each corner) independently from the admin's FourSideControl;
  // unset falls back to the shared axis (paddingY/paddingX) or single radius
  // preset, same fallback-chain convention Designer.tsx's fourSideValue() uses.
  const padTop = lengthValue(p.paddingTop || p.paddingY, PAD, PAD.md);
  const padRight = lengthValue(p.paddingRight || p.paddingX || pagePaddingX, PAD, "1.5rem");
  const padBottom = lengthValue(p.paddingBottom || p.paddingY, PAD, PAD.md);
  const padLeft = lengthValue(p.paddingLeft || p.paddingX || pagePaddingX, PAD, "1.5rem");
  // Margin has no X axis (block-flow spacing only) — top/bottom, each falling
  // back to the shared marginY value, same convention as padding above.
  const marginTopVal = lengthValue(p.marginTop || p.marginY, PAD, "0");
  const marginRightVal = lengthValue(p.marginRight || p.marginX, PAD, "0");
  const marginBottomVal = lengthValue(p.marginBottom || p.marginY, PAD, "0");
  const marginLeftVal = lengthValue(p.marginLeft || p.marginX, PAD, "0");
  const radTopLeft = lengthValue(p.radiusTopLeft || p.radius, RADIUS, RADIUS.none);
  const radTopRight = lengthValue(p.radiusTopRight || p.radius, RADIUS, RADIUS.none);
  const radBottomRight = lengthValue(p.radiusBottomRight || p.radius, RADIUS, RADIUS.none);
  const radBottomLeft = lengthValue(p.radiusBottomLeft || p.radius, RADIUS, RADIUS.none);
  return [
    p.bgImage && safeCssUrl(p.bgImage) ? `background:url('${safeCssUrl(p.bgImage)}') center/cover no-repeat` : p.bg ? `background:${p.bg}` : null,
    p.textColor ? `color:${p.textColor}` : null,
    `padding:${padTop} ${padRight} ${padBottom} ${padLeft}`,
    `margin:${marginTopVal} ${marginRightVal} ${marginBottomVal} ${marginLeftVal}`,
    // Only override border/shadow when the author actually picked a value —
    // otherwise every existing section would flatten to square/shadowless
    // corners instead of its current default look. Radius always applies
    // (falls back to RADIUS.none = 0, same visual result as unset).
    // borderWidth set = real stroke fields win, mirrors Designer.tsx's
    // sectionBpStyle(); otherwise fall back to the legacy preset so old pages
    // saved before this field existed don't move.
    p.borderWidth ? `border:${p.borderWidth}px ${p.borderStyle || "solid"} ${p.borderColor || "currentColor"}` : p.border ? `border:${BORDER[p.border]}` : null,
    shadowToCss(p.shadow) ? `box-shadow:${shadowToCss(p.shadow)}` : null,
    `border-radius:${radTopLeft} ${radTopRight} ${radBottomRight} ${radBottomLeft}`,
    p.opacity ? `opacity:${Math.max(0, Math.min(100, Number(p.opacity))) / 100}` : null,
  ]
    .filter(Boolean)
    .join(";");
}
const baseSectionProps: Record<string, string> = {
  bg: bg ?? "",
  bgImage: bgImage ?? "",
  textColor: textColor ?? "",
  paddingY: paddingY ?? "",
  paddingX: paddingX ?? "",
  paddingTop: paddingTop ?? "",
  paddingRight: paddingRight ?? "",
  paddingBottom: paddingBottom ?? "",
  paddingLeft: paddingLeft ?? "",
  marginY: marginY ?? "",
  marginX: marginX ?? "",
  marginTop: marginTop ?? "",
  marginRight: marginRight ?? "",
  marginBottom: marginBottom ?? "",
  marginLeft: marginLeft ?? "",
  border: border ?? "",
  borderWidth: borderWidth ?? "",
  borderColor: borderColor ?? "",
  borderStyle: borderStyle ?? "",
  opacity: opacity ?? "",
  shadow: shadow ?? "",
  radius: radius ?? "",
  radiusTopLeft: radiusTopLeft ?? "",
  radiusTopRight: radiusTopRight ?? "",
  radiusBottomRight: radiusBottomRight ?? "",
  radiusBottomLeft: radiusBottomLeft ?? "",
};
const sectionStyle = buildSectionStyle(baseSectionProps);

// marginTop's default (2.5rem, matching the old fixed .ds-inner flex gap)
// is skipped for the first row — that layout never had a leading gap either.
const rowStyle = (row: Row, isFirst: boolean) => {
  const pad =
    row.paddingTop || row.paddingRight || row.paddingBottom || row.paddingLeft
      ? `padding:${row.paddingTop ?? "0"} ${row.paddingRight ?? "0"} ${row.paddingBottom ?? "0"} ${row.paddingLeft ?? "0"};`
      : "";
  // Elementor-style flex container mode — unset/"grid" keeps the exact same
  // grid-template-columns output this function always emitted (no visual
  // change for any row saved before this existed). "flex" mode's own mobile
  // stacking (and any per-breakpoint override) is handled by the real
  // bpStyleRules() output pushed from the row's own render below
  // (rowFlexBp/rowFlexBase/buildRowOverride), not by anything computed here.
  const layout =
    row.layoutMode === "flex"
      ? `display:flex;flex-direction:${row.flexDirection ?? "row"};justify-content:${row.justifyContent ?? "flex-start"};align-items:${row.alignItems ?? "stretch"};flex-wrap:${row.flexWrap ?? "wrap"}`
      : `grid-template-columns:${(row.columns ?? []).map((c) => `${c.span ?? 1}fr`).join(" ")}`;
  return `${layout};gap:${row.gap ?? pageGap ?? "2rem"};margin-top:${row.marginTop ?? (isFirst ? "0" : "2.5rem")};margin-bottom:${row.marginBottom ?? "0"};${pad}`;
};
// Column width (Col.span) is edited per-breakpoint in the Inspector (col.bp's
// "tablet:span"/"mobile:span"), same bag every other Col/El style override
// uses — but the value actually drives the PARENT row's own
// grid-template-columns, not the column's own style, so it can't flow
// through the per-column respId() call below like padding/radius do.
// Flatten every column's span override into one synthetic flat bag keyed
// "tablet:span0"/"mobile:span1"/... (one key per column index) so it can
// reuse bpMerge/bpStyleRules unchanged, same as every other bp-driven style
// on this page. Kept as frontmatter functions (not inline template consts) —
// typed local declarations inside the markup section trip up Astro's
// TSX-like template parser (`Record<string, string>` reads as an ambiguous
// JSX tag start there).
function rowSpanBp(row: Row): Record<string, string> {
  const out: Record<string, string> = {};
  (row.columns ?? []).forEach((col, i) => {
    for (const [k, v] of Object.entries(col.bp ?? {})) {
      const sep = k.indexOf(":");
      if (sep !== -1 && k.slice(sep + 1) === "span") out[`${k.slice(0, sep)}:span${i}`] = v;
    }
  });
  return out;
}
function rowSpanBase(row: Row): Record<string, string> {
  const out: Record<string, string> = {};
  (row.columns ?? []).forEach((col, i) => {
    out[`span${i}`] = String(col.span ?? 1);
  });
  return out;
}
function buildRowSpans(row: Row, p: Record<string, string>): string {
  return `grid-template-columns:${(row.columns ?? []).map((_, i) => `${p[`span${i}`] ?? "1"}fr`).join(" ")}`;
}
// Flex mode's own per-bp direction override, merged onto the same bag as the
// column-span override above so one respId()/data-vis id covers both. Mobile
// always gets a synthetic default of "column" (the old hardcoded stack, see
// the removed `.ds-row[data-layout="flex"]` media rule below) unless the
// row's own `bp` explicitly overrides it — real, not admin-preview-only.
function rowFlexBp(row: Row): Record<string, string> {
  const out = rowSpanBp(row);
  if (row.layoutMode === "flex") {
    out["mobile:flexDirection"] = row.bp?.["mobile:flexDirection"] ?? "column";
    if (row.bp?.["tablet:flexDirection"] !== undefined) out["tablet:flexDirection"] = row.bp["tablet:flexDirection"];
  }
  return out;
}
function rowFlexBase(row: Row): Record<string, string> {
  return { ...rowSpanBase(row), flexDirection: row.flexDirection ?? "row" };
}
function buildRowOverride(row: Row, p: Record<string, string>): string {
  if (row.layoutMode === "flex") return `flex-direction:${p.flexDirection}`;
  return buildRowSpans(row, p);
}
---

<section
  class={cls("ds-section", cssClass)}
  id={anchorId || undefined}
  style={sectionStyle}
  data-designer-path={designerEdit ? String(blockIndex) : undefined}
  data-vis={respId(`s${blockIndex}`, { hideDesktop, hideTablet, hideMobile }, sectionBp, baseSectionProps, buildSectionStyle)}
>
  <div class={(width ?? pageContentWidth) === "full" ? "ds-inner ds-full" : "ds-inner"}>
    {rows.map((row, r) => {
      const rowVisId = respId(`r${blockIndex}-${r}`, row, rowFlexBp(row), rowFlexBase(row), (p) => buildRowOverride(row, p));
      // Flex mode's mobile/tablet stack needs each column's own flex-basis
      // reset too (same override the old hardcoded `.ds-row[data-layout=
      // "flex"] > .ds-col` media rule always applied) — a separate rule since
      // it targets a different selector (the columns, not the row itself),
      // scoped to whichever tier's resolved direction actually stacks.
      if (row.layoutMode === "flex" && rowVisId) {
        responsiveRules.push(
          ...bpStyleRules(`[data-vis="${rowVisId}"] > .ds-col`, rowFlexBp(row), rowFlexBase(row), (p) =>
            (p.flexDirection ?? "").startsWith("column") ? "flex:1 1 100%" : "",
          ),
        );
      }
      return (
      <div
        class="ds-row"
        data-layout={row.layoutMode === "flex" ? "flex" : undefined}
        style={rowStyle(row, r === 0)}
        data-vis={rowVisId}
      >
        {(row.columns ?? []).map((col, c) => (
          <div
            class={cls("ds-col", col.props?.cssClass)}
            style={`${colStyle(col.props) ?? ""}${row.layoutMode === "flex" ? `;flex:${col.span ?? 1} 1 0%;min-width:0` : ""}`}
            data-designer-path={designerEdit ? `${blockIndex}.${r}.${c}` : undefined}
            data-vis={respId(`c${blockIndex}-${r}-${c}`, col.props ?? {}, col.bp, col.props ?? {}, (p) => colStyle(p) ?? "")}
          >
            {(col.elements ?? []).map((el, e) => {
              const p = el.props ?? {};
              // Hoisted above `node` (rather than its original spot right
              // after it) so the "slider" case's renderSlideEl can scope a
              // nested element's own real per-breakpoint CSS to
              // `[data-vis="${elId}"] [data-slide-el="..."]` — same id, just
              // needed one statement earlier than the imgWidth/height bp
              // checks below still are.
              const elId = `e${blockIndex}-${r}-${c}-${e}`;
              const node = (() => {
              switch (el.type) {
                // Core single-element cases (heading/text/image/video/
                // button/badge/spacer/divider/embed/icon/list/html/gallery)
                // — extracted to ElementBlock.astro (god-file breakup); see
                // that file's own comment for why its local helpers
                // (RATIO/ICON_SIZE/buildSrcset) are duplicated there rather
                // than imported from here or promoted into
                // lib/element-render.ts.
                case "heading":
                case "text":
                case "image":
                case "video":
                case "button":
                case "badge":
                case "spacer":
                case "divider":
                case "embed":
                case "icon":
                case "list":
                case "html":
                case "gallery":
                  return <ElementBlock el={el} blockIndex={blockIndex} r={r} c={c} e={e} />;
                // accordion — extracted to MiscBlock.astro (god-file
                // breakup); see that file's own comment for why its
                // local helpers are duplicated there rather than imported
                // from here or promoted into lib/element-render.ts.
                case "accordion":
                  return <MiscBlock el={el} blockIndex={blockIndex} r={r} c={c} e={e} />;
                case "infobox":
                case "tabs":
                  return <MiscBlock el={el} blockIndex={blockIndex} r={r} c={c} e={e} />;
                case "slider":
                  return <SliderBlock el={el} designerEdit={designerEdit} elId={elId} responsiveRules={responsiveRules} />;
                case "menu":
                  return (
                    <MenuBlock
                      menuId={p.menuId ?? ""}
                      layout={p.layout as "horizontal" | "vertical" | undefined}
                      dropdownTrigger={p.dropdownTrigger as "hover" | "click" | undefined}
                      megaMenuWidth={p.megaMenuWidth as "contained" | "full-width" | undefined}
                      tenantHost={tenantHost}
                      lang={requestedLang}
                    />
                  );
                case "symbol":
                  return <SymbolBlock symbolId={p.symbolId ?? ""} tenantHost={tenantHost} />;
                case "cardgrid":
                case "ctabanner":
                case "announcementbar":
                  return <MiscBlock el={el} blockIndex={blockIndex} r={r} c={c} e={e} />;
                case "postlist":
                  return (
                    <PostListBlock
                      categoryId={p.categoryId ?? ""}
                      count={p.count}
                      columns={p.columns}
                      postLayout={p.postLayout as "grid" | "list" | undefined}
                      tenantHost={tenantHost}
                      lang={requestedLang}
                    />
                  );
                case "eventlist":
                  return (
                    <EventListBlock
                      count={p.count}
                      columns={p.columns}
                      eventLayout={p.eventLayout as "grid" | "list" | undefined}
                      tenantHost={tenantHost}
                    />
                  );
                // Batch of simple no-backend elements — extracted to
                // RepeaterBlock.astro (god-file breakup); see that file's
                // own comment for why its two SectionBlock-local helpers
                // (buildSrcset/parseRepeaterItems) are duplicated there
                // rather than imported from here or promoted into
                // lib/element-render.ts.
                case "testimonial":
                case "statscounter":
                case "peoplegrid":
                case "socialicons":
                case "logocloud":
                case "timeline":
                case "documentdownload":
                  return <RepeaterBlock el={el} />;
                // requireConsent gates the iframe behind a click-to-load
                // placeholder (audit report 5.3: consent/cookie policy) — no
                // cookie/localStorage, reappears on reload, same convention
                // as announcementbar's own dismiss. address always renders
                // so the map is never the page's only location info.
                case "googlemap":
                  return <MiscBlock el={el} blockIndex={blockIndex} r={r} c={c} e={e} />;
                case "announcementticker":
                  return <RepeaterBlock el={el} />;
                // Recursive container render branch — extracted to
                // ContainerBlock.astro (god-file breakup); see that file's
                // own comment for why its two SectionBlock-local helpers
                // (buildSrcset/ICON_SIZE) are duplicated there rather than
                // imported from here or promoted into lib/element-render.ts.
                case "container":
                  return <ContainerBlock el={el} blockIndex={blockIndex} r={r} c={c} e={e} designerEdit={designerEdit} />;
                default:
                  return null;
              }
              })();
              // Image's own real per-breakpoint width override — same "tablet:
              // imgWidth"/"mobile:imgWidth" bag every other bp override uses,
              // but pushed with a custom "... img" selector (not the plain
              // respId() below) since this wrapper renders `display:contents`
              // and can't itself carry a width.
              const hasWidthBp = el.type === "image" && !!el.bp && Object.keys(el.bp).some((k) => k.endsWith(":imgWidth"));
              if (hasWidthBp) {
                responsiveRules.push(...bpStyleRules(`[data-vis="${elId}"] img`, el.bp!, p, (mp) => (mp.imgWidth ? `width:${mp.imgWidth}` : "")));
              }
              // Slider's own real per-breakpoint height override — same
              // idea as imgWidth above: the actual `.ds-slider` node is a
              // child of this `display:contents` wrapper, not the wrapper
              // itself, so the override needs a nested selector rather than
              // the plain respId() below (which only ever targets the
              // wrapper). This is the first Element-level field made real
              // (not just admin-canvas-preview) rather than generalizing
              // Element's whole `bp` bag — see the design doc's Slider
              // height section for why just this one key.
              const hasHeightBp = el.type === "slider" && !!el.bp && Object.keys(el.bp).some((k) => k.endsWith(":height"));
              if (hasHeightBp) {
                responsiveRules.push(
                  ...bpStyleRules(`[data-vis="${elId}"] .ds-slider`, el.bp!, p, (mp) => `height:${lengthValue(mp.height, SLIDER_HEIGHT, SLIDER_HEIGHT.md)}`),
                );
              }
              // Heading/text's own real per-breakpoint typography override
              // (fontSize/lineHeight/letterSpacing/wordSpacing/fontWeight/
              // fontFamily/textTransform/fontStyle/textDecoration) — same
              // bpStyleRules mechanism as imgWidth/slider-height above,
              // reusing typoStyle() itself as build() so every
              // TYPOGRAPHY_FIELDS key gets real bp support at once instead of
              // one-off per-field wiring. Previously admin-canvas-preview-only
              // (see this file's CLAUDE.md note) — a tablet/mobile-only font
              // size set in the Inspector saved and previewed correctly but
              // never rendered on the real published/Live-Edit page, which
              // silently stayed at the desktop value.
              const hasTypoBp = (el.type === "heading" || el.type === "text") && !!el.bp && Object.keys(el.bp).length > 0;
              if (hasTypoBp) {
                const typoSelector = el.type === "heading" ? `[data-vis="${elId}"] .ds-h` : `[data-vis="${elId}"] .ds-text`;
                responsiveRules.push(...bpStyleRules(typoSelector, el.bp!, p, typoStyle));
              }
              // Slider's wrapper always gets a data-vis id now (rather than
              // only when a nested slide element actually has a bp override)
              // — SliderBlock.astro is a separate render pass, so it can no
              // longer report that signal back synchronously; a harmless
              // always-present attribute on a `display:contents` wrapper,
              // not a visible behavior change.
              const elVisId = respId(elId, p) ?? (hasWidthBp || hasHeightBp || hasTypoBp || el.type === "slider" ? elId : undefined);
              return designerEdit || elVisId ? (
                <div
                  data-designer-path={designerEdit ? `${blockIndex}.${r}.${c}.${e}` : undefined}
                  data-vis={elVisId}
                  style="display:contents"
                >
                  {node}
                </div>
              ) : (
                node
              );
            })}
          </div>
        ))}
      </div>
      );
    })}
  </div>
  {responsiveRules.length > 0 && <style set:html={responsiveRules.join("")} />}
</section>

