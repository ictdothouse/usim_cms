                    <div
                      class={cls("ds-ctabanner", p.cssClass)}
                      style={[
                        p.align ? `text-align:${p.align}` : null,
                        p.bgColor ? `background-color:${p.bgColor}` : null,
                        safeCssUrl(p.bgImage) ? `background-image:url('${safeCssUrl(p.bgImage)}');background-size:cover;background-position:center` : null,
                        marginStyle(p),
                        paddingStyle(p),
                      ]
                        .filter(Boolean)
                        .join(";")}
