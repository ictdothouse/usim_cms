---
// Renders a Web Designer `section` block (see apps/admin/src/Designer.tsx for
// the model + the matching canvas preview). Pure HTML + scoped CSS, zero JS.
interface El {
  id?: string;
  type: string;
  props?: Record<string, string>;
}
interface Col {
  span?: number;
  elements?: El[];
  props?: Record<string, string>;
}
interface Row {
  columns?: Col[];
}
interface Props {
  bg?: string;
  bgImage?: string;
  textColor?: string;
  paddingY?: string;
  paddingX?: string;
  paddingTop?: string;
  paddingRight?: string;
  paddingBottom?: string;
  paddingLeft?: string;
  marginY?: string;
  width?: string;
  border?: string;
  shadow?: string;
  radius?: string;
  radiusTopLeft?: string;
  radiusTopRight?: string;
  radiusBottomRight?: string;
  radiusBottomLeft?: string;
  anchorId?: string;
  cssClass?: string;
  rows?: Row[];
  // Live-edit bridge (Designer.tsx "live view"): when set, every section/
  // column/element wrapper gets a data-designer-path so the admin iframe's
  // bridge script can map a click back to a [b,r,c,e] selection. blockIndex
  // is this section's own position in the page's top-level layout array
  // (apps/frontend/src/pages/[...slug].astro passes it). Never set for a
  // real visitor — see [...slug].astro's designerEdit gate (requires a
  // valid preview token).
  designerEdit?: boolean;
  blockIndex?: number;
}
const {
  bg,
  bgImage,
  textColor,
  paddingY = "md",
  paddingX,
  paddingTop,
  paddingRight,
  paddingBottom,
  paddingLeft,
  marginY,
  width = "contained",
  border,
  shadow,
  radius,
  radiusTopLeft,
  radiusTopRight,
  radiusBottomRight,
  radiusBottomLeft,
  anchorId,
  cssClass,
  rows = [],
  designerEdit = false,
  blockIndex = 0,
} = Astro.props;

const PAD: Record<string, string> = { none: "0", sm: "1.5rem", md: "3rem", lg: "5rem", xl: "7rem" };
const SPACE: Record<string, string> = { sm: "1rem", md: "2rem", lg: "4rem", xl: "6rem" };
const RADIUS: Record<string, string> = { none: "0", md: "0.75rem", xl: "1.5rem", full: "9999px" };
const TEXT_SIZE: Record<string, string> = { sm: "0.875rem", md: "1rem", lg: "1.2rem" };
const RATIO: Record<string, string> = { "16:9": "16 / 9", "4:3": "4 / 3", "1:1": "1 / 1" };
const BORDER: Record<string, string> = { none: "none", thin: "1px solid currentColor", thick: "3px solid currentColor" };
const SHADOW: Record<string, string> = {
  none: "none",
  sm: "0 1px 3px rgba(0,0,0,.1)",
