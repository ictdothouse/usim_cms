  import Autoplay from "embla-carousel-autoplay";

  // Tabs: click a label -> activate its panel. Event-delegated on document
  // so one listener covers every .ds-tabs instance on the page (Astro
  // bundles this <script> once per page regardless of how many SectionBlock
  // instances render), no per-instance re-init needed.
  document.addEventListener("click", (e) => {
    const label = (e.target as HTMLElement).closest(".ds-tabs-label") as HTMLElement | null;
    if (!label) return;
    const tabs = label.closest(".ds-tabs");
    if (!tabs) return;
    const idx = label.dataset.idx;
    tabs.querySelectorAll(".ds-tabs-label").forEach((el) => el.classList.remove("is-active"));
    tabs.querySelectorAll(".ds-tabs-panel").forEach((el) => el.classList.remove("is-active"));
    label.classList.add("is-active");
    tabs.querySelector(`.ds-tabs-panel[data-idx="${idx}"]`)?.classList.add("is-active");
  });

  // Announcement bar: dismiss button just hides the bar for this page view —
  // no cookie/localStorage persistence (reappears on reload), same
  // static-site-with-a-little-JS convention as tabs above.
  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest(".ds-announcementbar-close") as HTMLElement | null;
    if (!btn) return;
    btn.closest(".ds-announcementbar")?.remove();
  });

  // Google Map (requireConsent="true" only): the real embed src lives in a
  // data attribute, never in a live src, until this click — same "consent
  // gate, no cookie/localStorage" shape as the announcement bar's own
  // dismiss above, just gating a load instead of hiding a bar.
  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest(".ds-map-consent-btn") as HTMLElement | null;
    if (!btn) return;
    const holder = btn.closest<HTMLElement>(".ds-map-consent");
    const src = holder?.dataset.mapSrc;
    if (!holder || !src) return;
    const iframe = document.createElement("iframe");
    iframe.className = "ds-map-frame";
    iframe.src = src;
    iframe.loading = "lazy";
    iframe.referrerPolicy = "strict-origin-when-cross-origin";
    iframe.style.height = holder.style.height;
    holder.replaceWith(iframe);
  });

  // Slider: Embla Carousel (headless, vanilla JS — see package.json) drives
  // drag/swipe/momentum/looping; this just wires our own prev/next/dot
  // buttons + an optional autoplay plugin (data-autoplay = ms, set only when
  // the author picked something other than "off") to its API instead of
  // hand-rolling scroll math. .ds-slider-viewport/.ds-slider-track/.ds-slide
  // are exactly Embla's expected viewport > container > slide structure.
  document.querySelectorAll<HTMLElement>(".ds-slider").forEach((slider) => {
    const viewport = slider.querySelector<HTMLElement>(".ds-slider-viewport");
    const dots = Array.from(slider.querySelectorAll<HTMLElement>(".ds-slider-dot"));
    if (!viewport) return;
    const autoplayMs = Number(slider.dataset.autoplay || "0");

    // transition="fade": Embla's own scroll track assumes a horizontal
    // strip of slides, which can't crossfade — hand-roll index/opacity
    // instead of pulling in a separate fade plugin (CSS above stacks every
    // .ds-slide absolutely; this just toggles which one is opaque).
    if (slider.dataset.transition === "fade") {
      const slides = Array.from(slider.querySelectorAll<HTMLElement>(".ds-slide"));
      let idx = 0;
      const show = (next: number) => {
        idx = ((next % slides.length) + slides.length) % slides.length;
        slides.forEach((s, si) => s.classList.toggle("is-active-fade", si === idx));
        dots.forEach((d, di) => d.classList.toggle("is-active", di === idx));
      };
      slider.querySelector(".ds-slider-prev")?.addEventListener("click", () => show(idx - 1));
      slider.querySelector(".ds-slider-next")?.addEventListener("click", () => show(idx + 1));
      dots.forEach((d, di) => d.addEventListener("click", () => show(di)));
      show(0);
      if (autoplayMs > 0) setInterval(() => show(idx + 1), autoplayMs);
      return;
    }

    const plugins = autoplayMs > 0 ? [Autoplay({ delay: autoplayMs, stopOnInteraction: false })] : [];
    const embla = EmblaCarousel(viewport, { loop: true }, plugins);
    const updateDots = () => {
      const selected = embla.selectedScrollSnap();
      dots.forEach((d, di) => d.classList.toggle("is-active", di === selected));
    };
    slider.querySelector(".ds-slider-prev")?.addEventListener("click", () => embla.scrollPrev());
    slider.querySelector(".ds-slider-next")?.addEventListener("click", () => embla.scrollNext());
    dots.forEach((d, di) => d.addEventListener("click", () => embla.scrollTo(di)));
    embla.on("select", updateDots);
    updateDots();
  });
</script>
