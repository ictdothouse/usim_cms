                case "timeline": {
                  const items = parseRepeaterItems(p.timelineItems);
                  if (items.length === 0) return null;
                  return (
                    <div class={cls("ds-timeline", p.cssClass)}>
                      {items.map((it) => (
                        <div class="ds-timeline-item">
                          {it.date && <p class="ds-timeline-date">{it.date}</p>}
                          {it.title && <p class="ds-timeline-title">{it.title}</p>}
                          {it.description && <p class="ds-timeline-desc">{it.description}</p>}
                        </div>
                      ))}
                    </div>
                  );
                }
                case "documentdownload": {
                  const items = parseRepeaterItems(p.documents);
                  if (items.length === 0) return null;
                  return (
                    <div class={cls("ds-docdownload", p.cssClass)} style={`grid-template-columns:repeat(${p.columns ?? "2"},1fr)`}>
                      {items.map((it) => {
                        const href = it.fileUrl ? safeUrl(it.fileUrl) : undefined;
                        if (!href) return null;
                        return (
                          <a class="ds-doc-card" href={href} download>
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <path d={ICON_PATHS["file-text"]} />
                            </svg>
                            <span>
                              <span class="ds-doc-label">{it.label || "Document"}</span>
                              {(it.fileType || it.fileSize) && (
                                <span class="ds-doc-meta">{[it.fileType, it.fileSize].filter(Boolean).join(" · ")}</span>
                              )}
                            </span>
                          </a>
                        );
                      })}
                    </div>
                  );
                }
                // requireConsent gates the iframe behind a click-to-load
                // placeholder (audit report 5.3: consent/cookie policy) — no
                // cookie/localStorage, reappears on reload, same convention
                // as announcementbar's own dismiss. address always renders
                // so the map is never the page's only location info.
                case "googlemap": {
                  const embedUrl = p.embedUrl ? safeUrl(p.embedUrl) : undefined;
                  if (!embedUrl) return p.address ? <p class={cls("ds-map-address", p.cssClass)}>{p.address}</p> : null;
                  const height = lengthValue(p.height, {}, "24rem");
                  return (
                    <div class={cls("ds-map", p.cssClass)}>
                      {p.requireConsent === "true" ? (
                        <div class="ds-map-consent" style={`height:${height}`} data-map-src={embedUrl}>
                          <button type="button" class="ds-map-consent-btn">Load map</button>
                        </div>
                      ) : (
                        <iframe class="ds-map-frame" src={embedUrl} style={`height:${height}`} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" />
                      )}
                      {p.address && <p class="ds-map-address">{p.address}</p>}
                    </div>
                  );
                }
                case "announcementticker": {
                  const items = parseRepeaterItems(p.tickerItems);
                  if (items.length === 0) return null;
                  const speedS = { slow: 40, normal: 25, fast: 12 }[p.speed ?? "normal"] ?? 25;
                  return (
                    <div
                      class={cls("ds-ticker", p.cssClass)}
                      style={[`background:${p.bgColor || "#111827"}`, `color:${p.textColor || "#ffffff"}`].join(";")}
                    >
                      <div class="ds-ticker-track" style={`animation-duration:${speedS}s`}>
                        {[...items, ...items].map((it) =>
                          it.href && safeUrl(it.href) ? (
                            <a class="ds-ticker-item" href={safeUrl(it.href)}>{it.text}</a>
                          ) : (
                            <span class="ds-ticker-item">{it.text}</span>
                          ),
                        )}
                      </div>
                    </div>
                  );
                }
                // Recursive container render branch — extracted to
                // ContainerBlock.astro (god-file breakup); see that file's
                // own comment for why its two SectionBlock-local helpers
                // (buildSrcset/ICON_SIZE) are duplicated there rather than
                // imported from here or promoted into lib/element-render.ts.
                case "container":
                  return <ContainerBlock el={el} blockIndex={blockIndex} r={r} c={c} e={e} designerEdit={designerEdit} />;
                default:
                  return null;
              }
              })();
              // Image's own real per-breakpoint width override — same "tablet:
              // imgWidth"/"mobile:imgWidth" bag every other bp override uses,
              // but pushed with a custom "... img" selector (not the plain
              // respId() below) since this wrapper renders `display:contents`
              // and can't itself carry a width.
              const hasWidthBp = el.type === "image" && !!el.bp && Object.keys(el.bp).some((k) => k.endsWith(":imgWidth"));
              if (hasWidthBp) {
                responsiveRules.push(...bpStyleRules(`[data-vis="${elId}"] img`, el.bp!, p, (mp) => (mp.imgWidth ? `width:${mp.imgWidth}` : "")));
              }
              // Slider's own real per-breakpoint height override — same
              // idea as imgWidth above: the actual `.ds-slider` node is a
              // child of this `display:contents` wrapper, not the wrapper
              // itself, so the override needs a nested selector rather than
              // the plain respId() below (which only ever targets the
              // wrapper). This is the first Element-level field made real
              // (not just admin-canvas-preview) rather than generalizing
              // Element's whole `bp` bag — see the design doc's Slider
              // height section for why just this one key.
              const hasHeightBp = el.type === "slider" && !!el.bp && Object.keys(el.bp).some((k) => k.endsWith(":height"));
              if (hasHeightBp) {
                responsiveRules.push(
                  ...bpStyleRules(`[data-vis="${elId}"] .ds-slider`, el.bp!, p, (mp) => `height:${lengthValue(mp.height, SLIDER_HEIGHT, SLIDER_HEIGHT.md)}`),
                );
              }
              // Slider's wrapper always gets a data-vis id now (rather than
              // only when a nested slide element actually has a bp override)
              // — SliderBlock.astro is a separate render pass, so it can no
              // longer report that signal back synchronously; a harmless
              // always-present attribute on a `display:contents` wrapper,
              // not a visible behavior change.
              const elVisId = respId(elId, p) ?? (hasWidthBp || hasHeightBp || el.type === "slider" ? elId : undefined);
              return designerEdit || elVisId ? (
                <div
                  data-designer-path={designerEdit ? `${blockIndex}.${r}.${c}.${e}` : undefined}
                  data-vis={elVisId}
                  style="display:contents"
                >
                  {node}
                </div>
              ) : (
                node
              );
            })}
          </div>
        ))}
      </div>
      );
    })}
  </div>
  {responsiveRules.length > 0 && <style set:html={responsiveRules.join("")} />}
</section>

