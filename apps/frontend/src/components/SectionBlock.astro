// Element props are author-controlled but URLs still get a scheme check so a
// stored value can never become a javascript:/data: link or iframe source.
// http(s)/root-relative/anchor/bare-relative (e.g. "#contact", "about") are
// all fine — only a URI scheme other than http(s) (javascript:, data:, ...)
// gets stripped.
const safeUrl = (u?: string) => {
  // Browsers discard ASCII control/space chars (0x00-0x20) from anywhere in
  // a URL before parsing its scheme, not just the ends — a bare .trim()
  // left "java\tscript:alert(1)" able to slip past the scheme regex below
  // while still executing as javascript: once rendered. Stripping them from
  // the whole string (not just trimming) closes that, and also means the
  // href/src we actually emit can't still be smuggling one.
  const v = u?.replace(/[\x00-\x20]+/g, "");
  if (!v) return undefined;
  if (/^[a-z][a-z0-9+.-]*:/i.test(v)) return /^https?:/i.test(v) ? v : undefined;
  return v;
};
// bgImage/slider slide images are concatenated into a raw url(...) CSS
// function, not bound through a safe attribute — safeUrl()'s scheme check
// alone isn't enough here, a stray quote/semicolon/paren/brace could still
// break out of that one declaration (apps/api's validate-layout.ts already
// rejects these at write time; this is defense-in-depth for any row written
// before that check existed — same reasoning as HeroBlock.astro's
// safeImageUrl).
const safeCssUrl = (u?: string) => {
  const v = safeUrl(u);
  return v && !/['";(){}\s]/.test(v) ? v : undefined;
};

function escapeHtml(s: string) {
  const map: Record<string, string> = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" };
  return s.replace(/[&<>"']/g, (c) => map[c]);
}
// Small inline-markdown subset for heading/text: **bold**, *italic*,
// [label](url). Duplicated (not shared) from Designer.tsx's own
// renderInline — same convention as this file's PAD/RADIUS tables mirroring
// the admin canvas's copies; no shared package exists between the two apps.
// ponytail: link regex stops at the first ")" in the URL, so a raw
// unescaped "(" / ")" inside the URL itself truncates it — fine for normal
// links/anchors, encode the parens if it ever matters.
function renderInline(text: string): string {
  return escapeHtml(text)
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_m, label, url) => `<a href="${safeUrl(url) ?? "#"}">${label}</a>`)
    .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
    .replace(/\*([^*]+)\*/g, "<em>$1</em>");
}

// Resolves a spacing value that may be either a legacy preset keyword
// ("sm"/"md"/"lg"/"xl"/"none") or a real CSS length the author typed
// ("42px", "2.5rem") — existing pages keep their preset look, new edits get
// free-form units. Duplicated in Designer.tsx like every other shared table.
function lengthValue(v: string | undefined, table: Record<string, string>, fallback: string) {
  if (!v) return fallback;
  return table[v] ?? v;
}
// Every element accepts marginY/marginX, or independent per-side overrides
// (see Designer.tsx's Inspector) — same fallback convention as paddingStyle.
function marginStyle(p: Record<string, string>) {
  if (!p.marginY && !p.marginX && !p.marginTop && !p.marginRight && !p.marginBottom && !p.marginLeft) return null;
  const top = lengthValue(p.marginTop || p.marginY, SPACE, "0");
  const right = lengthValue(p.marginRight || p.marginX, SPACE, "0");
  const bottom = lengthValue(p.marginBottom || p.marginY, SPACE, "0");
  const left = lengthValue(p.marginLeft || p.marginX, SPACE, "0");
  return `margin:${top} ${right} ${bottom} ${left}`;
}
// Universal per-element padding (all 4 sides) — unlike radius, which only
// makes visual sense on image/embed/gallery, every element type gets this.
function paddingStyle(p: Record<string, string>) {
  if (!p.padding && !p.paddingTop && !p.paddingRight && !p.paddingBottom && !p.paddingLeft) return null;
  const side = (per: string) => lengthValue(p[per] || p.padding, PAD, "0");
  return `padding:${side("paddingTop")} ${side("paddingRight")} ${side("paddingBottom")} ${side("paddingLeft")}`;
}
// Full typography escape hatch for heading/text/list.
function typoStyle(p: Record<string, string>) {
  return [
    p.fontFamily ? `font-family:'${p.fontFamily}'` : null,
    p.color ? `color:${p.color}` : null,
    p.lineHeight ? `line-height:${p.lineHeight}` : null,
    p.letterSpacing ? `letter-spacing:${p.letterSpacing}` : null,
    p.fontWeight ? `font-weight:${p.fontWeight}` : null,
    p.textTransform ? `text-transform:${p.textTransform}` : null,
    p.fontStyle ? `font-style:${p.fontStyle}` : null,
    p.textDecoration ? `text-decoration:${p.textDecoration}` : null,
  ]
    .filter(Boolean)
    .join(";");
}

// Column-level style escape hatch (Col.props) — mirrors Designer.tsx's
// colStyle(), turning a column into a themeable "card" wrapping whatever
// elements are dropped into it.
function colStyle(cp?: Record<string, string>) {
  if (!cp) return undefined;
  const anyPadding = cp.padding || cp.paddingTop || cp.paddingRight || cp.paddingBottom || cp.paddingLeft;
  const padSide = (per: string) => lengthValue(cp[per] || cp.padding, PAD, "0");
  const anyRadius = cp.radius || cp.radiusTopLeft || cp.radiusTopRight || cp.radiusBottomRight || cp.radiusBottomLeft;
  const radCorner = (per: string) => lengthValue(cp[per] || cp.radius, RADIUS, RADIUS.none);
  return [
    cp.bg ? `background:${cp.bg}` : null,
    anyPadding ? `padding:${padSide("paddingTop")} ${padSide("paddingRight")} ${padSide("paddingBottom")} ${padSide("paddingLeft")}` : null,
    cp.marginY || cp.marginX || cp.marginTop || cp.marginRight || cp.marginBottom || cp.marginLeft
      ? `margin:${lengthValue(cp.marginTop || cp.marginY, PAD, "0")} ${lengthValue(cp.marginRight || cp.marginX, PAD, "0")} ${lengthValue(cp.marginBottom || cp.marginY, PAD, "0")} ${lengthValue(cp.marginLeft || cp.marginX, PAD, "0")}`
      : null,
    cp.valign ? `align-self:${cp.valign === "top" ? "start" : cp.valign === "bottom" ? "end" : "center"}` : null,
    cp.border ? `border:${BORDER[cp.border]}` : null,
    shadowToCss(cp.shadow) ? `box-shadow:${shadowToCss(cp.shadow)}` : null,
    anyRadius ? `border-radius:${radCorner("radiusTopLeft")} ${radCorner("radiusTopRight")} ${radCorner("radiusBottomRight")} ${radCorner("radiusBottomLeft")}` : null,
  ]
    .filter(Boolean)
    .join(";");
}

// Element radius (image/embed/gallery): per-corner freedom, same fallback-
// chain convention as colStyle()/sectionStyle above. These elements default
// to a rounded "md" look (see Designer.tsx's ELS defaults), so the fallback
// is RADIUS.md, not RADIUS.none.
function elRadius(p: Record<string, string>): string {
  const corner = (per: string) => lengthValue(p[per] || p.radius, RADIUS, RADIUS.md);
  return `${corner("radiusTopLeft")} ${corner("radiusTopRight")} ${corner("radiusBottomRight")} ${corner("radiusBottomLeft")}`;
}
const cls = (...parts: (string | undefined)[]) => parts.filter(Boolean).join(" ");

// Extracted to a plain function of `p` (rather than reading the
// destructured Props consts directly) so bp-override rendering (below) can
// re-run the exact same logic against a tablet/mobile-merged props copy —
// `sectionStyle` itself is just this called once against the real desktop
// props.
function buildSectionStyle(p: Record<string, string>): string {
  // Per-side padding / per-corner radius — freedom to set Top/Right/Bottom/
  // Left (or each corner) independently from the admin's FourSideControl;
  // unset falls back to the shared axis (paddingY/paddingX) or single radius
  // preset, same fallback-chain convention Designer.tsx's fourSideValue() uses.
  const padTop = lengthValue(p.paddingTop || p.paddingY, PAD, PAD.md);
  const padRight = lengthValue(p.paddingRight || p.paddingX || pagePaddingX, PAD, "1.5rem");
  const padBottom = lengthValue(p.paddingBottom || p.paddingY, PAD, PAD.md);
  const padLeft = lengthValue(p.paddingLeft || p.paddingX || pagePaddingX, PAD, "1.5rem");
  // Margin has no X axis (block-flow spacing only) — top/bottom, each falling
  // back to the shared marginY value, same convention as padding above.
  const marginTopVal = lengthValue(p.marginTop || p.marginY, PAD, "0");
  const marginRightVal = lengthValue(p.marginRight || p.marginX, PAD, "0");
  const marginBottomVal = lengthValue(p.marginBottom || p.marginY, PAD, "0");
  const marginLeftVal = lengthValue(p.marginLeft || p.marginX, PAD, "0");
  const radTopLeft = lengthValue(p.radiusTopLeft || p.radius, RADIUS, RADIUS.none);
  const radTopRight = lengthValue(p.radiusTopRight || p.radius, RADIUS, RADIUS.none);
  const radBottomRight = lengthValue(p.radiusBottomRight || p.radius, RADIUS, RADIUS.none);
  const radBottomLeft = lengthValue(p.radiusBottomLeft || p.radius, RADIUS, RADIUS.none);
  return [
    p.bgImage && safeCssUrl(p.bgImage) ? `background:url('${safeCssUrl(p.bgImage)}') center/cover no-repeat` : p.bg ? `background:${p.bg}` : null,
    p.textColor ? `color:${p.textColor}` : null,
    `padding:${padTop} ${padRight} ${padBottom} ${padLeft}`,
    `margin:${marginTopVal} ${marginRightVal} ${marginBottomVal} ${marginLeftVal}`,
    // Only override border/shadow when the author actually picked a value —
    // otherwise every existing section would flatten to square/shadowless
    // corners instead of its current default look. Radius always applies
    // (falls back to RADIUS.none = 0, same visual result as unset).
    // borderWidth set = real stroke fields win, mirrors Designer.tsx's
    // sectionBpStyle(); otherwise fall back to the legacy preset so old pages
    // saved before this field existed don't move.
    p.borderWidth ? `border:${p.borderWidth}px ${p.borderStyle || "solid"} ${p.borderColor || "currentColor"}` : p.border ? `border:${BORDER[p.border]}` : null,
    shadowToCss(p.shadow) ? `box-shadow:${shadowToCss(p.shadow)}` : null,
    `border-radius:${radTopLeft} ${radTopRight} ${radBottomRight} ${radBottomLeft}`,
    p.opacity ? `opacity:${Math.max(0, Math.min(100, Number(p.opacity))) / 100}` : null,
  ]
    .filter(Boolean)
    .join(";");
}
const baseSectionProps: Record<string, string> = {
  bg: bg ?? "",
  bgImage: bgImage ?? "",
  textColor: textColor ?? "",
  paddingY: paddingY ?? "",
  paddingX: paddingX ?? "",
  paddingTop: paddingTop ?? "",
  paddingRight: paddingRight ?? "",
  paddingBottom: paddingBottom ?? "",
  paddingLeft: paddingLeft ?? "",
  marginY: marginY ?? "",
  marginX: marginX ?? "",
  marginTop: marginTop ?? "",
  marginRight: marginRight ?? "",
  marginBottom: marginBottom ?? "",
  marginLeft: marginLeft ?? "",
  border: border ?? "",
  borderWidth: borderWidth ?? "",
  borderColor: borderColor ?? "",
  borderStyle: borderStyle ?? "",
  opacity: opacity ?? "",
  shadow: shadow ?? "",
  radius: radius ?? "",
  radiusTopLeft: radiusTopLeft ?? "",
  radiusTopRight: radiusTopRight ?? "",
  radiusBottomRight: radiusBottomRight ?? "",
  radiusBottomLeft: radiusBottomLeft ?? "",
};
const sectionStyle = buildSectionStyle(baseSectionProps);

// marginTop's default (2.5rem, matching the old fixed .ds-inner flex gap)
// is skipped for the first row — that layout never had a leading gap either.
const rowStyle = (row: Row, isFirst: boolean) => {
  const pad =
    row.paddingTop || row.paddingRight || row.paddingBottom || row.paddingLeft
      ? `padding:${row.paddingTop ?? "0"} ${row.paddingRight ?? "0"} ${row.paddingBottom ?? "0"} ${row.paddingLeft ?? "0"};`
      : "";
  return `grid-template-columns:${(row.columns ?? []).map((c) => `${c.span ?? 1}fr`).join(" ")};gap:${row.gap ?? pageGap ?? "2rem"};margin-top:${row.marginTop ?? (isFirst ? "0" : "2.5rem")};margin-bottom:${row.marginBottom ?? "0"};${pad}`;
};
const headingTag = (level?: string) => (["1", "2", "3", "4"].includes(level ?? "") ? `h${level}` : "h2");
---

<section
  class={cls("ds-section", cssClass)}
  id={anchorId || undefined}
  style={sectionStyle}
  data-designer-path={designerEdit ? String(blockIndex) : undefined}
  data-vis={respId(`s${blockIndex}`, { hideDesktop, hideTablet, hideMobile }, sectionBp, baseSectionProps, buildSectionStyle)}
>
  <div class={(width ?? pageContentWidth) === "full" ? "ds-inner ds-full" : "ds-inner"}>
    {rows.map((row, r) => (
      <div
        class="ds-row"
        style={rowStyle(row, r === 0)}
        data-vis={respId(`r${blockIndex}-${r}`, row)}
      >
        {(row.columns ?? []).map((col, c) => (
          <div
            class={cls("ds-col", col.props?.cssClass)}
            style={colStyle(col.props)}
            data-designer-path={designerEdit ? `${blockIndex}.${r}.${c}` : undefined}
            data-vis={respId(`c${blockIndex}-${r}-${c}`, col.props ?? {}, col.bp, col.props ?? {}, (p) => colStyle(p) ?? "")}
          >
            {(col.elements ?? []).map((el, e) => {
              const p = el.props ?? {};
              const node = (() => {
              switch (el.type) {
                case "heading": {
                  const Tag = headingTag(p.level) as "h1";
                  return (
                    <Tag
                      class={cls("ds-h", `ds-h${p.level ?? "2"}`, p.cssClass)}
                      style={[p.align ? `text-align:${p.align}` : null, marginStyle(p), paddingStyle(p), typoStyle(p)]
                        .filter(Boolean)
                        .join(";")}
                      set:html={p.text ? renderInline(p.text) : ""}
                    />
                  );
                }
                case "text":
                  return (
                    <p
                      class={cls("ds-text", p.cssClass)}
                      style={[
                        `font-size:${fluidTextSize(lengthValue(p.size, TEXT_SIZE, TEXT_SIZE.md))}`,
                        p.align ? `text-align:${p.align}` : null,
                        marginStyle(p),
                        paddingStyle(p),
                        typoStyle(p),
                      ]
                        .filter(Boolean)
                        .join(";")}
                      set:html={renderInline(p.text ?? "")}
                    />
                  );
                case "image":
                  return safeUrl(p.src) ? (
                    <div style={p.align ? `text-align:${p.align}` : null}>
                      <img
                        class={cls("ds-img", p.cssClass)}
                        src={safeUrl(p.src)}
                        alt={p.alt ?? ""}
                        loading="lazy"
                        style={[
                          `border-radius:${elRadius(p)}`,
                          shadowToCss(p.shadow) ? `box-shadow:${shadowToCss(p.shadow)}` : null,
                          p.imgWidth ? `width:${p.imgWidth}` : null,
                          marginStyle(p),
                          paddingStyle(p),
                        ]
                          .filter(Boolean)
                          .join(";")}
                      />
                    </div>
                  ) : null;
                case "button":
                  return p.label ? (
                    <div
                      style={[p.align ? `text-align:${p.align}` : null, marginStyle(p), paddingStyle(p)].filter(Boolean).join(";")}
                    >
                      <a
                        class={cls(p.variant === "outline" ? "ds-btn ds-btn-outline" : "ds-btn ds-btn-primary", p.cssClass)}
                        href={safeUrl(p.href) ?? "#"}
                      >
                        {p.label}
                      </a>
                    </div>
                  ) : null;
                case "spacer":
                  return <div style={`height:${lengthValue(p.height, SPACE, SPACE.md)}`} aria-hidden="true" />;
                case "divider":
                  return (
                    <hr
                      class={cls("ds-divider", p.cssClass)}
                      style={[marginStyle(p), paddingStyle(p)].filter(Boolean).join(";") || undefined}
                    />
                  );
                case "embed":
                  return safeUrl(p.url) ? (
                    <iframe
                      class={cls("ds-embed", p.cssClass)}
                      src={safeUrl(p.url)}
                      style={[
                        `aspect-ratio:${RATIO[p.ratio ?? "16:9"] ?? RATIO["16:9"]}`,
                        `border-radius:${elRadius(p)}`,
                        shadowToCss(p.shadow) ? `box-shadow:${shadowToCss(p.shadow)}` : null,
                        marginStyle(p),
                        paddingStyle(p),
                      ]
                        .filter(Boolean)
                        .join(";")}
                      loading="lazy"
                      allowfullscreen
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      referrerpolicy="strict-origin-when-cross-origin"
                    />
                  ) : null;
                case "icon": {
                  const path = ICON_PATHS[p.name ?? "check"] ?? ICON_PATHS.check;
                  const size = lengthValue(p.size, ICON_SIZE, ICON_SIZE.md);
                  return (
                    <div
                      class={p.cssClass}
                      style={[p.align ? `text-align:${p.align}` : null, marginStyle(p), paddingStyle(p)].filter(Boolean).join(";")}
                    >
                      <svg
                        width={size}
                        height={size}
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke={p.color || "currentColor"}
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        style="display:inline-block;vertical-align:middle"
                      >
                        <path d={path} />
                      </svg>
                    </div>
                  );
                }
                case "list": {
                  const items = (p.items ?? "").split("\n").map((s) => s.trim()).filter(Boolean);
                  if (items.length === 0) return null;
                  const Tag = p.style === "numbered" ? "ol" : "ul";
                  return (
                    <Tag
                      class={cls("ds-list", p.style === "none" ? "ds-list-none" : undefined, p.cssClass)}
                      style={[marginStyle(p), paddingStyle(p), typoStyle(p)].filter(Boolean).join(";")}
                    >
                      {items.map((it) => (
                        <li set:html={renderInline(it)} />
                      ))}
                    </Tag>
                  );
                }
                case "html":
                  // Same trust tier as bgImage/embed src above: only an
                  // authenticated webmaster/superadmin can write page
                  // layout, so this isn't a public-input XSS surface.
                  return p.html ? (
                    <div
                      class={cls("ds-html", p.cssClass)}
                      style={[marginStyle(p), paddingStyle(p)].filter(Boolean).join(";") || undefined}
                      set:html={p.html}
                    />
                  ) : null;
                case "gallery": {
                  const images = (p.images ?? "")
                    .split("\n")
                    .map((s) => s.trim())
                    .filter(Boolean)
                    .map(safeUrl)
                    .filter((u): u is string => Boolean(u));
                  if (images.length === 0) return null;
                  return (
                    <div
                      class={cls("ds-gallery", p.cssClass)}
                      style={[`grid-template-columns:repeat(${p.columns ?? "3"},1fr)`, marginStyle(p), paddingStyle(p)]
                        .filter(Boolean)
                        .join(";")}
                    >
                      {images.map((src) => (
                        <img src={src} alt="" loading="lazy" style={`border-radius:${elRadius(p)}`} />
                      ))}
                    </div>
                  );
                }
                case "accordion": {
                  const items = parsePairs(p.items);
                  if (items.length === 0) return null;
                  // <details name="..."> makes a group mutually exclusive
                  // (native, no JS) — only set it when the author opted in,
                  // since by default multiple items can stay open at once.
                  const groupName = p.exclusive === "true" ? `ds-acc-${blockIndex}-${r}-${c}-${e}` : undefined;
                  return (
                    <div class={cls("ds-accordion", p.cssClass)} style={[marginStyle(p), paddingStyle(p)].filter(Boolean).join(";")}>
                      {items.map((it) => (
                        <details class="ds-accordion-item" name={groupName}>
                          <summary class="ds-accordion-q" set:html={renderInline(it.a)} />
                          <div class="ds-accordion-a" set:html={renderInline(it.b)} />
                        </details>
                      ))}
                    </div>
                  );
                }
                case "infobox": {
                  const iconPath = ICON_PATHS[p.name ?? "star"] ?? ICON_PATHS.star;
                  const left = p.iconPosition === "left";
                  return (
                    <div
                      class={cls(
                        "ds-infobox",
                        left ? "ds-infobox-left" : "ds-infobox-top",
                        !left && p.align === "center" ? "ds-infobox-center" : undefined,
                        p.cssClass,
                      )}
                      style={[marginStyle(p), paddingStyle(p)].filter(Boolean).join(";")}
                    >
                      <svg
                        class="ds-infobox-icon"
                        width="2rem"
                        height="2rem"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke={p.color || "currentColor"}
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d={iconPath} />
                      </svg>
                      <div>
                        {p.heading && <p class="ds-infobox-heading" set:html={renderInline(p.heading)} />}
                        {p.text && <p class="ds-infobox-text" set:html={renderInline(p.text)} />}
                      </div>
                    </div>
                  );
                }
                case "tabs": {
                  const items = parsePairs(p.items);
                  if (items.length === 0) return null;
                  return (
                    <div class={cls("ds-tabs", p.cssClass)} style={[marginStyle(p), paddingStyle(p)].filter(Boolean).join(";")}>
                      <div class="ds-tabs-labels">
                        {items.map((it, i) => (
                          <button
                            type="button"
                            class={cls("ds-tabs-label", i === 0 ? "is-active" : undefined)}
                            data-idx={i}
                            set:html={renderInline(it.a)}
                          />
                        ))}
                      </div>
                      <div class="ds-tabs-panels">
                        {items.map((it, i) => (
                          <div class={cls("ds-tabs-panel", i === 0 ? "is-active" : undefined)} data-idx={i} set:html={renderInline(it.b)} />
                        ))}
                      </div>
                    </div>
                  );
                }
                case "slider": {
                  const slides = parseSlides(p.slides);
                  if (slides.length === 0) return null;
                  const autoplayMs = Math.round(Number(p.autoplay || "0") * 1000);
                  const navStyle = p.navStyle || "arrows";
                  const dotsStyle = p.dotsStyle || "dots";
                  const transition = p.transition || "slide";
                  return (
                    <div
                      class={cls("ds-slider", p.cssClass)}
                      style={[`height:${lengthValue(p.height, SLIDER_HEIGHT, SLIDER_HEIGHT.md)}`, marginStyle(p), paddingStyle(p)]
                        .filter(Boolean)
                        .join(";")}
                      data-autoplay={autoplayMs > 0 ? autoplayMs : undefined}
                      data-nav={navStyle}
                      data-pagination={dotsStyle}
                      data-transition={transition}
                    >
                      <div class="ds-slider-viewport">
                        <div class="ds-slider-track">
                          {slides.map((s, si) => {
                            const bgUrl = s.imageUrl ? safeCssUrl(s.imageUrl) : undefined;
                            const overlayOpacity = Math.min(100, Math.max(0, Number(s.overlayOpacity) || 0)) / 100;
                            const flowButtons = s.buttons.filter((btn) => btn.position !== "custom");
                            const freeButtons = s.buttons.filter((btn) => btn.position === "custom");
                            const headingFlow = s.heading.position !== "custom";
                            const subtitleFlow = s.subtitle.position !== "custom";
                            const showSubtitle = s.subtitle.text.length > 0;
                            // bgColor is a flat fill BEHIND the image (visible
                            // in any transparent margin, or as the whole
                            // background when there's no image at all) — the
                            // only previous way to get a solid-color slide was
                            // an accidental side effect of the overlay sitting
                            // over the page's own backdrop, not a real choice.
                            const slideStyle = [
                              bgUrl ? `background-image:url('${bgUrl}')` : null,
                              s.bgColor && HEX_RE.test(s.bgColor) ? `background-color:${s.bgColor}` : null,
                            ]
                              .filter(Boolean)
                              .join(";");
                            return (
                              <div class="ds-slide" style={slideStyle || undefined}>
                                {overlayOpacity > 0 && (
                                  <div class="ds-slide-overlay" style={`background:${hexToRgba(s.overlayColor, overlayOpacity)}`} />
                                )}
                                <div class={cls("ds-slide-content", `ds-slide-${s.textPosition}`)}>
                                  {s.heading.text && headingFlow && (
                                    <p
                                      class="ds-slide-heading"
                                      style={slideTextStyle(s.heading)}
                                      data-vis={slideTextVisId(s.heading, `sth-${blockIndex}-${si}`)}
                                      set:html={renderInline(s.heading.text)}
                                    />
                                  )}
                                  {showSubtitle && subtitleFlow && (
                                    <p
                                      class="ds-slide-subtitle"
                                      style={slideTextStyle(s.subtitle)}
                                      data-vis={slideTextVisId(s.subtitle, `sts-${blockIndex}-${si}`)}
                                      set:html={renderInline(s.subtitle.text)}
                                    />
                                  )}
                                  {flowButtons.length > 0 && (
                                    <div class="ds-slide-buttons">
                                      {flowButtons.map((btn) => (
                                        <a
                                          class={cls(
                                            "ds-btn",
                                            btn.variant === "outline" ? "ds-btn-outline" : "ds-btn-primary",
                                            btn.size !== "md" ? `ds-btn-${btn.size}` : undefined,
                                          )}
                                          style={slideButtonStyle(btn)}
                                          href={safeUrl(btn.href) ?? "#"}
                                        >
                                          {btn.label}
                                        </a>
                                      ))}
                                    </div>
                                  )}
                                </div>
                                {s.heading.text && !headingFlow && (
                                  <p
                                    class="ds-slide-heading ds-slide-text-free"
                                    style={[`left:${Math.min(100, Math.max(0, Number(s.heading.x) || 50))}%`, `top:${Math.min(100, Math.max(0, Number(s.heading.y) || 50))}%`, slideTextStyle(s.heading)].filter(Boolean).join(";")}
                                    data-vis={slideTextVisId(s.heading, `sth-${blockIndex}-${si}`)}
                                    set:html={renderInline(s.heading.text)}
                                  />
                                )}
                                {showSubtitle && !subtitleFlow && (
                                  <p
                                    class="ds-slide-subtitle ds-slide-text-free"
                                    style={[`left:${Math.min(100, Math.max(0, Number(s.subtitle.x) || 50))}%`, `top:${Math.min(100, Math.max(0, Number(s.subtitle.y) || 50))}%`, slideTextStyle(s.subtitle)].filter(Boolean).join(";")}
                                    data-vis={slideTextVisId(s.subtitle, `sts-${blockIndex}-${si}`)}
                                    set:html={renderInline(s.subtitle.text)}
                                  />
                                )}
                                {freeButtons.map((btn) => {
                                  const x = Math.min(100, Math.max(0, Number(btn.x) || 50));
                                  const y = Math.min(100, Math.max(0, Number(btn.y) || 50));
                                  return (
                                    <a
                                      class={cls(
                                        "ds-btn",
                                        "ds-slide-btn-free",
                                        btn.variant === "outline" ? "ds-btn-outline" : "ds-btn-primary",
                                        btn.size !== "md" ? `ds-btn-${btn.size}` : undefined,
                                      )}
                                      style={[`left:${x}%`, `top:${y}%`, slideButtonStyle(btn)].filter(Boolean).join(";")}
                                      href={safeUrl(btn.href) ?? "#"}
                                    >
                                      {btn.label}
                                    </a>
                                  );
                                })}
                              </div>
                            );
                          })}
                        </div>
                      </div>
                      {slides.length > 1 && (
                        <>
                          {navStyle !== "none" && (
                            <>
                              <button type="button" class="ds-slider-prev" aria-label="Previous slide">‹</button>
                              <button type="button" class="ds-slider-next" aria-label="Next slide">›</button>
                            </>
                          )}
                          {dotsStyle !== "none" && (
                            <div class="ds-slider-dots">
                              {slides.map((_, i) => (
                                <span class={cls("ds-slider-dot", i === 0 ? "is-active" : undefined)} data-idx={i}>
                                  {dotsStyle === "numbers" ? i + 1 : ""}
                                </span>
                              ))}
                            </div>
                          )}
                        </>
                      )}
                    </div>
                  );
                }
                case "menu":
                  return (
                    <MenuBlock
                      menuId={p.menuId ?? ""}
                      layout={p.layout as "horizontal" | "vertical" | undefined}
                      dropdownTrigger={p.dropdownTrigger as "hover" | "click" | undefined}
                      megaMenuWidth={p.megaMenuWidth as "contained" | "full-width" | undefined}
                      tenantHost={tenantHost}
                      lang={requestedLang}
                    />
                  );
