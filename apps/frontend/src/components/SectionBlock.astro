                      {p.description && <p class="ds-ctabanner-desc">{p.description}</p>}
                      {(p.button1Label || p.button2Label) && (
                        <div class="ds-ctabanner-actions">
                          {p.button1Label && (
                            <a class="ds-btn ds-btn-primary" href={safeUrl(p.button1Href) ?? "#"}>
                              {p.button1Label}
                            </a>
                          )}
                          {p.button2Label && (
                            <a class="ds-btn ds-btn-outline" href={safeUrl(p.button2Href) ?? "#"}>
                              {p.button2Label}
                            </a>
