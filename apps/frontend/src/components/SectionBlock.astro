---
// Renders a Web Designer `section` block (see apps/admin/src/Designer.tsx for
// the model + the matching canvas preview). Pure HTML + scoped CSS for every
// element except tabs/slider, which need a small vanilla-JS listener (see
// the <script> at the bottom) — accordion stays zero-JS via native
// <details>/<summary>.
import MenuBlock from "./MenuBlock.astro";
import PostListBlock from "./PostListBlock.astro";
import EventListBlock from "./EventListBlock.astro";

interface El {
  id?: string;
  type: string;
  props?: Record<string, string>;
  bp?: Record<string, string>;
}
interface Col {
  span?: number;
  elements?: El[];
  props?: Record<string, string>;
  bp?: Record<string, string>;
}
interface Row {
  columns?: Col[];
  gap?: string;
  marginTop?: string;
  marginBottom?: string;
  paddingTop?: string;
  paddingRight?: string;
  paddingBottom?: string;
  paddingLeft?: string;
  hideDesktop?: string;
  hideTablet?: string;
  hideMobile?: string;
}
interface Props {
  bg?: string;
  bgImage?: string;
  textColor?: string;
  paddingY?: string;
  paddingX?: string;
  paddingTop?: string;
  paddingRight?: string;
  paddingBottom?: string;
  paddingLeft?: string;
  marginY?: string;
  marginX?: string;
  marginTop?: string;
  marginBottom?: string;
  marginLeft?: string;
  marginRight?: string;
  width?: string;
  border?: string;
  borderWidth?: string;
  borderColor?: string;
  borderStyle?: string;
  opacity?: string;
  shadow?: string;
  radius?: string;
  radiusTopLeft?: string;
  radiusTopRight?: string;
  radiusBottomRight?: string;
  radiusBottomLeft?: string;
  anchorId?: string;
  cssClass?: string;
  rows?: Row[];
  bp?: Record<string, string>;
  hideDesktop?: string;
  hideTablet?: string;
  hideMobile?: string;
  // Live-edit bridge (Designer.tsx "live view"): when set, every section/
  // column/element wrapper gets a data-designer-path so the admin iframe's
  // bridge script can map a click back to a [b,r,c,e] selection. blockIndex
  // is this section's own position in the page's top-level layout array
  // (apps/frontend/src/pages/[...slug].astro passes it). Never set for a
  // real visitor — see [...slug].astro's designerEdit gate (requires a
  // valid preview token).
  designerEdit?: boolean;
  blockIndex?: number;
  // Page-wide default column gap ([...slug].astro's page.settings.gap) — a
  // row's own `gap` (Row.gap, set in Designer.tsx) always wins over this.
  pageGap?: string;
  // Same page-wide-default convention as pageGap, for this section's own
  // width/paddingX — a section that sets its own `width`/`paddingX` always
  // wins over these.
  pageContentWidth?: string;
  pagePaddingX?: string;
  // Threaded through for the "menu" element case below (MenuBlock needs both
  // to fetch/resolve the right tenant's menu in the requested language) — a
  // menu element is never nested any deeper than column.elements, all within
  // this SAME component's own template scope (rows/columns/elements are
  // plain nested array maps here, not recursive SectionBlock instances), so
  // these two just need to be in scope once at the top, not re-passed at
  // each nesting level.
  tenantHost?: string;
  requestedLang?: string | null;
}
const {
  bg,
  bgImage,
  textColor,
  paddingY = "md",
  paddingX,
  paddingTop,
  paddingRight,
  paddingBottom,
  paddingLeft,
  marginY,
  marginX,
  marginTop,
  marginBottom,
  marginLeft,
  marginRight,
  width,
  border,
  borderWidth,
  borderColor,
  borderStyle,
  opacity,
  shadow,
  radius,
  radiusTopLeft,
  radiusTopRight,
  radiusBottomRight,
  radiusBottomLeft,
  anchorId,
  cssClass,
  rows = [],
  bp: sectionBp,
  designerEdit = false,
  blockIndex = 0,
  pageGap,
  pageContentWidth,
  pagePaddingX,
  hideDesktop,
  hideTablet,
  hideMobile,
  tenantHost = "",
  requestedLang = null,
} = Astro.props;

const PAD: Record<string, string> = { none: "0", sm: "1.5rem", md: "3rem", lg: "5rem", xl: "7rem" };
const SPACE: Record<string, string> = { sm: "1rem", md: "2rem", lg: "4rem", xl: "6rem" };
const RADIUS: Record<string, string> = { none: "0", md: "0.75rem", xl: "1.5rem", full: "9999px" };
const TEXT_SIZE: Record<string, string> = { sm: "0.875rem", md: "1rem", lg: "1.2rem" };
const RATIO: Record<string, string> = { "16:9": "16 / 9", "4:3": "4 / 3", "1:1": "1 / 1" };
const SLIDER_HEIGHT: Record<string, string> = { sm: "24rem", md: "32rem", lg: "42rem", full: "100vh" };
// Real per-breakpoint visibility (Designer.tsx's VisibilityToggle) AND, for
// Section/Column, real per-breakpoint style overrides (Designer.tsx's `bp`
// bag — Row/Element still admin-preview-only there for now, see CLAUDE.md).
// Both need actual scoped @media rules on the published site, not inline
// `style=""` (which can't contain @media and, being inline, would outrank
// any external rule anyway — hence every declaration here gets `!important`
// too). `responsiveRules` collects one entry per node (Section/Row/Column/
// Element) that needs either, each scoped to that node's own `data-vis`
// attribute value — flushed into a single <style> at the end of this
// section's render. Cutoffs (tablet 641-1024px, mobile ≤640px) are real CSS
// breakpoints here, independent of Designer.tsx's own BP_REFERENCE_PX (canvas
// simulation reference widths, a different concern) and of Row's own
// pre-existing @media (max-width:768px) column-stacking rule below.
const responsiveRules: string[] = [];
// bp overrides are keyed "tablet:<fieldKey>"/"mobile:<fieldKey>" (same
// format as Designer.tsx's El.bp/Col.bp/SectionProps.bp) — merge the
// matching tier's overrides onto a copy of the node's own base props so
// `build()` (whatever function normally turns props into that node's style
// string) can be re-run for that breakpoint exactly as it ran for desktop.
function bpMerge(base: Record<string, string>, bp: Record<string, string>, tier: "tablet" | "mobile"): Record<string, string> {
  const prefix = `${tier}:`;
  const merged = { ...base };
  for (const [k, v] of Object.entries(bp)) {
    if (k.startsWith(prefix)) merged[k.slice(prefix.length)] = v;
  }
  return merged;
}
// Re-runs `build()` for each tier that actually has an override, appends
// `!important` to every declaration (needed to beat the node's own inline
// `style=""`, which otherwise always outranks an external stylesheet rule
// regardless of media-query specificity), and scopes it to `selector`.
function bpStyleRules(selector: string, bp: Record<string, string>, base: Record<string, string>, build: (p: Record<string, string>) => string): string[] {
  const out: string[] = [];
  for (const tier of ["tablet", "mobile"] as const) {
    if (!Object.keys(bp).some((k) => k.startsWith(`${tier}:`))) continue;
    const css = build(bpMerge(base, bp, tier));
    if (!css) continue;
    const important = css
      .split(";")
      .filter(Boolean)
      .map((decl) => `${decl} !important`)
      .join(";");
    const media = tier === "tablet" ? "(min-width:641px) and (max-width:1024px)" : "(max-width:640px)";
    out.push(`@media ${media}{${selector}{${important}}}`);
  }
  return out;
}
// Assigns a stable `data-vis` id to a node only when it actually needs one
// (a real hide flag, or a tablet/mobile style override) — cheap common case
// (no markup added) stays untouched. `bp`/`base`/`build` are omitted for
// node kinds that don't support real style overrides yet (Row, Element —
// see the CLAUDE.md note on this feature), leaving visibility as their only
// responsive concern.
function respId(
  id: string,
  visProps: { hideDesktop?: string; hideTablet?: string; hideMobile?: string },
  bp?: Record<string, string>,
  base?: Record<string, string>,
  build?: (p: Record<string, string>) => string,
): string | undefined {
  const hasVis = visProps.hideDesktop === "true" || visProps.hideTablet === "true" || visProps.hideMobile === "true";
  const hasBp = !!bp && Object.keys(bp).length > 0 && !!base && !!build;
  if (!hasVis && !hasBp) return undefined;
  const selector = `[data-vis="${id}"]`;
  if (visProps.hideDesktop === "true") responsiveRules.push(`@media (min-width:1025px){${selector}{display:none!important}}`);
  if (visProps.hideTablet === "true") responsiveRules.push(`@media (min-width:641px) and (max-width:1024px){${selector}{display:none!important}}`);
  if (visProps.hideMobile === "true") responsiveRules.push(`@media (max-width:640px){${selector}{display:none!important}}`);
  if (hasBp) responsiveRules.push(...bpStyleRules(selector, bp!, base!, build!));
  return id;
}
// Shared "one item per line, first `|` splits it in two" parser for
// accordion (question|answer) and tabs (label|content) — mirrors
// apps/admin/src/Designer.tsx's parsePairs(), kept in sync by hand like
// every other table this file duplicates from there.
function parsePairs(raw?: string): { a: string; b: string }[] {
  return (raw ?? "")
    .split("\n")
    .map((s) => s.trim())
    .filter(Boolean)
    .map((line) => {
      const i = line.indexOf("|");
      return i === -1 ? { a: line, b: "" } : { a: line.slice(0, i), b: line.slice(i + 1) };
    });
}
// Slider slide data. Storage is a JSON array (see Designer.tsx's
// parseSlides/stringifySlides, added alongside the Embla Carousel rewrite) —
// parseSlides() here mirrors that same dual-format parser: JSON.parse first,
// falling back to the OLD imageUrl|heading|subtitle|buttonLabel|buttonHref
// pipe-line format for any page saved before this rewrite (never re-written
// until the author next edits that slider in Designer.tsx).
interface SlideButton {
  label: string;
  href: string;
  variant: "primary" | "outline";
  color: string;
  textColor: string;
  radius: string;
  size: "sm" | "md" | "lg";
  fontSize: string;
  position: "flow" | "custom";
  x: string;
  y: string;
}
interface SlideText {
  text: string;
  color: string;
  fontSize: string;
  width: string; // px, "" = default block width (100% of .ds-slide-content, capped at 36rem) — set by Designer's mid-edge drag handle so a line can go wider (up to the slide's own edge) before it wraps
  align: "left" | "center" | "right";
  fontFamily: string;
  fontWeight: string;
  lineHeight: string;
  letterSpacing: string;
  textTransform: string;
  fontStyle: string;
  textDecoration: string;
  position: "flow" | "custom";
  x: string;
  y: string;
  // Real per-breakpoint override (Designer.tsx's BpToggle next to Text
  // size/Align) — unlike Section/Col/El's own `bp` bag, this one only ever
  // stores "tablet:fontSize"/"mobile:fontSize"/"tablet:align"/"mobile:align".
  bp?: Record<string, string>;
}
interface Slide {
  imageUrl: string;
  bgColor: string; // hex fallback fill behind the image (or the whole slide when there's no image) — "" = transparent, matches the pre-existing look of a slide with nothing set
  heading: SlideText;
  subtitle: SlideText;
  textPosition: "left" | "center" | "right";
  overlayColor: string;
  overlayOpacity: string;
  buttons: SlideButton[];
}
const TEXT_DEFAULTS: SlideText = {
  text: "",
  color: "",
  fontSize: "",
  width: "",
  align: "left",
  fontFamily: "",
  fontWeight: "",
  lineHeight: "",
  letterSpacing: "",
  textTransform: "",
  fontStyle: "",
  textDecoration: "",
  position: "flow",
  x: "50",
  y: "50",
};
// Same dual-format convention as parseSlideButtons below — heading/subtitle
// were plain strings before this upgrade, so a string input here is legacy
// content wrapped into TEXT_DEFAULTS with that string as `text`.
function parseSlideText(raw: unknown): SlideText {
  if (typeof raw === "string") return { ...TEXT_DEFAULTS, text: raw };
  if (raw && typeof raw === "object") {
    const o = raw as Record<string, unknown>;
    type StrKey = "color" | "fontSize" | "width" | "fontFamily" | "fontWeight" | "lineHeight" | "letterSpacing" | "textTransform" | "fontStyle" | "textDecoration";
    const str = (key: StrKey) => (typeof o[key] === "string" ? (o[key] as string) : TEXT_DEFAULTS[key]);
    return {
      text: typeof o.text === "string" ? o.text : "",
      color: str("color"),
      fontSize: str("fontSize"),
      width: str("width"),
      align: o.align === "center" || o.align === "right" ? o.align : "left",
      fontFamily: str("fontFamily"),
      fontWeight: str("fontWeight"),
      lineHeight: str("lineHeight"),
      letterSpacing: str("letterSpacing"),
      textTransform: str("textTransform"),
      fontStyle: str("fontStyle"),
      textDecoration: str("textDecoration"),
      position: o.position === "custom" ? "custom" : "flow",
      x: typeof o.x === "string" ? o.x : TEXT_DEFAULTS.x,
      y: typeof o.y === "string" ? o.y : TEXT_DEFAULTS.y,
      bp: o.bp && typeof o.bp === "object" && !Array.isArray(o.bp) ? (o.bp as Record<string, string>) : undefined,
    };
  }
  return { ...TEXT_DEFAULTS };
}
const BUTTON_DEFAULTS: SlideButton = {
  label: "",
  href: "",
  variant: "primary",
  color: "",
  textColor: "",
  radius: "",
  size: "md",
  fontSize: "",
  position: "flow",
  x: "50",
  y: "50",
};
function parseSlideButtons(raw: unknown): SlideButton[] {
  if (!Array.isArray(raw)) return [];
  return raw.map((b) => {
    const btn = (b ?? {}) as Record<string, unknown>;
    return {
      label: typeof btn.label === "string" ? btn.label : "",
      href: typeof btn.href === "string" ? btn.href : "",
      variant: btn.variant === "outline" ? "outline" : ("primary" as const),
      color: typeof btn.color === "string" ? btn.color : BUTTON_DEFAULTS.color,
      textColor: typeof btn.textColor === "string" ? btn.textColor : BUTTON_DEFAULTS.textColor,
      radius: typeof btn.radius === "string" ? btn.radius : BUTTON_DEFAULTS.radius,
      size: btn.size === "sm" || btn.size === "lg" ? btn.size : "md",
      fontSize: typeof btn.fontSize === "string" ? btn.fontSize : BUTTON_DEFAULTS.fontSize,
      position: btn.position === "custom" ? "custom" : "flow",
      x: typeof btn.x === "string" ? btn.x : BUTTON_DEFAULTS.x,
      y: typeof btn.y === "string" ? btn.y : BUTTON_DEFAULTS.y,
    };
  });
}
function parseSlides(raw: string | undefined): Slide[] {
  if (!raw) return [];
  try {
    const parsed: unknown = JSON.parse(raw);
    if (Array.isArray(parsed)) {
      return parsed.map((item) => {
        const s = (item ?? {}) as Record<string, unknown>;
        return {
          imageUrl: typeof s.imageUrl === "string" ? s.imageUrl : "",
          bgColor: typeof s.bgColor === "string" ? s.bgColor : "",
          heading: parseSlideText(s.heading),
          subtitle: parseSlideText(s.subtitle),
          textPosition: s.textPosition === "left" || s.textPosition === "right" ? s.textPosition : "center",
          overlayColor: typeof s.overlayColor === "string" ? s.overlayColor : "#000000",
          overlayOpacity: typeof s.overlayOpacity === "string" ? s.overlayOpacity : "35",
          buttons: parseSlideButtons(s.buttons),
        };
      });
    }
  } catch {
    // Not JSON — fall through to the legacy pipe-line format below.
  }
  return raw
    .split("\n")
    .map((s) => s.trim())
    .filter(Boolean)
    .map((line) => {
      const [imageUrl = "", heading = "", subtitle = "", buttonLabel = "", buttonHref = ""] = line.split("|");
      return {
        imageUrl,
        bgColor: "",
        heading: parseSlideText(heading),
        subtitle: parseSlideText(subtitle),
        textPosition: "center" as const,
        overlayColor: "#000000",
        overlayOpacity: "35",
        buttons: buttonLabel ? [{ ...BUTTON_DEFAULTS, label: buttonLabel, href: buttonHref }] : [],
      };
    });
}
// cardgrid element (Sprint 5) — mirrors Designer.tsx's designer/parsers.ts
// parseCards, duplicated the same way parseSlides/parseSlideText are (no
// shared package between the two apps). Brand new element, no legacy
// format to fall back to.
interface Card {
  image: string;
  title: string;
  description: string;
  href: string;
  buttonLabel: string;
}
function parseCards(raw: string | undefined): Card[] {
  if (!raw) return [];
  try {
    const parsed: unknown = JSON.parse(raw);
    if (!Array.isArray(parsed)) return [];
    return parsed.map((item) => {
      const c = (item ?? {}) as Record<string, unknown>;
      return {
        image: typeof c.image === "string" ? c.image : "",
        title: typeof c.title === "string" ? c.title : "",
        description: typeof c.description === "string" ? c.description : "",
        href: typeof c.href === "string" ? c.href : "",
        buttonLabel: typeof c.buttonLabel === "string" ? c.buttonLabel : "",
      };
    });
  } catch {
    return [];
  }
}
// Batch of simple no-backend elements (testimonial/statscounter/peoplegrid/
// socialicons/logocloud/timeline/documentdownload) — mirrors
// apps/admin/src/designer/parsers.ts's parseRepeaterItems (no shared
// package between the two apps, same duplication convention as
// parseCards/parseSlides above). Every value coerced to a string, same as
// parseCards.
function parseRepeaterItems(raw: string | undefined): Record<string, string>[] {
  if (!raw) return [];
  try {
    const parsed: unknown = JSON.parse(raw);
    if (!Array.isArray(parsed)) return [];
    return parsed.map((item) => {
      const o = (item ?? {}) as Record<string, unknown>;
      const out: Record<string, string> = {};
      for (const k of Object.keys(o)) {
        if (typeof o[k] === "string") out[k] = o[k] as string;
      }
      return out;
    });
  } catch {
    return [];
  }
}
const BORDER: Record<string, string> = { none: "none", thin: "1px solid currentColor", thick: "3px solid currentColor" };
// Legacy preset keywords (existing content saved before the custom shadow
// panel) still resolve here. A new edit stores a pipe-delimited
// "x|y|blur|spread|color|opacity" string instead — mirrors
// apps/admin/src/Designer.tsx's shadowToCss()/LEGACY_SHADOW, kept in sync by
// hand like every other lookup table this file duplicates from there.
const LEGACY_SHADOW: Record<string, string | undefined> = {
  none: undefined,
  sm: "0 1px 3px rgba(0,0,0,.1)",
  md: "0 4px 12px rgba(0,0,0,.12)",
  lg: "0 12px 32px rgba(0,0,0,.16)",
};
// Render-time defense-in-depth for slide button style overrides — same
// pattern as bgImage's own safeCssUrl guard, on top of (not instead of)
// validate-layout.ts's write-time isSafeSlideButton check.
const HEX_RE = /^#[0-9a-f]{6}$/i;
const NUM_RE = /^[0-9]+(\.[0-9]+)?$/;
// Same shapes validate-layout.ts's write-time checks use for these same
// keys on every other element (FONT_FAMILY_RE/LENGTH_RE/ENUM_VALUES) —
// render-time defense-in-depth for the slide heading/subtitle's Typography
// fields, on top of (not instead of) that write-time check.
const FONT_FAMILY_RE = /^[A-Za-z0-9 ]*$/;
const LENGTH_RE = /^-?[0-9]+(\.[0-9]+)?(px|rem|em|%|vh|vw)?$/;
const FONT_WEIGHT_VALUES = ["400", "500", "600", "700", "800"];
const TEXT_TRANSFORM_VALUES = ["none", "uppercase", "lowercase", "capitalize"];
const FONT_STYLE_VALUES = ["normal", "italic"];
const TEXT_DECORATION_VALUES = ["none", "underline", "line-through"];
// Designer's drag-resize/Size field store a single author-chosen px value
// with no upper bound (by request — see CLAUDE.md) and no per-viewport
// variants, so a literal `font-size:{px}px` stopped adapting to the screen
// the moment an author set a custom size at all: it's a fixed number,
// however big, on a phone exactly as on a desktop. Wrapped in `clamp()`
// instead — the author's own value stays the ceiling (never renders bigger
// than intended), a floor keeps it legible, and a vw-based middle term
// (calibrated so it equals the ceiling at a ~1000px "designed at this width"
// viewport) is what actually shrinks the text on a narrower screen, the same
// technique `.ds-slide-heading`'s own default `clamp(1.5rem, 4vw, 2.5rem)`
// already uses below — this just derives one from any px value instead of
// a single hardcoded rule.
function fluidClamp(px: number, ceiling: string): string {
  const floor = Math.max(14, Math.round(px * 0.55));
  const vw = Math.round((px / 10) * 100) / 100;
  return `clamp(${floor}px, ${vw}vw, ${ceiling})`;
}
function fluidFontSize(pxStr: string): string {
  const px = parseFloat(pxStr);
  return fluidClamp(px, `${px}px`);
}
// Same fluid treatment, generalized to whatever unit the standalone Text
// element's own free-form "size" field actually stores (px/rem/em — a
// preset like TEXT_SIZE.md or any custom value an author typed) rather than
// the slider's always-bare-px string. rem/em are converted to a px
// equivalent for the floor/vw math only (assumes the 16px root, same
// assumption Designer.tsx's pxLabel() already makes) — the ceiling term
// keeps the author's original unit untouched. `%` (or anything unrecognized)
// passes through as-is: already relative to its container, not a fixed size
// that can render "too big" on a narrow screen the way px/rem/em can.
function fluidTextSize(v: string): string {
  const m = /^(-?[0-9]+(?:\.[0-9]+)?)(px|rem|em)$/.exec(v);
  if (!m) return v;
  const num = parseFloat(m[1]);
  const px = m[2] === "px" ? num : num * 16;
  return fluidClamp(px, v);
}
// color overrides `background` for both variants — for `ds-btn-outline`
// (border: 2px solid currentColor; color: inherit) setting textColor also
// recolors the border for free, since currentColor picks up `color` either way.
// When a custom background IS set but textColor isn't, `.ds-btn-primary`'s
// own CSS color (var(--color-primary-content)) is computed for the SITE
// THEME's primary color, not this button's overridden one — leaving `color`
// unset in that case can produce near-invisible text (a screenshot caught a
// button rendering as a solid color pill with no visible label at all).
// Falls back to the exact same dark/light default Designer.tsx's own canvas
// preview already uses for this same case, so the two agree.
function slideButtonStyle(btn: SlideButton): string | undefined {
  const hasCustomBg = !!btn.color && HEX_RE.test(btn.color);
  return (
    [
      hasCustomBg ? `background:${btn.color}` : null,
      btn.textColor && HEX_RE.test(btn.textColor)
        ? `color:${btn.textColor}`
        : hasCustomBg
          ? `color:${btn.variant === "outline" ? "#ffffff" : "#111827"}`
          : null,
      btn.radius && NUM_RE.test(btn.radius) ? `border-radius:${btn.radius}px` : null,
      // Overrides the size class's font-size — .ds-btn's padding is in em, so
      // this scales padding along with it (set by the canvas resize handle).
      btn.fontSize && NUM_RE.test(btn.fontSize) ? `font-size:${fluidFontSize(btn.fontSize)}` : null,
    ]
      .filter(Boolean)
      .join(";") || undefined
  );
}
function slideTextStyle(txt: SlideText): string | undefined {
  return (
    [
      txt.color && HEX_RE.test(txt.color) ? `color:${txt.color}` : null,
      txt.fontSize && NUM_RE.test(txt.fontSize) ? `font-size:${fluidFontSize(txt.fontSize)}` : null,
      // A flow heading/subtitle is a block <p> with no width of its own — it
      // defaults to 100% of .ds-slide-content, which is capped at 36rem, so
      // it wraps as soon as a line doesn't fit that column (normal wrap,
      // same as any other paragraph — a narrower dragged width is the
      // intentional, on-purpose way to force a second line; the only OTHER
      // way is a literal newline, Enter, typed via the Designer canvas or
      // Inspector textarea). An explicit width overrides that 100% default,
      // letting the line go wider than the 36rem column — right up to the
      // slide's own edge (`.ds-slide`'s overflow boundary is the real
      // "wall"). overflow-wrap is a safety net, not the primary mechanism:
      // if a later fontSize increase makes a single unbreakable word wider
      // than a width dragged at a smaller size, this breaks the word instead
      // of silently overflowing past the box's own border. max-width:none
      // lifts .ds-slide-text-free's own 80% cap for the custom-positioned
      // case, same reasoning.
      txt.width && NUM_RE.test(txt.width) ? `width:${txt.width}px;max-width:none;overflow-wrap:break-word` : null,
      `text-align:${txt.align}`,
