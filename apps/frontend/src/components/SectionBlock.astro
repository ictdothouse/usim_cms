                            {c.title && <h3 class="ds-card-title">{c.title}</h3>}
                            {c.description && <p class="ds-card-desc">{c.description}</p>}
                            {c.buttonLabel && c.href && (
                              <a class="ds-btn ds-btn-primary ds-card-btn" href={safeUrl(c.href) ?? "#"}>
                                {c.buttonLabel}
                              </a>
                            )}
                          </div>
                        </div>
                      ))}
                    </div>
                  );
                }
                case "ctabanner":
                  if (!p.heading && !p.description) return null;
