                    <div
                      class={cls("ds-cardgrid", p.equalHeight === "false" ? undefined : "ds-cardgrid-equal", p.cssClass)}
                      style={[`grid-template-columns:repeat(${p.columns ?? "3"},1fr)`, marginStyle(p), paddingStyle(p)]
                        .filter(Boolean)
                        .join(";")}
