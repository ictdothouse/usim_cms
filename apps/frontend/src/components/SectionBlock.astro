<script>
  import Swiper from "swiper";
  import { Autoplay, Grid, EffectCoverflow, EffectCube, EffectFlip, EffectCards } from "swiper/modules";
  import "swiper/css";
  import "swiper/css/grid";
  import "swiper/css/effect-coverflow";
  import "swiper/css/effect-cube";
  import "swiper/css/effect-flip";
  import "swiper/css/effect-cards";

  // Tabs: click a label -> activate its panel. Event-delegated on document
  // so one listener covers every .ds-tabs instance on the page (Astro
  // bundles this <script> once per page regardless of how many SectionBlock
  // instances render), no per-instance re-init needed.
  document.addEventListener("click", (e) => {
    const label = (e.target as HTMLElement).closest(".ds-tabs-label") as HTMLElement | null;
    if (!label) return;
    const tabs = label.closest(".ds-tabs");
    if (!tabs) return;
    const idx = label.dataset.idx;
    tabs.querySelectorAll(".ds-tabs-label").forEach((el) => el.classList.remove("is-active"));
    tabs.querySelectorAll(".ds-tabs-panel").forEach((el) => el.classList.remove("is-active"));
    label.classList.add("is-active");
    tabs.querySelector(`.ds-tabs-panel[data-idx="${idx}"]`)?.classList.add("is-active");
  });

  // Announcement bar: dismiss button just hides the bar for this page view —
  // no cookie/localStorage persistence (reappears on reload), same
  // static-site-with-a-little-JS convention as tabs above.
  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest(".ds-announcementbar-close") as HTMLElement | null;
    if (!btn) return;
    btn.closest(".ds-announcementbar")?.remove();
  });

  // Google Map (requireConsent="true" only): the real embed src lives in a
  // data attribute, never in a live src, until this click — same "consent
  // gate, no cookie/localStorage" shape as the announcement bar's own
  // dismiss above, just gating a load instead of hiding a bar.
  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest(".ds-map-consent-btn") as HTMLElement | null;
    if (!btn) return;
    const holder = btn.closest<HTMLElement>(".ds-map-consent");
    const src = holder?.dataset.mapSrc;
    if (!holder || !src) return;
    const iframe = document.createElement("iframe");
    iframe.className = "ds-map-frame";
    iframe.src = src;
    iframe.loading = "lazy";
    iframe.referrerPolicy = "strict-origin-when-cross-origin";
    iframe.style.height = holder.style.height;
    holder.replaceWith(iframe);
  });

  // Slider: Swiper (headless-enough, real 3D effect modules — see
  // package.json) drives drag/swipe/momentum/looping/effects; this just
  // wires our own prev/next/dot buttons + an optional autoplay plugin
  // (data-autoplay = ms, set only when the author picked something other
  // than "off") to its API instead of hand-rolling scroll math.
  // wrapperClass/slideClass point Swiper at our own existing
  // .ds-slider-track/.ds-slide instead of its default swiper-wrapper/
  // swiper-slide, so no markup fork was needed to adopt it.
  const EFFECT_MODULES: Record<string, typeof EffectCoverflow | undefined> = {
    coverflow: EffectCoverflow,
    cube: EffectCube,
    flip: EffectFlip,
    cards: EffectCards,
  };
  document.querySelectorAll<HTMLElement>(".ds-slider").forEach((slider) => {
    // Dataset (autoplay/transition/layout knobs) lives on .ds-slider-box,
    // not this outer element — .ds-slider itself only wraps it plus an
    // optional "outside"-placement pagination strip (see the component
    // above), so it stays a plain auto-height box with no dataset of its
    // own. .ds-slider-dot lookups stay scoped to the outer element though,
    // since outside-mode dots render as its sibling, not the box's.
    const box = slider.querySelector<HTMLElement>(".ds-slider-box");
    const viewport = slider.querySelector<HTMLElement>(".ds-slider-viewport");
    const dots = Array.from(slider.querySelectorAll<HTMLElement>(".ds-slider-dot"));
    if (!box || !viewport) return;
    const autoplayMs = Number(box.dataset.autoplay || "0");
    const transition = box.dataset.transition || "slide";

    // transition="fade": a real crossfade needs slides stacked absolutely
    // (CSS above), which Swiper's own EffectFade also does, but this
    // hand-rolled version predates the Swiper switch and still works fine —
    // no reason to churn it just to route through another module.
    if (transition === "fade") {
      const slides = Array.from(slider.querySelectorAll<HTMLElement>(".ds-slide"));
      let idx = 0;
      const show = (next: number) => {
        idx = ((next % slides.length) + slides.length) % slides.length;
        slides.forEach((s, si) => s.classList.toggle("is-active-fade", si === idx));
        dots.forEach((d, di) => d.classList.toggle("is-active", di === idx));
      };
      slider.querySelector(".ds-slider-prev")?.addEventListener("click", () => show(idx - 1));
      slider.querySelector(".ds-slider-next")?.addEventListener("click", () => show(idx + 1));
      dots.forEach((d, di) => d.addEventListener("click", () => show(di)));
      show(0);
      if (autoplayMs > 0) setInterval(() => show(idx + 1), autoplayMs);
      return;
    }

    const effectModule = EFFECT_MODULES[transition];
    // A 3D effect (coverflow/cube/flip/cards) only ever makes sense one
    // slide at a time — force 1 rather than let a leftover slidesPerView>1/
    // slidesRows>1 (e.g. author switches transition after already setting
    // columns) render a broken multi-slide cube/flip.
    const slidesPerView = effectModule ? 1 : Math.max(1, Number(box.dataset.slidesPerView) || 1);
    const slidesPerGroup = effectModule ? 1 : Math.max(1, Number(box.dataset.slidesPerGroup) || 1);
    const rows = effectModule ? 1 : Math.max(1, Number(box.dataset.slidesRows) || 1);
    const spaceBetweenAttr = box.dataset.spaceBetween;
    const spaceBetween = spaceBetweenAttr && Number.isFinite(Number(spaceBetweenAttr)) ? Number(spaceBetweenAttr) : slidesPerView > 1 ? 16 : 0;
    const swiper = new Swiper(viewport, {
      modules: [Autoplay, ...(effectModule ? [effectModule] : []), ...(rows > 1 ? [Grid] : [])],
      wrapperClass: "ds-slider-track",
      slideClass: "ds-slide",
      loop: true,
      direction: box.dataset.direction === "vertical" ? "vertical" : "horizontal",
      effect: effectModule ? transition : "slide",
      centeredSlides: transition === "coverflow" || box.dataset.centeredSlides === "true",
      slidesPerView,
      slidesPerGroup,
      ...(rows > 1 ? { grid: { rows, fill: "row" } } : {}),
      spaceBetween,
      initialSlide: Math.max(0, Number(box.dataset.initialSlide) || 0),
      autoHeight: box.dataset.autoHeight === "true",
      grabCursor: box.dataset.grabCursor !== "false",
      slideToClickedSlide: box.dataset.slideToClicked === "true",
      autoplay: autoplayMs > 0 ? { delay: autoplayMs, disableOnInteraction: false } : false,
    });
    const updateDots = () => dots.forEach((d, di) => d.classList.toggle("is-active", di === swiper.realIndex));
    slider.querySelector(".ds-slider-prev")?.addEventListener("click", () => swiper.slidePrev());
    slider.querySelector(".ds-slider-next")?.addEventListener("click", () => swiper.slideNext());
    dots.forEach((d, di) => d.addEventListener("click", () => swiper.slideToLoop(di)));
    swiper.on("slideChange", updateDots);
    updateDots();
  });
</script>
