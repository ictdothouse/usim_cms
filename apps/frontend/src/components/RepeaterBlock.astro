---
// "Batch of simple no-backend elements" (audit report 5.2/5.7), extracted
// verbatim out of SectionBlock.astro's own switch (god-file breakup, see
// SectionBlock.astro's top-of-file comment on why shared *logic* goes
// through lib/element-render.ts, never another .astro file's frontmatter).
// None of these element types read blockIndex/r/c/e/designerEdit — unlike
// ContainerBlock/SliderBlock, this one only ever needs `el` itself.
import { ICON_PATHS, safeUrl, cls, marginStyle, paddingStyle, elBorderShadowStyle } from "../lib/element-render";

// Local, not imported from SectionBlock.astro's frontmatter — see that
// file's top comment on the outage caused by sharing frontmatter bindings
// across .astro files. Same duplication convention as ContainerBlock.astro's
// own local buildSrcset/parseRepeaterItems copies.
const SRCSET_WIDTHS = [400, 800, 1200, 1600];
function buildSrcset(url: string): { srcset: string; sizes: string } | null {
  const m = /[?&]w=(\d+)/.exec(url);
  if (!m) return null;
  const width = Number(m[1]);
  const base = url.split("?")[0];
  const dot = base.lastIndexOf(".");
  const stem = dot === -1 ? base : base.slice(0, dot);
  const candidates = SRCSET_WIDTHS.filter((w) => w < width);
  if (candidates.length === 0) return null;
  const entries = [...candidates.map((w) => `${stem}-${w}w.webp ${w}w`), `${base} ${width}w`];
  return { srcset: entries.join(", "), sizes: "(min-width: 1024px) 800px, 100vw" };
}
function parseRepeaterItems(raw: string | undefined): Record<string, string>[] {
  if (!raw) return [];
  try {
    const parsed: unknown = JSON.parse(raw);
    if (!Array.isArray(parsed)) return [];
    return parsed.map((item) => {
      const o = (item ?? {}) as Record<string, unknown>;
      const out: Record<string, string> = {};
      for (const k of Object.keys(o)) {
        if (typeof o[k] === "string") out[k] = o[k] as string;
      }
      return out;
    });
  } catch {
    return [];
  }
}

interface El {
  type: string;
  props?: Record<string, string>;
  bp?: Record<string, string>;
}
interface Props {
  el: El;
  blockIndex: number;
  r: number;
  c: number;
  e: number;
}
const { el, blockIndex, r, c, e } = Astro.props as Props;
const p = el.props ?? {};

// Real base margin/padding/border/shadow (never applied at all for these 8
// repeater-shaped types before — not just a bp gap, the desktop value itself
// was silently dropped since none of these cases called marginStyle/
// paddingStyle/elBorderShadowStyle) plus the matching per-breakpoint
// override — same bpStyleRules mechanism ElementBlock.astro/ContainerBlock.
// astro/SymbolBlock.astro use for theirs (duplicated here rather than
// shared, this codebase's established convention).
const elId = `e${blockIndex}-${r}-${c}-${e}`;
const boxStyle = (mp: Record<string, string>) => [marginStyle(mp), paddingStyle(mp), elBorderShadowStyle(mp)].filter(Boolean).join(";");
const responsiveRules: string[] = [];
function bpMerge(base: Record<string, string>, bp: Record<string, string>, tier: "tablet" | "mobile"): Record<string, string> {
  const prefix = `${tier}:`;
  const merged = { ...base };
  for (const [k, v] of Object.entries(bp)) {
    if (k.startsWith(prefix)) merged[k.slice(prefix.length)] = v;
  }
  return merged;
}
function bpStyleRules(selector: string, bp: Record<string, string>, base: Record<string, string>, build: (p: Record<string, string>) => string): string[] {
  const out: string[] = [];
  for (const tier of ["tablet", "mobile"] as const) {
    if (!Object.keys(bp).some((k) => k.startsWith(`${tier}:`))) continue;
    const css = build(bpMerge(base, bp, tier));
    if (!css) continue;
    const important = css
      .split(";")
      .filter(Boolean)
      .map((decl) => `${decl} !important`)
      .join(";");
    const media = tier === "tablet" ? "(min-width:641px) and (max-width:1024px)" : "(max-width:640px)";
    out.push(`@media ${media}{${selector}{${important}}}`);
  }
  return out;
}
const REPEATER_SELECTOR: Record<string, string> = {
  testimonial: ".ds-testimonial-grid",
  statscounter: ".ds-statscounter",
  peoplegrid: ".ds-peoplegrid",
  socialicons: ".ds-socialicons",
  logocloud: ".ds-logocloud",
  timeline: ".ds-timeline",
  documentdownload: ".ds-docdownload",
  announcementticker: ".ds-ticker",
};
if (el.bp && Object.keys(el.bp).length > 0 && REPEATER_SELECTOR[el.type]) {
  responsiveRules.push(...bpStyleRules(`[data-vis="${elId}"] ${REPEATER_SELECTOR[el.type]}`, el.bp, p, boxStyle));
}
---

{(() => {
switch (el.type) {
  case "testimonial": {
    const items = parseRepeaterItems(p.testimonials);
    if (items.length === 0) return null;
    return (
      <div class={cls("ds-testimonial-grid", p.cssClass)} style={`grid-template-columns:repeat(${p.columns ?? "2"},1fr);${boxStyle(p)}`}>
        {items.map((it) => {
          const avatarSrc = it.avatar ? safeUrl(it.avatar) : undefined;
          const avatarSrcset = avatarSrc ? buildSrcset(avatarSrc) : null;
          return (
          <div class="ds-testimonial-card">
            {it.quote && <p class="ds-testimonial-quote">“{it.quote}”</p>}
            <div class="ds-testimonial-person">
              {avatarSrc && <img src={avatarSrc} srcset={avatarSrcset?.srcset} sizes={avatarSrcset ? avatarSrcset.sizes : undefined} alt="" loading="lazy" />}
              <div>
                {it.name && <p class="ds-testimonial-name">{it.name}</p>}
                {(it.role || it.meta) && (
                  <p class="ds-testimonial-meta">{[it.role, it.meta].filter(Boolean).join(" · ")}</p>
                )}
              </div>
            </div>
          </div>
          );
        })}
      </div>
    );
  }
  case "statscounter": {
    const items = parseRepeaterItems(p.stats);
    if (items.length === 0) return null;
    return (
      <div class={cls("ds-statscounter", p.cssClass)} style={`grid-template-columns:repeat(${p.columns ?? "3"},1fr);${boxStyle(p)}`}>
        {items.map((it) => {
          const path = ICON_PATHS[it.icon ?? ""] ?? ICON_PATHS["bar-chart"];
          return (
            <div class="ds-stat">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d={path} />
              </svg>
              <p class="ds-stat-number">{it.number}</p>
              {it.label && <p class="ds-stat-label">{it.label}</p>}
            </div>
          );
        })}
      </div>
    );
  }
  case "peoplegrid": {
    const items = parseRepeaterItems(p.people);
    if (items.length === 0) return null;
    return (
      <div class={cls("ds-peoplegrid", p.cssClass)} style={`grid-template-columns:repeat(${p.columns ?? "3"},1fr);${boxStyle(p)}`}>
        {items.map((it) => {
          const photoSrc = it.photo ? safeUrl(it.photo) : undefined;
          const photoSrcset = photoSrc ? buildSrcset(photoSrc) : null;
          const card = (
            <>
              {photoSrc && <img src={photoSrc} srcset={photoSrcset?.srcset} sizes={photoSrcset ? photoSrcset.sizes : undefined} alt="" loading="lazy" />}
              <p class="ds-people-name">{it.name}</p>
              {it.role && <p class="ds-people-role">{it.role}</p>}
              {it.department && <p class="ds-people-dept">{it.department}</p>}
              {(it.email || it.phone) && (
                <p class="ds-people-contact">
                  {it.email && <a href={`mailto:${it.email}`}>{it.email}</a>}
                  {it.phone && <a href={`tel:${it.phone}`}>{it.phone}</a>}
                </p>
              )}
            </>
          );
          return it.href && safeUrl(it.href) ? (
            <a class="ds-people-card" href={safeUrl(it.href)}>{card}</a>
          ) : (
            <div class="ds-people-card">{card}</div>
          );
        })}
      </div>
    );
  }
  case "socialicons": {
    const items = parseRepeaterItems(p.socials);
    if (items.length === 0) return null;
    return (
      <div
        class={cls("ds-socialicons", p.cssClass)}
        style={[p.align ? `justify-content:${p.align === "center" ? "center" : p.align === "right" ? "flex-end" : "flex-start"}` : null, boxStyle(p)].filter(Boolean).join(";")}
      >
        {items.map((it) => {
          const href = safeUrl(it.url) ?? "#";
          const path = ICON_PATHS[it.platform ?? ""] ?? ICON_PATHS.globe;
          return (
            <a class="ds-socialicon" href={href} aria-label={it.platform ?? "social"}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d={path} />
              </svg>
            </a>
          );
        })}
      </div>
    );
  }
  case "logocloud": {
    const items = parseRepeaterItems(p.logos);
    if (items.length === 0) return null;
    return (
      <div class={cls("ds-logocloud", p.cssClass)} style={`grid-template-columns:repeat(${p.columns ?? "4"},1fr);${boxStyle(p)}`}>
        {items.map((it) => {
          const src = it.image ? safeUrl(it.image) : undefined;
          if (!src) return null;
          const logoSrcset = buildSrcset(src);
          const img = <img src={src} srcset={logoSrcset?.srcset} sizes={logoSrcset ? logoSrcset.sizes : undefined} alt={it.alt ?? ""} loading="lazy" />;
          return it.href && safeUrl(it.href) ? <a href={safeUrl(it.href)}>{img}</a> : img;
        })}
      </div>
    );
  }
  case "timeline": {
    const items = parseRepeaterItems(p.timelineItems);
    if (items.length === 0) return null;
    return (
      <div class={cls("ds-timeline", p.cssClass)} style={boxStyle(p) || undefined}>
        {items.map((it) => (
          <div class="ds-timeline-item">
            {it.date && <p class="ds-timeline-date">{it.date}</p>}
            {it.title && <p class="ds-timeline-title">{it.title}</p>}
            {it.description && <p class="ds-timeline-desc">{it.description}</p>}
          </div>
        ))}
      </div>
    );
  }
  case "documentdownload": {
    const items = parseRepeaterItems(p.documents);
    if (items.length === 0) return null;
    return (
      <div class={cls("ds-docdownload", p.cssClass)} style={`grid-template-columns:repeat(${p.columns ?? "2"},1fr);${boxStyle(p)}`}>
        {items.map((it) => {
          const href = it.fileUrl ? safeUrl(it.fileUrl) : undefined;
          if (!href) return null;
          return (
            <a class="ds-doc-card" href={href} download>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d={ICON_PATHS["file-text"]} />
              </svg>
              <span>
                <span class="ds-doc-label">{it.label || "Document"}</span>
                {(it.fileType || it.fileSize) && (
                  <span class="ds-doc-meta">{[it.fileType, it.fileSize].filter(Boolean).join(" · ")}</span>
                )}
              </span>
            </a>
          );
        })}
      </div>
    );
  }
  case "announcementticker": {
    const items = parseRepeaterItems(p.tickerItems);
    if (items.length === 0) return null;
    const speedS = { slow: 40, normal: 25, fast: 12 }[p.speed ?? "normal"] ?? 25;
    return (
      <div
        class={cls("ds-ticker", p.cssClass)}
        style={[`background:${p.bgColor || "#111827"}`, `color:${p.textColor || "#ffffff"}`, boxStyle(p)].filter(Boolean).join(";")}
      >
        <div class="ds-ticker-track" style={`animation-duration:${speedS}s`}>
          {[...items, ...items].map((it) =>
            it.href && safeUrl(it.href) ? (
              <a class="ds-ticker-item" href={safeUrl(it.href)}>{it.text}</a>
            ) : (
              <span class="ds-ticker-item">{it.text}</span>
            ),
          )}
        </div>
      </div>
    );
  }
  default:
    return null;
}
})()}
{responsiveRules.length > 0 && <style set:html={responsiveRules.join("")} />}

<style>
  /* Byte-for-byte copies of the matching rules in SectionBlock.astro's own
     <style> — Astro's scoped-CSS attribute only covers markup written in
     THIS file's own template, so a class defined only in SectionBlock's
     style never applies to markup rendered by this component (same gap
     ContainerBlock.astro/SliderBlock.astro hit — see their own comments and
     the fix commit that added their <style> blocks). SectionBlock no longer
     renders any of these element types itself, so no duplicate copies are
     left there for this batch. */
  .ds-testimonial-grid {
    display: grid;
    gap: 1.5rem;
  }
  .ds-testimonial-card {
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 0.75rem;
    padding: 1.25rem;
  }
  .ds-testimonial-quote {
    margin: 0 0 1rem;
    line-height: 1.6;
    font-style: italic;
  }
  .ds-testimonial-person {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .ds-testimonial-person img {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    object-fit: cover;
  }
  .ds-testimonial-name {
    margin: 0;
    font-weight: 700;
  }
  .ds-testimonial-meta {
    margin: 0;
    font-size: 0.85rem;
    opacity: 0.7;
  }
  .ds-statscounter {
    display: grid;
    gap: 1.5rem;
    text-align: center;
  }
  .ds-stat svg {
    margin: 0 auto 0.5rem;
    opacity: 0.85;
  }
  .ds-stat-number {
    margin: 0;
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 800;
  }
  .ds-stat-label {
    margin: 0;
    font-size: 0.9rem;
    opacity: 0.75;
  }
  .ds-peoplegrid {
    display: grid;
    gap: 1.5rem;
  }
  .ds-people-card {
    display: block;
    text-align: center;
    color: inherit;
    text-decoration: none;
  }
  .ds-people-card img {
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto 0.5rem;
  }
  .ds-people-name {
    margin: 0;
    font-weight: 700;
  }
  .ds-people-role,
  .ds-people-dept {
    margin: 0.15rem 0 0;
    font-size: 0.85rem;
    opacity: 0.75;
  }
  .ds-people-contact {
    margin: 0.4rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.8rem;
  }
  .ds-people-contact a {
    color: inherit;
  }
  .ds-socialicons {
    display: flex;
    gap: 0.75rem;
  }
  .ds-socialicon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid currentColor;
    color: inherit;
  }
  .ds-logocloud {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .ds-logocloud img {
    max-width: 100%;
    max-height: 3rem;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.7;
    transition: filter 0.2s, opacity 0.2s;
  }
  .ds-logocloud img:hover,
  .ds-logocloud a:hover img {
    filter: none;
    opacity: 1;
  }
  .ds-timeline {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    border-left: 2px solid rgba(0, 0, 0, 0.15);
    padding-left: 1.25rem;
  }
  .ds-timeline-date {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 700;
    opacity: 0.7;
  }
  .ds-timeline-title {
    margin: 0.1rem 0 0;
    font-weight: 700;
  }
  .ds-timeline-desc {
    margin: 0.25rem 0 0;
    line-height: 1.6;
    opacity: 0.85;
  }
  .ds-docdownload {
    display: grid;
    gap: 1rem;
  }
  .ds-doc-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 0.75rem;
    padding: 0.9rem 1.1rem;
    color: inherit;
    text-decoration: none;
  }
  .ds-doc-label {
    display: block;
    font-weight: 700;
  }
  .ds-doc-meta {
    display: block;
    font-size: 0.8rem;
    opacity: 0.7;
  }
  .ds-ticker {
    overflow: hidden;
    padding: 0.6rem 0;
  }
  .ds-ticker-track {
    display: flex;
    width: max-content;
    gap: 3rem;
    animation: ds-ticker-scroll linear infinite;
  }
  .ds-ticker-item {
    white-space: nowrap;
    color: inherit;
    text-decoration: none;
    font-size: 0.9rem;
  }
  @keyframes ds-ticker-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (max-width: 768px) {
    .ds-testimonial-grid,
    .ds-statscounter,
    .ds-peoplegrid,
    .ds-logocloud,
    .ds-docdownload {
      grid-template-columns: 1fr !important;
    }
  }
</style>
