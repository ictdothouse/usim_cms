---
// Recursive container (Webflow/Figma-style nested-anywhere box) render
// branch, extracted verbatim out of SectionBlock.astro's "container" case
// (god-file breakup, see SectionBlock.astro's own top-of-file comment on why
// shared *logic* goes through lib/element-render.ts, never another .astro
// file's frontmatter). v1 scope, curated child types only (mirrors
// SectionBlock.astro's own renderSlideEl curated set), no real
// per-breakpoint style override for children yet (admin-preview-only there,
// same as most Element bp — see apps/admin/CLAUDE.md's "Recursive Container
// element" section).
import {
  SPACE,
  ICON_PATHS,
  TEXT_SIZE,
  fluidTextSize,
  safeUrl,
  renderInline,
  lengthValue,
  marginStyle,
  paddingStyle,
  elBorderShadowStyle,
  typoStyle,
  elHoverClass,
  elEntranceClass,
  elRadius,
  cls,
  headingTag,
} from "../lib/element-render";

// Local, not imported from SectionBlock.astro's frontmatter — see that
// file's top comment on the outage caused by sharing frontmatter bindings
// across .astro files. Both are small enough to duplicate rather than
// promote into lib/element-render.ts, which is out of scope for this
// extraction (SectionBlock.astro's own copies are untouched).
const ICON_SIZE: Record<string, string> = { sm: "1rem", md: "1.5rem", lg: "2.25rem", xl: "3rem" };
const SRCSET_WIDTHS = [400, 800, 1200, 1600];
function buildSrcset(url: string): { srcset: string; sizes: string } | null {
  const m = /[?&]w=(\d+)/.exec(url);
  if (!m) return null;
  const width = Number(m[1]);
  const base = url.split("?")[0];
  const dot = base.lastIndexOf(".");
  const stem = dot === -1 ? base : base.slice(0, dot);
  const candidates = SRCSET_WIDTHS.filter((w) => w < width);
  const srcset = [...candidates.map((w) => `${stem}-${w}w.webp ${w}w`), `${url} ${width}w`].join(", ");
  return { srcset, sizes: "(max-width: 768px) 100vw, 50vw" };
}

interface El {
  id?: string;
  type: string;
  props?: Record<string, string>;
  bp?: Record<string, string>;
  children?: El[];
}

interface Props {
  el: El;
  blockIndex: number;
  r: number;
  c: number;
  e: number;
  designerEdit?: boolean;
}
const { el, blockIndex, r, c, e, designerEdit = false } = Astro.props as Props;
const p = el.props ?? {};
---

{(() => {
// JSX only parses inside the template section's `{}` expressions, never in
// the frontmatter above the closing "---" — renderContainerChild has to
// live in here (an IIFE, same trick as SectionBlock.astro's own renderSlideEl)
// rather than up there with the plain helpers.
const renderContainerChild = (child: El, childPath: string): unknown => {
  const cp = child.props ?? {};
  switch (child.type) {
    case "heading": {
      const Tag = headingTag(cp.level) as "h1";
      return (
        <Tag
          class={cls("ds-h", `ds-h${cp.level ?? "2"}`, cp.cssClass, elHoverClass(cp), elEntranceClass(cp))}
          data-designer-path={designerEdit ? childPath : undefined}
          style={[cp.align ? `text-align:${cp.align}` : null, marginStyle(cp), paddingStyle(cp), typoStyle(cp), elBorderShadowStyle(cp)]
            .filter(Boolean)
            .join(";")}
          set:html={cp.text ? renderInline(cp.text) : ""}
        />
      );
    }
    case "text":
      return (
        <p
          class={cls("ds-text", cp.cssClass, elHoverClass(cp), elEntranceClass(cp))}
          data-designer-path={designerEdit ? childPath : undefined}
          style={[
            `font-size:${fluidTextSize(lengthValue(cp.size, TEXT_SIZE, TEXT_SIZE.md))}`,
            cp.align ? `text-align:${cp.align}` : null,
            marginStyle(cp),
            paddingStyle(cp),
            typoStyle(cp),
            elBorderShadowStyle(cp),
          ]
            .filter(Boolean)
            .join(";")}
          set:html={renderInline(cp.text ?? "")}
        />
      );
    case "image": {
      const cpSrc = safeUrl(cp.src);
      const cpSrcset = cpSrc ? buildSrcset(cpSrc) : null;
      return cpSrc ? (
        <img
          class={cls("ds-img", cp.cssClass, elHoverClass(cp), elEntranceClass(cp))}
          data-designer-path={designerEdit ? childPath : undefined}
          src={cpSrc}
          srcset={cpSrcset?.srcset}
          sizes={cpSrcset ? cpSrcset.sizes : undefined}
          alt={cp.alt ?? ""}
          loading="lazy"
          style={[`border-radius:${elRadius(cp)}`, cp.imgWidth ? `width:${cp.imgWidth}` : null, marginStyle(cp), paddingStyle(cp), elBorderShadowStyle(cp)]
            .filter(Boolean)
            .join(";")}
        />
      ) : null;
    }
    case "button":
      return cp.label ? (
        <div
          data-designer-path={designerEdit ? childPath : undefined}
          style={[cp.align ? `text-align:${cp.align}` : null, marginStyle(cp), paddingStyle(cp)].filter(Boolean).join(";")}
        >
          <a
            class={cls(cp.variant === "outline" ? "ds-btn ds-btn-outline" : "ds-btn ds-btn-primary", cp.cssClass, elHoverClass(cp), elEntranceClass(cp))}
            href={safeUrl(cp.href) ?? "#"}
            style={[cp.color ? `color:${cp.color}` : null, elBorderShadowStyle(cp)].filter(Boolean).join(";") || undefined}
          >
            {cp.label}
          </a>
        </div>
      ) : null;
    case "badge": {
      const badgeIconPath = cp.name ? ICON_PATHS[cp.name] : undefined;
      const badgeIconSize = { sm: "14", md: "16", lg: "20" }[cp.scale ?? "md"] ?? "16";
      return (
        <div
          data-designer-path={designerEdit ? childPath : undefined}
          style={[cp.align ? `text-align:${cp.align}` : null, marginStyle(cp), paddingStyle(cp)].filter(Boolean).join(";")}
        >
          <span class={cls(`ds-badge ds-badge-${cp.variant || "soft"} ds-badge-${cp.scale || "md"}`, cp.cssClass)} style={cp.color ? `color:${cp.color}` : undefined}>
            {badgeIconPath && (
              <svg width={badgeIconSize} height={badgeIconSize} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d={badgeIconPath} />
              </svg>
            )}
            {cp.label}
          </span>
        </div>
      );
    }
    case "spacer":
      return <div data-designer-path={designerEdit ? childPath : undefined} style={`height:${lengthValue(cp.height, SPACE, SPACE.md)}`} />;
    case "divider":
      return <hr data-designer-path={designerEdit ? childPath : undefined} class="ds-divider" style={[marginStyle(cp), paddingStyle(cp)].filter(Boolean).join(";")} />;
    case "icon": {
      const iconPath = ICON_PATHS[cp.name ?? "check"] ?? ICON_PATHS.check;
      const iconSize = lengthValue(cp.size, ICON_SIZE, ICON_SIZE.md);
      return (
        <div
          data-designer-path={designerEdit ? childPath : undefined}
          style={[cp.align ? `text-align:${cp.align}` : null, marginStyle(cp), paddingStyle(cp)].filter(Boolean).join(";")}
        >
          <svg width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="none" stroke={cp.color || "currentColor"} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d={iconPath} />
          </svg>
        </div>
      );
    }
    case "container": {
      const grandchildren = child.children ?? [];
      return (
        <div
          data-designer-path={designerEdit ? childPath : undefined}
          style={[
            "display:flex",
            `flex-direction:${cp.flexDirection || "row"}`,
            `justify-content:${cp.justifyContent || "flex-start"}`,
            `align-items:${cp.alignItems || "stretch"}`,
            `flex-wrap:${cp.flexWrap || "wrap"}`,
            `gap:${cp.gap || "1rem"}`,
            cp.bg ? `background:${cp.bg}` : null,
            `border-radius:${elRadius(cp)}`,
            marginStyle(cp),
            paddingStyle(cp),
            elBorderShadowStyle(cp),
          ]
            .filter(Boolean)
            .join(";")}
        >
          {grandchildren.map((gc, gi) => renderContainerChild(gc, `${childPath}.${gi}`))}
        </div>
      );
    }
    default:
      return null;
  }
};
const elDottedPath = `${blockIndex}.${r}.${c}.${e}`;
return (
  <div
    class={p.cssClass}
    style={[
      "display:flex",
      `flex-direction:${p.flexDirection || "row"}`,
      `justify-content:${p.justifyContent || "flex-start"}`,
      `align-items:${p.alignItems || "stretch"}`,
      `flex-wrap:${p.flexWrap || "wrap"}`,
      `gap:${p.gap || "1rem"}`,
      p.bg ? `background:${p.bg}` : null,
      `border-radius:${elRadius(p)}`,
      marginStyle(p),
      paddingStyle(p),
      elBorderShadowStyle(p),
    ]
      .filter(Boolean)
      .join(";")}
  >
    {(el.children ?? []).map((child, i) => renderContainerChild(child, `${elDottedPath}.${i}`))}
  </div>
);
})()}

<style>
  /* Byte-for-byte copies of the matching rules in SectionBlock.astro's own
     <style> — Astro's scoped-CSS attribute only covers markup written in
     THIS file's own template, so a class defined only in SectionBlock's
     style never applies to markup rendered by this component (confirmed
     against the compiled build: this component's output never carries the
     scoping attribute SectionBlock's CSS selectors require). SectionBlock
     keeps its own copies too, for the elements it still renders directly. */
  .ds-h {
    margin: 0;
    line-height: 1.2;
    font-weight: 700;
  }
  .ds-h1 { font-size: clamp(2rem, 5vw, 3rem); }
  .ds-h2 { font-size: clamp(1.6rem, 4vw, 2.25rem); }
  .ds-h3 { font-size: clamp(1.3rem, 3.2vw, 1.5rem); }
  .ds-h4 { font-size: clamp(1.1rem, 2.6vw, 1.2rem); }
  .ds-text {
    margin: 0;
    line-height: 1.7;
    white-space: pre-wrap;
  }
  .ds-img {
    max-width: 100%;
    height: auto;
    display: block;
  }
  .ds-btn {
    display: inline-block;
    padding: 0.65em 1.6em;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .ds-btn:hover {
    opacity: 0.85;
  }
  .ds-btn-primary {
    background: var(--color-primary, #0f62fe);
    color: var(--color-primary-content, #fff);
  }
  .ds-btn-outline {
    border: 2px solid currentColor;
    color: inherit;
  }
  .ds-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    border-radius: 9999px;
    font-weight: 600;
  }
  .ds-badge-sm {
    padding: 0.1em 0.6em;
    font-size: 0.7rem;
  }
  .ds-badge-md {
    padding: 0.15em 0.75em;
    font-size: 0.8rem;
  }
  .ds-badge-lg {
    padding: 0.2em 0.9em;
    font-size: 0.9rem;
  }
  .ds-badge-filled {
    background: var(--color-primary, #0f62fe);
    color: var(--color-primary-content, #fff);
  }
  .ds-badge-outline {
    border: 1.5px solid currentColor;
    color: inherit;
  }
  .ds-badge-soft {
    background: color-mix(in srgb, var(--color-primary, #0f62fe) 15%, transparent);
    color: var(--color-primary, #0f62fe);
  }
  .ds-divider {
    border: none;
    border-top: 1px solid currentColor;
    opacity: 0.2;
    margin: 0;
  }
</style>
