---
// Recursive container (Webflow/Figma-style nested-anywhere box) render
// branch, extracted out of SectionBlock.astro's "container" case (god-file
// breakup, see SectionBlock.astro's own top-of-file comment on why shared
// *logic* goes through lib/element-render.ts, never another .astro file's
// frontmatter). A child of any element type renders through the same leaf
// component and display:contents wrapper SectionBlock.astro gives a
// top-level element (2026-10-15 — was a curated 9-type subset rendered
// inline), so a nested "N Columns" (a row container of `grow` column
// containers) holds anything a column does, and Live Edit's placeholders,
// double-click text edit and drag reach every child.
import ElementBlock from "./ElementBlock.astro";
import MiscBlock from "./MiscBlock.astro";
import SliderBlock from "./SliderBlock.astro";
import MenuBlock from "./MenuBlock.astro";
import SymbolBlock from "./SymbolBlock.astro";
import PostListBlock from "./PostListBlock.astro";
import EventListBlock from "./EventListBlock.astro";
import RepeaterBlock from "./RepeaterBlock.astro";
import { marginStyle, paddingStyle, elBorderShadowStyle, elRadius, cls } from "../lib/element-render";
import { flexWrapFor } from "@ucms/element-render";

interface El {
  id?: string;
  type: string;
  props?: Record<string, string>;
  bp?: Record<string, string>;
  children?: El[];
}

interface Props {
  el: El;
  elId: string;
  blockIndex: number;
  r: number;
  c: number;
  e: number;
  designerEdit?: boolean;
  // Menu/post list/event list/symbol children fetch per tenant + language.
  tenantHost?: string;
  requestedLang?: string | null;
}
const { el, elId, blockIndex, r, c, e, designerEdit = false, tenantHost = "", requestedLang = null } = Astro.props as Props;
const p = el.props ?? {};

// A container child's data-vis id is the container's own `elId` plus its
// child indexes (`visId` below), not its dotted `childPath`: that path
// restarts at 0 in the header and footer too. Local bpMerge/bpStyleRules,
// not shared — this codebase's established duplication convention (see the
// top comment).
const responsiveRules: string[] = [];
function bpMerge(base: Record<string, string>, bp: Record<string, string>, tier: "tablet" | "mobile"): Record<string, string> {
  const prefix = `${tier}:`;
  const merged = { ...base };
  for (const [k, v] of Object.entries(bp)) {
    if (k.startsWith(prefix)) merged[k.slice(prefix.length)] = v;
  }
  return merged;
}
function bpStyleRules(selector: string, bp: Record<string, string>, base: Record<string, string>, build: (p: Record<string, string>) => string): string[] {
  const out: string[] = [];
  for (const tier of ["tablet", "mobile"] as const) {
    if (!Object.keys(bp).some((k) => k.startsWith(`${tier}:`))) continue;
    const css = build(bpMerge(base, bp, tier));
    if (!css) continue;
    const important = css
      .split(";")
      .filter(Boolean)
      .map((decl) => `${decl} !important`)
      .join(";");
    const media = tier === "tablet" ? "(min-width:641px) and (max-width:1024px)" : "(max-width:640px)";
    out.push(`@media ${media}{${selector}{${important}}}`);
  }
  return out;
}
const spacingCss = (cp: Record<string, string>) => [marginStyle(cp), paddingStyle(cp)].filter(Boolean).join(";");
// The Inspector's VisibilityToggle on a child — same @media rules as
// SectionBlock.astro's respId. True when the child needs its data-vis id.
function hideRules(cp: Record<string, string>, visId: string): boolean {
  const sel = `[data-vis="${visId}"]`;
  if (cp.hideDesktop === "true") responsiveRules.push(`@media (min-width:1025px){${sel}{display:none!important}}`);
  if (cp.hideTablet === "true") responsiveRules.push(`@media (min-width:641px) and (max-width:1024px){${sel}{display:none!important}}`);
  if (cp.hideMobile === "true") responsiveRules.push(`@media (max-width:640px){${sel}{display:none!important}}`);
  return cp.hideDesktop === "true" || cp.hideTablet === "true" || cp.hideMobile === "true";
}
// `grow` (a nested "N Columns" column's width share) only means something
// on a nested box, inside its row-direction parent. The min width makes a
// row too narrow for its columns wrap them onto their own lines — that's
// what stacks nested columns on mobile.
// ponytail: fixed 15rem floor; a per-container min-width field if slim side-by-side columns in a narrow parent are ever needed.
function boxStyle(cp: Record<string, string>, nested: boolean): string {
  return [
    "display:flex",
    `flex-direction:${cp.flexDirection || "row"}`,
    `justify-content:${cp.justifyContent || "flex-start"}`,
    `align-items:${cp.alignItems || "stretch"}`,
    `flex-wrap:${flexWrapFor(cp.flexDirection, cp.flexWrap)}`,
    `gap:${cp.gap || "1rem"}`,
    nested && cp.grow ? `flex:${cp.grow} 1 0%;min-width:min(15rem,100%)` : null,
    cp.bg ? `background:${cp.bg}` : null,
    `border-radius:${elRadius(cp)}`,
    marginStyle(cp),
    paddingStyle(cp),
    elBorderShadowStyle(cp),
  ]
    .filter(Boolean)
    .join(";");
}
---

{(() => {
// JSX only parses inside the template section's `{}` expressions, never in
// the frontmatter above the closing "---" — renderChild has to live in here
// (an IIFE, same trick as SectionBlock.astro's own renderSlideEl).
const renderChild = (child: El, childPath: string, visId: string): unknown => {
  const cp = child.props ?? {};
  const hasBp = !!child.bp && Object.keys(child.bp).length > 0;
  if (child.type === "container") {
    if (hasBp) {
      responsiveRules.push(
        ...bpStyleRules(`[data-vis="${visId}"]`, child.bp!, cp, (mp) =>
          [`border-radius:${elRadius(mp)}`, marginStyle(mp), paddingStyle(mp), elBorderShadowStyle(mp)].filter(Boolean).join(";"),
        ),
      );
    }
    const boxVis = hideRules(cp, visId) || hasBp;
    return (
      <div
        class={cls("ds-container", cp.cssClass)}
        data-designer-path={designerEdit ? childPath : undefined}
        data-vis={boxVis ? visId : undefined}
        style={boxStyle(cp, true)}
      >
        {(child.children ?? []).map((gc, gi) => renderChild(gc, `${childPath}.${gi}`, `${visId}.${gi}`))}
      </div>
    );
  }
  // Same type -> component mapping as SectionBlock.astro's element switch.
  const node = (() => {
    switch (child.type) {
      case "heading":
      case "text":
      case "image":
      case "video":
      case "button":
      case "badge":
      case "spacer":
      case "divider":
      case "embed":
      case "icon":
      case "list":
      case "html":
      case "gallery":
        // e={-1}: a nested image is never the page's LCP "first element".
        return <ElementBlock el={child} elId={visId} blockIndex={blockIndex} r={r} c={c} e={-1} />;
      case "accordion":
      case "infobox":
      case "tabs":
      case "cardgrid":
      case "ctabanner":
      case "announcementbar":
      case "googlemap":
        return <MiscBlock el={child} elId={visId} />;
      case "slider":
        return <SliderBlock el={child} designerEdit={designerEdit} elId={visId} />;
      case "menu":
        return (
          <MenuBlock
            menuId={cp.menuId ?? ""}
            layout={cp.layout as "horizontal" | "vertical" | undefined}
            dropdownTrigger={cp.dropdownTrigger as "hover" | "click" | undefined}
            megaMenuWidth={cp.megaMenuWidth as "contained" | "full-width" | undefined}
            tenantHost={tenantHost}
            lang={requestedLang}
            p={cp}
            bp={child.bp}
            elId={visId}
          />
        );
      case "symbol":
        if (hasBp) responsiveRules.push(...bpStyleRules(`[data-vis="${visId}"] > .ds-symbol`, child.bp!, cp, spacingCss));
        return <SymbolBlock symbolId={cp.symbolId ?? ""} tenantHost={tenantHost} box={spacingCss(cp)} elId={visId} />;
      case "postlist":
        return (
          <PostListBlock
            categoryId={cp.categoryId ?? ""}
            count={cp.count}
            columns={cp.columns}
            postLayout={cp.postLayout as "grid" | "list" | undefined}
            tenantHost={tenantHost}
            lang={requestedLang}
            p={cp}
            bp={child.bp}
            elId={visId}
          />
        );
      case "eventlist":
        return (
          <EventListBlock
            count={cp.count}
            columns={cp.columns}
            eventLayout={cp.eventLayout as "grid" | "list" | "calendar" | undefined}
            tenantHost={tenantHost}
            p={cp}
            bp={child.bp}
            elId={visId}
          />
        );
      case "testimonial":
      case "statscounter":
      case "peoplegrid":
      case "socialicons":
      case "logocloud":
      case "timeline":
      case "documentdownload":
      case "announcementticker":
        return <RepeaterBlock el={child} elId={visId} />;
      default:
        return null;
    }
  })();
  // Live Edit's empty-element placeholder (BaseLayout.astro) wears the
  // child's own margin/padding, same as SectionBlock.astro's elements.
  if (designerEdit && hasBp) responsiveRules.push(...bpStyleRules(`[data-designer-path="${childPath}"] > [data-ds-ph]`, child.bp!, cp, spacingCss));
  const vis = hideRules(cp, visId) || hasBp || child.type === "slider";
  return designerEdit || vis ? (
    <div
      data-designer-path={designerEdit ? childPath : undefined}
      data-ds-type={designerEdit ? child.type : undefined}
      data-ds-ph-style={designerEdit ? spacingCss(cp) || undefined : undefined}
      data-vis={vis ? visId : undefined}
      style="display:contents"
    >
      {node}
    </div>
  ) : (
    node
  );
};
const elDottedPath = `${blockIndex}.${r}.${c}.${e}`;
const containerChildren = (el.children ?? []).map((child, i) => renderChild(child, `${elDottedPath}.${i}`, `${elId}.${i}`));
return (
  <>
    <div class={cls("ds-container", p.cssClass)} style={boxStyle(p, false)}>
      {containerChildren}
    </div>
    {responsiveRules.length > 0 && <style set:html={responsiveRules.join("")} />}
  </>
);
})()}
