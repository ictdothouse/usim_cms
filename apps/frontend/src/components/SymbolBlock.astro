---
// Live-linked reusable component (Designer.tsx's "symbol" element) — same
// async-fetch-then-render shape as MenuBlock.astro: getSymbol resolves the
// tenant's symbols table at render time (no propagation/sync step, editing
// the master instantly changes every page that references it).
//
// Renders the resolved node through the SAME curated element set
// SectionBlock.astro's own "container" case (renderContainerChild) already
// uses for nested content — not the full top-level switch (menu/slider/
// postlist/etc. don't make sense embedded inside a component, mirroring why
// container's own children are curated too). Duplicated here rather than
// shared, same "redefined per instance" convention renderContainerChild's
// own comment already establishes for this codebase. No data-designer-path/
// Live-Edit wiring — a resolved symbol's content isn't individually
// selectable on the canvas either (see ElPreview.tsx's "symbol" case,
// path: undefined), editing only happens via "Edit Master".
import { getSymbol } from "../lib/api";
import RepeaterBlock from "./RepeaterBlock.astro";
import {
  cls,
  safeUrl,
  headingTag,
  ICON_PATHS,
  marginStyle,
  paddingStyle,
  elBorderShadowStyle,
  typoStyle,
  elRadius,
  imgAlignStyle,
  fluidTextSize,
  lengthValue,
  TEXT_SIZE,
  SPACE,
  elHoverClass,
  elEntranceClass,
  elEffectBpStyle,
  elVariantBpStyle,
  renderInline,
} from "../lib/element-render";
import { flexWrapFor } from "@ucms/element-render";

interface El {
  type: string;
  props?: Record<string, string>;
  bp?: Record<string, string>;
  children?: El[];
}
interface Props {
  symbolId: string;
  tenantHost: string;
  // The instance's own margin/padding CSS (SectionBlock.astro) — lives on a
  // .ds-symbol wrapper so it never mixes with the master node's own spacing.
  box?: string;
  // The instance's own data-vis id (SectionBlock.astro) — prefixes this
  // file's counter ids so two symbols on one page never both mint `sym0`.
  elId: string;
}
const { symbolId, tenantHost, box, elId } = Astro.props;

const symbol = symbolId ? await getSymbol(tenantHost, symbolId) : null;
const node = symbol?.node as El | undefined;

// Real per-breakpoint overrides for a symbol's nodes — same bpStyleRules
// mechanism SectionBlock.astro/ContainerBlock.astro use for theirs, and the
// same fields ElementBlock.astro covers: each rule's build restates the
// node's own inline style list (heading/text: align/margin/padding/
// typography/border/shadow, text size), plus hover/entrance, button/badge
// variant + color, badge scale, icon size/color, container flex box (duplicated here rather than shared, this codebase's established
// convention). Nodes here have no dotted path of their own (a symbol's
// resolved tree isn't individually selectable — see this file's own top
// comment), so each node needing one gets a small counter-based id instead,
// prefixed with the instance's own `elId`.
const responsiveRules: string[] = [];
let visIdCounter = 0;
function bpMerge(base: Record<string, string>, bp: Record<string, string>, tier: "tablet" | "mobile"): Record<string, string> {
  const prefix = `${tier}:`;
  const merged = { ...base };
  for (const [k, v] of Object.entries(bp)) {
    if (k.startsWith(prefix)) merged[k.slice(prefix.length)] = v;
  }
  return merged;
}
function bpStyleRules(selector: string, bp: Record<string, string>, base: Record<string, string>, build: (p: Record<string, string>) => string): string[] {
  const out: string[] = [];
  for (const tier of ["tablet", "mobile"] as const) {
    if (!Object.keys(bp).some((k) => k.startsWith(`${tier}:`))) continue;
    const css = build(bpMerge(base, bp, tier));
    if (!css) continue;
    const important = css
      .split(";")
      .filter(Boolean)
      .map((decl) => `${decl} !important`)
      .join(";");
    const media = tier === "tablet" ? "(min-width:641px) and (max-width:1024px)" : "(max-width:640px)";
    out.push(`@media ${media}{${selector}{${important}}}`);
  }
  return out;
}
---

{node && (() => {
// Astro frontmatter (above the closing `---`) is plain script and can't
// contain JSX — this whole function has to live inside a template `{}`
// expression instead, same as SectionBlock.astro's own `const node = (() =>
// {...})()` IIFE does for its per-element switch.
const renderNode = (el: El, nested = false): unknown => {
  const p = el.props ?? {};
  switch (el.type) {
    case "heading": {
      const Tag = headingTag(p.level) as "h1";
      const hasTypoBp = !!el.bp && Object.keys(el.bp).length > 0;
      const visId = hasTypoBp ? `${elId}-sym${visIdCounter++}` : undefined;
      if (visId)
        responsiveRules.push(
          ...bpStyleRules(`[data-vis="${visId}"] .ds-h`, el.bp!, p, (mp) =>
            [mp.align ? `text-align:${mp.align}` : null, marginStyle(mp), paddingStyle(mp), typoStyle(mp), elBorderShadowStyle(mp), elEffectBpStyle(mp, p, el.bp)]
              .filter(Boolean)
              .join(";"),
          ),
        );
      const headingNode = (
        <Tag
          class={cls("ds-h", `ds-h${p.level ?? "2"}`, p.cssClass, elHoverClass(p, el.bp), elEntranceClass(p, el.bp))}
          style={[p.align ? `text-align:${p.align}` : null, marginStyle(p), paddingStyle(p), typoStyle(p), elBorderShadowStyle(p)]
            .filter(Boolean)
            .join(";")}
          set:html={p.text ? renderInline(p.text) : ""}
        />
      );
      return visId ? (
        <div data-vis={visId} style="display:contents">
          {headingNode}
        </div>
      ) : (
        headingNode
      );
    }
    case "text": {
      const hasTypoBp = !!el.bp && Object.keys(el.bp).length > 0;
      const visId = hasTypoBp ? `${elId}-sym${visIdCounter++}` : undefined;
      if (visId)
        responsiveRules.push(
          ...bpStyleRules(`[data-vis="${visId}"] .ds-text`, el.bp!, p, (mp) =>
            [
              `font-size:${fluidTextSize(lengthValue(mp.size, TEXT_SIZE, TEXT_SIZE.md))}`,
              mp.align ? `text-align:${mp.align}` : null,
              marginStyle(mp),
              paddingStyle(mp),
              typoStyle(mp),
              elBorderShadowStyle(mp),
              elEffectBpStyle(mp, p, el.bp),
            ]
              .filter(Boolean)
              .join(";"),
          ),
        );
      const textNode = (
        <p
          class={cls("ds-text", p.cssClass, elHoverClass(p, el.bp), elEntranceClass(p, el.bp))}
          style={[
            `font-size:${fluidTextSize(lengthValue(p.size, TEXT_SIZE, TEXT_SIZE.md))}`,
            p.align ? `text-align:${p.align}` : null,
            marginStyle(p),
            paddingStyle(p),
            typoStyle(p),
            elBorderShadowStyle(p),
          ]
            .filter(Boolean)
            .join(";")}
          set:html={renderInline(p.text ?? "")}
        />
      );
      return visId ? (
        <div data-vis={visId} style="display:contents">
          {textNode}
        </div>
      ) : (
        textNode
      );
    }
    case "image": {
      const src = safeUrl(p.src);
      if (!src) return null;
      const hasBp = !!el.bp && Object.keys(el.bp).length > 0;
      const visId = hasBp ? `${elId}-sym${visIdCounter++}` : undefined;
      if (visId) {
        responsiveRules.push(
          ...bpStyleRules(`[data-vis="${visId}"]`, el.bp!, p, (mp) => marginStyle(mp) ?? ""),
          ...bpStyleRules(`[data-vis="${visId}"] img`, el.bp!, p, (mp) =>
            [`border-radius:${elRadius(mp)}`, mp.imgWidth ? `width:${mp.imgWidth}` : null, imgAlignStyle(mp.align), paddingStyle(mp), elBorderShadowStyle(mp), elEffectBpStyle(mp, p, el.bp)]
              .filter(Boolean)
              .join(";"),
          ),
        );
      }
      const href = safeUrl(p.href);
      const img = (
        <img
          class={cls("ds-img", p.cssClass, elHoverClass(p, el.bp), elEntranceClass(p, el.bp))}
          src={src}
          alt={p.alt ?? ""}
          loading="lazy"
          style={[`border-radius:${elRadius(p)}`, p.imgWidth ? `width:${p.imgWidth}` : null, imgAlignStyle(p.align), paddingStyle(p), elBorderShadowStyle(p)]
            .filter(Boolean)
            .join(";")}
        />
      );
      // Same two-node box as ElementBlock.astro's image (margin on the wrapper, optional link).
      return (
        <div class="ds-img-wrap" data-vis={visId} style={marginStyle(p)}>{href ? <a href={href}>{img}</a> : img}</div>
      );
    }
    case "button": {
      const hasBp = !!el.bp && Object.keys(el.bp).length > 0;
      const visId = hasBp ? `${elId}-sym${visIdCounter++}` : undefined;
      if (visId) {
        responsiveRules.push(
          ...bpStyleRules(`[data-vis="${visId}"]`, el.bp!, p, (mp) => [mp.align ? `text-align:${mp.align}` : null, marginStyle(mp), paddingStyle(mp)].filter(Boolean).join(";")),
          ...bpStyleRules(`[data-vis="${visId}"] .ds-btn`, el.bp!, p, (mp) =>
            [elVariantBpStyle("button", mp, el.bp), mp.color ? `color:${mp.color}` : null, elBorderShadowStyle(mp), elEffectBpStyle(mp, p, el.bp)].filter(Boolean).join(";"),
          ),
        );
      }
      return p.label ? (
        <div data-vis={visId} style={[p.align ? `text-align:${p.align}` : null, marginStyle(p), paddingStyle(p)].filter(Boolean).join(";")}>
          <a
            class={cls(p.variant === "outline" ? "ds-btn ds-btn-outline" : "ds-btn ds-btn-primary", p.cssClass, elHoverClass(p, el.bp), elEntranceClass(p, el.bp))}
            href={safeUrl(p.href) ?? "#"}
            style={[p.color ? `color:${p.color}` : null, elBorderShadowStyle(p)].filter(Boolean).join(";") || undefined}
          >
            {p.label}
          </a>
        </div>
      ) : null;
    }
    case "badge": {
      const iconPath = p.name ? ICON_PATHS[p.name] : undefined;
      const badgeIconPx = (scale?: string) => ({ sm: "14", md: "16", lg: "20" })[scale ?? "md"] ?? "16";
      const iconSize = badgeIconPx(p.scale);
      const hasBp = !!el.bp && Object.keys(el.bp).length > 0;
      const visId = hasBp ? `${elId}-sym${visIdCounter++}` : undefined;
      if (visId) {
        responsiveRules.push(
          ...bpStyleRules(`[data-vis="${visId}"]`, el.bp!, p, (mp) => [mp.align ? `text-align:${mp.align}` : null, marginStyle(mp), paddingStyle(mp)].filter(Boolean).join(";")),
          ...bpStyleRules(`[data-vis="${visId}"] .ds-badge`, el.bp!, p, (mp) => [elVariantBpStyle("badge", mp, el.bp), mp.color ? `color:${mp.color}` : null].filter(Boolean).join(";")),
          ...bpStyleRules(`[data-vis="${visId}"] .ds-badge svg`, el.bp!, p, (mp) => `width:${badgeIconPx(mp.scale)}px;height:${badgeIconPx(mp.scale)}px`),
        );
      }
      return (
        <div data-vis={visId} style={[p.align ? `text-align:${p.align}` : null, marginStyle(p), paddingStyle(p)].filter(Boolean).join(";")}>
          <span class={cls(`ds-badge ds-badge-${p.variant || "soft"} ds-badge-${p.scale || "md"}`, p.cssClass)} style={p.color ? `color:${p.color}` : undefined}>
            {iconPath && (
              <svg width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d={iconPath} />
              </svg>
            )}
            {p.label}
          </span>
        </div>
      );
    }
    case "spacer": {
      const hasBp = !!el.bp && Object.keys(el.bp).length > 0;
      const visId = hasBp ? `${elId}-sym${visIdCounter++}` : undefined;
      const spacerStyle = (mp: typeof p) =>
        [`height:${lengthValue(mp.height, SPACE, SPACE.md)}`, marginStyle(mp), paddingStyle(mp)].filter(Boolean).join(";");
      if (visId) responsiveRules.push(...bpStyleRules(`[data-vis="${visId}"]`, el.bp!, p, spacerStyle));
      return <div data-vis={visId} style={spacerStyle(p)} />;
    }
    case "divider": {
      const hasBp = !!el.bp && Object.keys(el.bp).length > 0;
      const visId = hasBp ? `${elId}-sym${visIdCounter++}` : undefined;
      if (visId) responsiveRules.push(...bpStyleRules(`[data-vis="${visId}"]`, el.bp!, p, (mp) => [marginStyle(mp), paddingStyle(mp)].filter(Boolean).join(";")));
      return <hr data-vis={visId} class="ds-divider" style={[marginStyle(p), paddingStyle(p)].filter(Boolean).join(";")} />;
    }
    case "icon": {
      const iconPath = ICON_PATHS[p.name ?? "check"] ?? ICON_PATHS.check;
      const iconSizeOf = (size?: string) => lengthValue(size, { sm: "1rem", md: "1.5rem", lg: "2rem" }, "1.5rem");
      const iconSize = iconSizeOf(p.size);
      const hasBp = !!el.bp && Object.keys(el.bp).length > 0;
      const visId = hasBp ? `${elId}-sym${visIdCounter++}` : undefined;
      if (visId) {
        responsiveRules.push(
          ...bpStyleRules(`[data-vis="${visId}"]`, el.bp!, p, (mp) => [mp.align ? `text-align:${mp.align}` : null, marginStyle(mp), paddingStyle(mp)].filter(Boolean).join(";")),
          // CSS stroke beats the svg's stroke="" attribute.
          ...bpStyleRules(`[data-vis="${visId}"] > svg`, el.bp!, p, (mp) =>
            [`width:${iconSizeOf(mp.size)};height:${iconSizeOf(mp.size)}`, mp.color ? `stroke:${mp.color}` : null].filter(Boolean).join(";"),
          ),
        );
      }
      return (
        <div data-vis={visId} style={[p.align ? `text-align:${p.align}` : null, marginStyle(p), paddingStyle(p)].filter(Boolean).join(";")}>
          <svg width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="none" stroke={p.color || "currentColor"} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d={iconPath} />
          </svg>
        </div>
      );
    }
    case "container": {
      const children = el.children ?? [];
      const hasBp = !!el.bp && Object.keys(el.bp).length > 0;
      const visId = hasBp ? `${elId}-sym${visIdCounter++}` : undefined;
      // One list for the inline base and the per-breakpoint rule.
      const boxCss = (mp: typeof p) =>
        [
          "display:flex",
          `flex-direction:${mp.flexDirection || "row"}`,
          `justify-content:${mp.justifyContent || "flex-start"}`,
          `align-items:${mp.alignItems || "stretch"}`,
          `flex-wrap:${flexWrapFor(mp.flexDirection, mp.flexWrap)}`,
          `gap:${mp.gap || "1rem"}`,
          // A nested "N Columns" column's width share — see ContainerBlock.astro's boxStyle.
          nested && mp.grow ? `flex:${mp.grow} 1 0%;min-width:min(15rem,100%)` : null,
          mp.bg ? `background:${mp.bg}` : null,
          `border-radius:${elRadius(mp)}`,
          marginStyle(mp),
          paddingStyle(mp),
          elBorderShadowStyle(mp),
        ]
          .filter(Boolean)
          .join(";");
      if (visId) responsiveRules.push(...bpStyleRules(`[data-vis="${visId}"]`, el.bp!, p, boxCss));
      return (
        <div
          data-vis={visId}
          style={boxCss(p)}
        >
          {children.map((child) => renderNode(child, true))}
        </div>
      );
    }
    // ContainerBlock.astro's repeater set, so e.g. one saved Social Media
    // symbol can sit in the header, a page and the footer at once.
    case "testimonial":
    case "statscounter":
    case "peoplegrid":
    case "socialicons":
    case "logocloud":
    case "timeline":
    case "documentdownload":
    case "announcementticker": {
      const visId = `${elId}-sym${visIdCounter++}`;
      return (
        <div data-vis={visId}>
          <RepeaterBlock el={el} elId={visId} />
        </div>
      );
    }
    default:
      return null;
  }
};
const rendered = renderNode(node!);
// Flex column, same as .ds-col, so the master node lays out exactly as it did
// as a direct column child.
return (
  <>
    {rendered != null && <div class="ds-symbol" style={`display:flex;flex-direction:column;${box ?? ""}`}>{rendered}</div>}
    {responsiveRules.length > 0 && <style set:html={responsiveRules.join("")} />}
  </>
);
})()}
