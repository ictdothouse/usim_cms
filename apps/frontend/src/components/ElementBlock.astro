---
// Core single-element cases (heading/text/image/video/button/badge/spacer/
// divider/embed/icon/list/html/gallery) — extracted verbatim out of
// SectionBlock.astro's own switch (god-file breakup, see SectionBlock.astro's
// top-of-file comment on why shared *logic* goes through
// lib/element-render.ts, never another .astro file's frontmatter). None of
// these read designerEdit; only "image" reads blockIndex/r/c/e (LCP
// first-element check).
import {
  ICON_PATHS,
  SPACE,
  TEXT_SIZE,
  ICON_SIZE,
  fluidTextSize,
  shadowToCss,
  safeUrl,
  renderInline,
  lengthValue,
  marginStyle,
  paddingStyle,
  elBorderShadowStyle,
  typoStyle,
  elHoverClass,
  elEntranceClass,
  elRadius,
  cls,
  headingTag,
} from "../lib/element-render";

// Local, not imported from SectionBlock.astro's frontmatter — see that
// file's top comment on the outage caused by sharing frontmatter bindings
// across .astro files. Same duplication convention as ContainerBlock.astro/
// RepeaterBlock.astro/MiscBlock.astro's own local copies.
const RATIO: Record<string, string> = { "16:9": "16 / 9", "4:3": "4 / 3", "1:1": "1 / 1" };
const SRCSET_WIDTHS = [400, 800, 1200, 1600];
function buildSrcset(url: string): { srcset: string; sizes: string } | null {
  const m = /[?&]w=(\d+)/.exec(url);
  if (!m) return null;
  const width = Number(m[1]);
  const base = url.split("?")[0];
  const dot = base.lastIndexOf(".");
  const stem = dot === -1 ? base : base.slice(0, dot);
  const candidates = SRCSET_WIDTHS.filter((w) => w < width);
  if (candidates.length === 0) return null;
  const entries = [...candidates.map((w) => `${stem}-${w}w.webp ${w}w`), `${base} ${width}w`];
  return { srcset: entries.join(", "), sizes: "(min-width: 1024px) 800px, 100vw" };
}

interface El {
  type: string;
  props?: Record<string, string>;
  bp?: Record<string, string>;
}
interface Props {
  el: El;
  blockIndex: number;
  r: number;
  c: number;
  e: number;
}
const { el, blockIndex, r, c, e } = Astro.props as Props;
const p = el.props ?? {};

// Real per-breakpoint margin/padding/border/shadow/align override — same
// bpStyleRules mechanism SectionBlock.astro/ContainerBlock.astro/
// SymbolBlock.astro use for theirs (duplicated here rather than shared, this
// codebase's established convention — see SectionBlock.astro's own top
// comment on why shared *logic* goes through lib/element-render.ts, never
// another .astro file's frontmatter). `elId` matches the `data-vis` id
// SectionBlock.astro's own wrapper div around this component's output
// already carries (same `e${blockIndex}-${r}-${c}-${e}` formula) — a CSS
// selector matches regardless of which component's <style> tag declares it,
// so this works without that wrapper needing to know this file's per-type
// selectors. hoverEffect/entrance/color stay admin-canvas-preview-only for
// now — those are CSS classes / non-box-model fields, a different mechanism
// than reusing bpStyleRules against a margin/padding/border/shadow build.
const elId = `e${blockIndex}-${r}-${c}-${e}`;
const responsiveRules: string[] = [];
function bpMerge(base: Record<string, string>, bp: Record<string, string>, tier: "tablet" | "mobile"): Record<string, string> {
  const prefix = `${tier}:`;
  const merged = { ...base };
  for (const [k, v] of Object.entries(bp)) {
    if (k.startsWith(prefix)) merged[k.slice(prefix.length)] = v;
  }
  return merged;
}
function bpStyleRules(selector: string, bp: Record<string, string>, base: Record<string, string>, build: (p: Record<string, string>) => string): string[] {
  const out: string[] = [];
  for (const tier of ["tablet", "mobile"] as const) {
    if (!Object.keys(bp).some((k) => k.startsWith(`${tier}:`))) continue;
    const css = build(bpMerge(base, bp, tier));
    if (!css) continue;
    const important = css
      .split(";")
      .filter(Boolean)
      .map((decl) => `${decl} !important`)
      .join(";");
    const media = tier === "tablet" ? "(min-width:641px) and (max-width:1024px)" : "(max-width:640px)";
    out.push(`@media ${media}{${selector}{${important}}}`);
  }
  return out;
}
const hasBp = !!el.bp && Object.keys(el.bp).length > 0;
if (hasBp) {
  const sel = `[data-vis="${elId}"]`;
  switch (el.type) {
    case "heading":
      responsiveRules.push(
        ...bpStyleRules(`${sel} .ds-h`, el.bp!, p, (mp) =>
          [mp.align ? `text-align:${mp.align}` : null, marginStyle(mp), paddingStyle(mp), typoStyle(mp), elBorderShadowStyle(mp)].filter(Boolean).join(";"),
        ),
      );
      break;
    case "text":
      responsiveRules.push(
        ...bpStyleRules(`${sel} .ds-text`, el.bp!, p, (mp) =>
          [
            `font-size:${fluidTextSize(lengthValue(mp.size, TEXT_SIZE, TEXT_SIZE.md))}`,
            mp.align ? `text-align:${mp.align}` : null,
            marginStyle(mp),
            paddingStyle(mp),
            typoStyle(mp),
            elBorderShadowStyle(mp),
          ]
            .filter(Boolean)
            .join(";"),
        ),
      );
      break;
    case "image":
      responsiveRules.push(
        ...bpStyleRules(`${sel} img`, el.bp!, p, (mp) =>
          [`border-radius:${elRadius(mp)}`, mp.imgWidth ? `width:${mp.imgWidth}` : null, marginStyle(mp), paddingStyle(mp), elBorderShadowStyle(mp)]
            .filter(Boolean)
            .join(";"),
        ),
        ...bpStyleRules(`${sel} .ds-img-wrap`, el.bp!, p, (mp) => (mp.align ? `text-align:${mp.align}` : "")),
      );
      break;
    case "video":
      responsiveRules.push(
        ...bpStyleRules(`${sel} .ds-video`, el.bp!, p, (mp) =>
          [`border-radius:${elRadius(mp)}`, "max-width:100%", marginStyle(mp), paddingStyle(mp), elBorderShadowStyle(mp)].filter(Boolean).join(";"),
        ),
      );
      break;
    case "button":
      responsiveRules.push(
        ...bpStyleRules(`${sel} .ds-btn-wrap`, el.bp!, p, (mp) => [mp.align ? `text-align:${mp.align}` : null, marginStyle(mp), paddingStyle(mp)].filter(Boolean).join(";")),
        ...bpStyleRules(`${sel} .ds-btn`, el.bp!, p, (mp) => elBorderShadowStyle(mp) ?? ""),
      );
      break;
    case "badge":
      responsiveRules.push(
        ...bpStyleRules(`${sel} .ds-badge-wrap`, el.bp!, p, (mp) => [mp.align ? `text-align:${mp.align}` : null, marginStyle(mp), paddingStyle(mp)].filter(Boolean).join(";")),
      );
      break;
    case "spacer":
      responsiveRules.push(...bpStyleRules(`${sel} .ds-spacer`, el.bp!, p, (mp) => `height:${lengthValue(mp.height, SPACE, SPACE.md)}`));
      break;
    case "divider":
      responsiveRules.push(...bpStyleRules(`${sel} .ds-divider`, el.bp!, p, (mp) => [marginStyle(mp), paddingStyle(mp)].filter(Boolean).join(";")));
      break;
    case "embed":
      responsiveRules.push(
        ...bpStyleRules(`${sel} .ds-embed`, el.bp!, p, (mp) =>
          [
            `border-radius:${elRadius(mp)}`,
            shadowToCss(mp.shadow) ? `box-shadow:${shadowToCss(mp.shadow)}` : null,
            marginStyle(mp),
            paddingStyle(mp),
          ]
            .filter(Boolean)
            .join(";"),
        ),
      );
      break;
    case "icon":
      responsiveRules.push(
        ...bpStyleRules(`${sel} .ds-icon-wrap`, el.bp!, p, (mp) => [mp.align ? `text-align:${mp.align}` : null, marginStyle(mp), paddingStyle(mp)].filter(Boolean).join(";")),
      );
      break;
    case "list":
      responsiveRules.push(...bpStyleRules(`${sel} .ds-list`, el.bp!, p, (mp) => [marginStyle(mp), paddingStyle(mp), typoStyle(mp)].filter(Boolean).join(";")));
      break;
    case "html":
      responsiveRules.push(...bpStyleRules(`${sel} .ds-html`, el.bp!, p, (mp) => [marginStyle(mp), paddingStyle(mp)].filter(Boolean).join(";")));
      break;
    case "gallery":
      responsiveRules.push(
        ...bpStyleRules(`${sel} .ds-gallery`, el.bp!, p, (mp) =>
          [`grid-template-columns:repeat(${mp.columns ?? "3"},1fr)`, marginStyle(mp), paddingStyle(mp)].filter(Boolean).join(";"),
        ),
      );
      break;
  }
}
---

{(() => {
switch (el.type) {
  case "heading": {
    const Tag = headingTag(p.level) as "h1";
    return (
      <Tag
        class={cls("ds-h", `ds-h${p.level ?? "2"}`, p.cssClass, elHoverClass(p), elEntranceClass(p))}
        style={[p.align ? `text-align:${p.align}` : null, marginStyle(p), paddingStyle(p), typoStyle(p), elBorderShadowStyle(p)]
          .filter(Boolean)
          .join(";")}
        set:html={p.text ? renderInline(p.text) : ""}
      />
    );
  }
  case "text":
    return (
      <p
        class={cls("ds-text", p.cssClass, elHoverClass(p), elEntranceClass(p))}
        style={[
          `font-size:${fluidTextSize(lengthValue(p.size, TEXT_SIZE, TEXT_SIZE.md))}`,
          p.align ? `text-align:${p.align}` : null,
          marginStyle(p),
          paddingStyle(p),
          typoStyle(p),
          elBorderShadowStyle(p),
        ]
          .filter(Boolean)
          .join(";")}
        set:html={renderInline(p.text ?? "")}
      />
    );
  case "image": {
    // The very first element on the page (first section, first row/column/
    // element) is the one most likely to be the LCP candidate — lazy-loading
    // it (the old unconditional behavior) is exactly what PageSpeed's
    // "loading=lazy should not apply to the LCP image" flag catches.
    // fetchpriority=high additionally tells the browser to fetch it ahead of
    // same-priority resources discovered later in the document.
    const isFirst = blockIndex === 0 && r === 0 && c === 0 && e === 0;
    const imgSrc = safeUrl(p.src);
    const imgSrcset = imgSrc ? buildSrcset(imgSrc) : null;
    return imgSrc ? (
      <div class="ds-img-wrap" style={p.align ? `text-align:${p.align}` : null}>
        <img
          class={cls("ds-img", p.cssClass, elHoverClass(p), elEntranceClass(p))}
          src={imgSrc}
          srcset={imgSrcset?.srcset}
          sizes={imgSrcset ? imgSrcset.sizes : undefined}
          alt={p.alt ?? ""}
          loading={isFirst ? undefined : "lazy"}
          fetchpriority={isFirst ? "high" : undefined}
          style={[
            `border-radius:${elRadius(p)}`,
            p.imgWidth ? `width:${p.imgWidth}` : null,
            marginStyle(p),
            paddingStyle(p),
            elBorderShadowStyle(p),
          ]
            .filter(Boolean)
            .join(";")}
        />
      </div>
    ) : null;
  }
  case "video":
    return safeUrl(p.src) ? (
      <video
        class={cls("ds-video", p.cssClass)}
        src={safeUrl(p.src)}
        controls
        style={[
          `border-radius:${elRadius(p)}`,
          "max-width:100%",
          marginStyle(p),
          paddingStyle(p),
          elBorderShadowStyle(p),
        ]
          .filter(Boolean)
          .join(";")}
      />
    ) : null;
  case "button":
    return p.label ? (
      <div
        class="ds-btn-wrap"
        style={[p.align ? `text-align:${p.align}` : null, marginStyle(p), paddingStyle(p)].filter(Boolean).join(";")}
      >
        <a
          class={cls(p.variant === "outline" ? "ds-btn ds-btn-outline" : "ds-btn ds-btn-primary", p.cssClass, elHoverClass(p), elEntranceClass(p))}
          href={safeUrl(p.href) ?? "#"}
          style={[p.color ? `color:${p.color}` : null, elBorderShadowStyle(p)].filter(Boolean).join(";") || undefined}
        >
          {p.label}
        </a>
      </div>
    ) : null;
  case "badge": {
    if (!p.label) return null;
    const badgeIconSize = { sm: 10, md: 12, lg: 14 }[p.scale ?? "md"] ?? 12;
    const badgeIconPath = p.name ? ICON_PATHS[p.name] : undefined;
    return (
      <div class="ds-badge-wrap" style={[p.align ? `text-align:${p.align}` : null, marginStyle(p), paddingStyle(p)].filter(Boolean).join(";")}>
        <span
          class={cls(`ds-badge ds-badge-${p.variant || "soft"} ds-badge-${p.scale || "md"}`, p.cssClass)}
          style={p.color ? `color:${p.color}` : undefined}
        >
          {badgeIconPath && (
            <svg width={badgeIconSize} height={badgeIconSize} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d={badgeIconPath} />
            </svg>
          )}
          {p.label}
        </span>
      </div>
    );
  }
  case "spacer":
    return <div class="ds-spacer" style={`height:${lengthValue(p.height, SPACE, SPACE.md)}`} aria-hidden="true" />;
  case "divider":
    return (
      <hr
        class={cls("ds-divider", p.cssClass)}
        style={[marginStyle(p), paddingStyle(p)].filter(Boolean).join(";") || undefined}
      />
    );
  case "embed":
    return safeUrl(p.url) ? (
      <iframe
        class={cls("ds-embed", p.cssClass)}
        src={safeUrl(p.url)}
        style={[
          `aspect-ratio:${RATIO[p.ratio ?? "16:9"] ?? RATIO["16:9"]}`,
          `border-radius:${elRadius(p)}`,
          shadowToCss(p.shadow) ? `box-shadow:${shadowToCss(p.shadow)}` : null,
          marginStyle(p),
          paddingStyle(p),
        ]
          .filter(Boolean)
          .join(";")}
        loading="lazy"
        allowfullscreen
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        referrerpolicy="strict-origin-when-cross-origin"
      />
    ) : null;
  case "icon": {
    const path = ICON_PATHS[p.name ?? "check"] ?? ICON_PATHS.check;
    const size = lengthValue(p.size, ICON_SIZE, ICON_SIZE.md);
    return (
      <div
        class={cls("ds-icon-wrap", p.cssClass)}
        style={[p.align ? `text-align:${p.align}` : null, marginStyle(p), paddingStyle(p)].filter(Boolean).join(";")}
      >
        <svg
          width={size}
          height={size}
          viewBox="0 0 24 24"
          fill="none"
          stroke={p.color || "currentColor"}
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          style="display:inline-block;vertical-align:middle"
        >
          <path d={path} />
        </svg>
      </div>
    );
  }
  case "list": {
    const items = (p.items ?? "").split("\n").map((s) => s.trim()).filter(Boolean);
    if (items.length === 0) return null;
    const Tag = p.style === "numbered" ? "ol" : "ul";
    return (
      <Tag
        class={cls("ds-list", p.style === "none" ? "ds-list-none" : undefined, p.cssClass)}
        style={[marginStyle(p), paddingStyle(p), typoStyle(p)].filter(Boolean).join(";")}
      >
        {items.map((it) => (
          <li set:html={renderInline(it)} />
        ))}
      </Tag>
    );
  }
  case "html":
    // Same trust tier as bgImage/embed src: only an authenticated webmaster/
    // superadmin can write page layout, so this isn't a public-input XSS
    // surface.
    return p.html ? (
      <div
        class={cls("ds-html", p.cssClass)}
        style={[marginStyle(p), paddingStyle(p)].filter(Boolean).join(";") || undefined}
        set:html={p.html}
      />
    ) : null;
  case "gallery": {
    const images = (p.images ?? "")
      .split("\n")
      .map((s) => s.trim())
      .filter(Boolean)
      .map(safeUrl)
      .filter((u): u is string => Boolean(u));
    if (images.length === 0) return null;
    return (
      <div
        class={cls("ds-gallery", p.cssClass)}
        style={[`grid-template-columns:repeat(${p.columns ?? "3"},1fr)`, marginStyle(p), paddingStyle(p)]
          .filter(Boolean)
          .join(";")}
      >
        {images.map((src) => {
          const srcset = buildSrcset(src);
          return (
            <img
              src={src}
              srcset={srcset?.srcset}
              sizes={srcset ? srcset.sizes : undefined}
              alt=""
              loading="lazy"
              style={`border-radius:${elRadius(p)}`}
            />
          );
        })}
      </div>
    );
  }
  default:
    return null;
}
})()}
{responsiveRules.length > 0 && <style set:html={responsiveRules.join("")} />}

<style>
  /* .ds-h/.ds-text/.ds-img/.ds-btn*/.ds-badge*/.ds-divider now live in
     global.css (single source, plain classes don't need per-component
     scoping) — see that file's own comment. Only classes genuinely local
     to this component's own cases (badge size variants, embed/list/gallery)
     stay here. */
  .ds-btn-sm {
    font-size: 0.8rem;
  }
  .ds-btn-lg {
    font-size: 1.1rem;
  }
  .ds-embed {
    width: 100%;
    border: 0;
  }
  .ds-list {
    margin: 0;
    padding-left: 1.25rem;
    line-height: 1.7;
  }
  .ds-list-none {
    list-style: none;
    padding-left: 0;
  }
  .ds-gallery {
    display: grid;
    gap: 0.75rem;
  }
  .ds-gallery img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 768px) {
    .ds-gallery {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }
</style>
