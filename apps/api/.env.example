# First time on a fresh DB: connect as an admin/superuser (e.g. postgres) and
# run `pnpm --filter @usim-cms/api db:setup-role` once, THEN switch this to
# the usim_cms_app role it creates (below) — the RLS policies in
# migrations/0002_pages_rls.sql are a silent no-op under a superuser
# connection, since Postgres superusers always bypass row-level security.
DATABASE_URL=postgres://usim_cms_app:usim_cms_app@localhost:5432/usim_cms
PORT=3000

# Random secret for signing login session tokens — REQUIRED when
# NODE_ENV=production (boot fails without it); falls back to an insecure
# dev default otherwise.
SESSION_SECRET=

# Comma-separated admin origins allowed by CORS, e.g.
# https://admin.usim.edu.my — REQUIRED when NODE_ENV=production (boot fails
# without it); unset in dev falls back to allowing any origin.
ADMIN_ORIGIN=

NODE_ENV=

# Media/upload storage: "local" (default, writes to apps/api/uploads/) or
# "s3" (any S3-compatible endpoint — AWS S3, MinIO, Sangfor object storage).
STORAGE_DRIVER=local
# S3_ENDPOINT=https://your-sangfor-endpoint
# S3_REGION=us-east-1
# S3_BUCKET=usim-cms-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL_BASE=https://your-sangfor-endpoint/usim-cms-media
