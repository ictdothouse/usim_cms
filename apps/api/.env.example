DATABASE_URL=postgres://postgres:postgres@localhost:5432/usim_cms
PORT=3000

# Random secret for signing login session tokens — set a real random value
# in any real deployment (falls back to an insecure dev default otherwise).
SESSION_SECRET=

# Media/upload storage: "local" (default, writes to apps/api/uploads/) or
# "s3" (any S3-compatible endpoint — AWS S3, MinIO, Sangfor object storage).
STORAGE_DRIVER=local
# S3_ENDPOINT=https://your-sangfor-endpoint
# S3_REGION=us-east-1
# S3_BUCKET=usim-cms-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL_BASE=https://your-sangfor-endpoint/usim-cms-media
