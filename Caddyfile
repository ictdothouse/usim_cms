# Reverse proxy for the whole stack. Default behaviour: Caddy auto-issues
# and auto-renews a Let's Encrypt certificate for every domain listed below
# the first time it's requested — no manual cert steps needed for USIM's own
# subdomains.
#
# Only for local trial without a real domain (ADMIN_DOMAIN=localhost etc.):
# Caddy falls back to an internal self-signed cert, browser will warn once.

# Admin API bound to all interfaces INSIDE this container so the api
# service (same docker-internal network, see docker-compose.yml's
# CADDY_ADMIN_URL) can reach it — this port is never published to the host
# (no "2019:2019" in docker-compose.yml's proxy.ports), so it stays
# unreachable from outside the Docker network regardless of any firewall
# rule on the host.
{
	admin 0.0.0.0:2019
	# Uncomment when PROXY_BIND_HTTP/HTTPS (docker-compose.yml) point Caddy
	# at loopback-only ports because an existing nginx (shared with other
	# apps on this box) already owns the real 80/443 and terminates TLS
	# itself — Caddy then only ever speaks plain HTTP to that nginx, so
	# auto-cert/ACME would just fail (port 80 isn't really Caddy's to prove
	# domain ownership on). Leave commented out (default) when Caddy owns
	# 80/443 directly and should keep auto-issuing its own Let's Encrypt certs.
	# auto_https off
}

{$ADMIN_DOMAIN:admin.localhost} {
	reverse_proxy ucms-blue-admin-1:80
}

{$API_DOMAIN:api.localhost} {
	reverse_proxy ucms-blue-api-1:3000
}

# Tenant sites (the actual department/faculty websites). Add every live
# tenant host to TENANT_DOMAINS in .env, space-separated — Caddy treats each
# token on this line as its own site, all sharing this block. Host header is
# preserved by reverse_proxy, which is how apps/frontend resolves the tenant
# (see CLAUDE.md's Multi-tenancy section) — do not rewrite it here.
{$TENANT_DOMAINS:tenant.localhost} {
	reverse_proxy ucms-blue-frontend-1:4321
}

# The three routes above are only ever read ONCE — the very first time this
# `proxy` container starts, before scripts/deploy.sh has ever run. They point
# at what deploy.sh's first-ever run always produces: a `ucms-blue` project
# with 1 replica of each service (docker-compose.release.yml). From that
# first successful deploy onward, apps/api/src/proxy-sync.ts's syncCaddy
# pushes a full replacement config straight to Caddy's Admin API on every
# deploy (see index.ts's POST /internal/deploy/promote) — which is what
# actually flips these routes to whichever color/replica-set is live, and
# also adds/removes each tenant's own route. Editing ADMIN_DOMAIN/API_DOMAIN/
# TENANT_DOMAINS here after that first deploy has no effect until the proxy
# container is fully recreated (not just restarted — its live config comes
# from Caddy's own autosave under the caddy-config volume by then, not this
# file) — manage tenants/domains through the admin's Settings tab instead.

# --- Bringing your own SSL certificate instead of Caddy's automatic one -----
# If USIM's ICT centre issues its own certificate for a department domain
# (the cPanel-style flow), replace the matching block above with one like
# this, and mount the cert files into the proxy service (see the commented
# volume line in docker-compose.yml):
#
# cs.usim.edu.my {
# 	tls /etc/caddy/certs/cs.usim.edu.my.crt /etc/caddy/certs/cs.usim.edu.my.key
# 	reverse_proxy frontend:4321
# }
