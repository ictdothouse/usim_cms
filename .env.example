# docker-compose.yml config. Copy to .env, fill in the two secrets, then:
#   docker compose up -d --build
# usim_cms_app's own DB role/password is created automatically on first boot
# by apps/api/scripts/setup-db-role.sql (mounted into postgres's initdb.d) —
# no manual db:setup-role step needed here, unlike a bare-metal install.

# Postgres superuser password (only used for the one-time role bootstrap and
# direct psql access — the api never connects as this user). Pick a real value.
POSTGRES_SUPERUSER_PASSWORD=

# Random secret for signing admin login session tokens. Pick a real value —
# see apps/api/.env.example.
SESSION_SECRET=

# Browser-facing URLs (baked into the admin's static build at image-build
# time — Vite env vars are compile-time, not runtime). Point these at the
# real public origins once you have a domain; localhost values are for
# trying the stack out on one machine.
VITE_API_URL=http://localhost:3000
VITE_FRONTEND_URL=http://localhost:4321

# Domains the `proxy` (Caddy) service answers on. Caddy auto-issues/renews a
# Let's Encrypt cert for each real domain on first request — no extra steps.
# TENANT_DOMAINS is space-separated: list every live department site here
# (must match the `host` each tenant was created with). See Caddyfile for how
# to swap in a USIM-issued certificate instead of the automatic one.
ADMIN_DOMAIN=admin.localhost
API_DOMAIN=api.localhost
TENANT_DOMAINS=tenant.localhost

# Blue-green zero-downtime deploys (scripts/deploy.sh, docker-compose.
# release.yml) — see CLAUDE.md's Deployment section. Pick a real random
# value, same idea as SESSION_SECRET; it's presented as a shared secret to
# the api's own POST /internal/deploy/promote, never a session token.
DEPLOY_SECRET=

# How many replicas of each app-tier service scripts/deploy.sh brings up
# per deploy. 1 is fine until real traffic warrants more; Caddy fans out to
# every replica automatically once promoted (apps/api/src/proxy-sync.ts).
API_REPLICAS=1
FRONTEND_REPLICAS=1
ADMIN_REPLICAS=1

# monitor/server.js (ops dashboard, port 5555) refuses to start without this —
# basic-auth password for the dashboard itself, not related to any DB/session
# secret above. Pick a real value.
MONITOR_PASSWORD=
