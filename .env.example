# docker-compose.yml config. Copy to .env, fill in the two secrets, then:
#   docker compose up -d --build
# usim_cms_app's own DB role/password is created automatically on first boot
# by apps/api/scripts/setup-db-role.sql (mounted into postgres's initdb.d) —
# no manual db:setup-role step needed here, unlike a bare-metal install.

# Postgres superuser password (only used for the one-time role bootstrap and
# direct psql access — the api never connects as this user). Pick a real value.
POSTGRES_SUPERUSER_PASSWORD=

# Random secret for signing admin login session tokens. Pick a real value —
# see apps/api/.env.example.
SESSION_SECRET=

# Browser-facing URLs (baked into the admin's static build at image-build
# time — Vite env vars are compile-time, not runtime). Point these at the
# real public origins once you have a domain; localhost values are for
# trying the stack out on one machine.
VITE_API_URL=http://localhost:3000
VITE_FRONTEND_URL=http://localhost:4321
