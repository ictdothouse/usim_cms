{
  "name": "usim-cms",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev:api": "pnpm --filter @usim-cms/api dev",
    "dev:admin": "pnpm --filter @usim-cms/admin dev",
    "dev:frontend": "pnpm --filter @usim-cms/frontend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.15.0"
  }
}
