{
  "name": "ucms",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev:api": "pnpm --filter @ucms/api dev",
    "dev:admin": "pnpm --filter @ucms/admin dev",
    "dev:frontend": "pnpm --filter @ucms/frontend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.1"
  }
}
