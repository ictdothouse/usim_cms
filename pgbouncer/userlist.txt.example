# Real file (pgbouncer/userlist.txt, git-ignored) is generated by
# scripts/configure-docker-db-roles.sh after role setup.
# The second field is the exact SCRAM verifier read from pg_authid after role
# setup. Do not put the plaintext password or a locally generated verifier
# here: PgBouncer needs the same salt/verifier PostgreSQL has stored.
"usim_cms_app" "SCRAM-SHA-256$4096:<salt>$<stored-key>:<server-key>"
