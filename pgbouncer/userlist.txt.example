# Real file (pgbouncer/userlist.txt, git-ignored) is generated by
# install.sh's write_pgbouncer_userlist() from .env's POSTGRES_APP_PASSWORD —
# same convention as .env/.env.example. Format: "<role>" "md5<hex>" where
# <hex> = md5(password + role) — see setup-db-role-rotate.sh for why this
# must be md5, not scram-sha-256.
"usim_cms_app" "md5<generated-by-install.sh>"
